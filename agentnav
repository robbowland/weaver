#!/usr/bin/env bash
# agentnav: keep track of Claude Code agents running in zellij panes, and open
# neovim in the worktree each agent is really editing.
#
#   agentnav hook                     Claude Code hook for every event (JSON on stdin)
#   agentnav edit [--full] [pane-id]  open, or jump to, the nvim bound to the focused agent
#   agentnav nvim <agent-pane> [file] internal: start the nvim bound to one agent
#   agentnav ls                       dashboard of every agent in this zellij session
#   agentnav next                     jump to the agent that has needed you longest
#
# Must stay bash 3.2 compatible (macOS /bin/bash): no mapfile, no ${x,,}, no
# GNU-only flags.

set -u

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/agentnav"
# /tmp rather than $TMPDIR: macOS caps unix socket paths at ~104 bytes.
SOCK_DIR="/tmp/agentnav-${UID:-$(id -u)}"
SESSION="${ZELLIJ_SESSION_NAME:-}"
SKEY="${SESSION//\//_}"
US=$'\037' # field separator for jq output; never appears in paths or prompts
TAB=$'\t'
NL=$'\n'

case $0 in /*) SELF=$0 ;; *) SELF="$PWD/$0" ;; esac

die() {
	printf 'agentnav: %s\n' "$*" >&2
	exit 1
}

need_session() {
	[ -n "$SESSION" ] || die "not inside a zellij session (ZELLIJ_SESSION_NAME is unset)"
}

state_file() { SF="$STATE_DIR/${SKEY}_$1.json"; }
sock_path() { SOCK="$SOCK_DIR/${SKEY}_$1.sock"; }
# The agent's nvim pane id lives in its own file, written only by `agentnav
# nvim`, so racing hooks can never lose it.
nvim_file() { NVF="$STATE_DIR/${SKEY}_$1.nvim"; }
read_nvim_pane() {
	NV=""
	nvim_file "$1"
	[ -f "$NVF" ] && read -r NV <"$NVF"
	case $NV in *[!0-9]*) NV="" ;; esac
}

# This session's per-pane files with extension $1, into the array FOUND. Only
# <session>_<digits>.$1 counts, so session "a" never claims session "a_b"'s files.
session_files() {
	local f p
	FOUND=()
	for f in "$STATE_DIR/${SKEY}"_*."$1"; do
		p=${f#"$STATE_DIR/${SKEY}_"}
		p=${p%."$1"}
		case $p in '' | *[!0-9]*) continue ;; esac
		FOUND[${#FOUND[@]}]=$f
	done
}

# Directory holding the real script, following symlinks without GNU readlink -f.
script_dir() {
	local p=$SELF d
	while [ -L "$p" ]; do
		d=$(cd -P "${p%/*}" && pwd)
		p=$(readlink "$p")
		case $p in /*) ;; *) p="$d/$p" ;; esac
	done
	cd -P "${p%/*}" && pwd
}

# Serialise read-modify-write of state file $SF. The lock is $SF.lock, created
# exclusively (noclobber); the new state is written into it and renamed over
# $SF, which also releases the lock. A held lock is never truncated: one older
# than the moment we started waiting, still there about a second later, was
# left by a killed process and is removed. After ~2s we go ahead with a
# private file rather than block the agent (risking a lost update, not a
# corrupt file).
lock() {
	local i=0 mark=""
	LOCK="$SF.lock"
	set -C
	until { : >"$LOCK"; } 2>/dev/null; do
		i=$((i + 1))
		if [ $i = 1 ]; then
			mark="$SF.wait.$$"
			: >|"$mark"
		elif [ $((i % 50)) = 0 ] && [ "$LOCK" -ot "$mark" ]; then
			rm -f "$LOCK"
			continue
		fi
		if [ $i -ge 100 ]; then
			LOCK="$SF.$$.tmp"
			break
		fi
		sleep 0.02
	done
	set +C
	[ -z "$mark" ] || rm -f "$mark"
}
commit_lock() { mv -f "$LOCK" "$SF"; }
drop_lock() { rm -f "$LOCK"; }

# JSON string literal for $1, into J. Inputs never contain control characters.
json_str() {
	local s=${1//\\/\\\\}
	s=${s//\"/\\\"}
	J="\"$s\""
}

# bounded OUT CMD... runs CMD with stdout to OUT and stdin/stderr on /dev/null,
# killed after 2s so a busy nvim or zellij can never block the caller. Returns
# CMD's status, or 142 if it was killed. (A killed nvim client exits 1, so its
# own status can't tell us; the killer reports firing with status 3.)
bounded() {
	local out=$1 pid killer rc
	shift
	"$@" </dev/null >"$out" 2>/dev/null &
	pid=$!
	(
		trap 'kill $s 2>/dev/null; exit 0' TERM
		sleep 2 &
		s=$!
		wait $s
		trap '' TERM
		kill "$pid"
		exit 3
	) </dev/null >/dev/null 2>&1 &
	killer=$!
	wait "$pid" 2>/dev/null
	rc=$?
	kill "$killer" 2>/dev/null
	wait "$killer" 2>/dev/null
	[ $? = 3 ] && return 142
	return $rc
}

# The arguments of v:lua.F(...) are Vimscript expressions: in a single-quoted
# Vim string a quote is doubled and a backslash is literal.
follow_expr() {
	local r=${1//\'/\'\'} f=${2//\'/\'\'}
	EXPR="v:lua.AgentFollow('$r','$f')"
}

# nvim_follow AGENT-PANE ROOT FILE tells the agent's nvim to follow it.
# Returns 0 on success, 128+ when nvim did not answer in time (stuck at a
# prompt, or busy), and anything else when nothing is listening.
#
# With NOW set (the hook), a timeout is remembered: calls are skipped for 15s
# so a stuck nvim costs the agent one 2s wait per 15s, not 2s on every event.
nvim_follow() {
	local stalled t=0 rc
	sock_path "$1"
	[ -S "$SOCK" ] || return 1
	stalled="$SOCK.stalled"
	if [ -n "${NOW:-}" ] && [ -f "$stalled" ]; then
		read -r t <"$stalled"
		case $t in '' | *[!0-9]*) t=0 ;; esac
		[ $((NOW - t)) -lt 15 ] && return 128
	fi
	follow_expr "$2" "$3"
	bounded /dev/null nvim --server "$SOCK" --remote-expr "$EXPR"
	rc=$?
	if [ $rc -ge 128 ]; then
		[ -n "${NOW:-}" ] && printf '%s\n' "$NOW" >"$stalled"
	elif [ -f "$stalled" ]; then
		rm -f "$stalled"
	fi
	return $rc
}

# Tell the agent's nvim to re-check files (after a Bash command, say).
nvim_checktime() {
	sock_path "$1"
	[ -S "$SOCK" ] || return 1
	bounded /dev/null nvim --server "$SOCK" --remote-expr "v:lua.AgentChecktime()"
}

toplevel() { git -C "$1" rev-parse --show-toplevel 2>/dev/null; }

# All panes as a JSON array, into PANES. Retried: list-panes has once been
# seen returning output that was not JSON.
list_panes() {
	local i
	for i in 1 2 3; do
		PANES=$(zellij action list-panes -a -j 2>/dev/null) &&
			printf '%s' "$PANES" | jq -e 'type == "array"' >/dev/null 2>&1 && return 0
		sleep 0.1
	done
	die "zellij action list-panes failed"
}

# ---------------------------------------------------------------- hook

# The hook event (stdin) plus the stored state ($st), as one US-separated line.
# key identifies a tool call (name + input), so the PostToolUse of an approved
# tool can be matched to the PermissionRequest that asked for it.
JQ_HOOK='
def line: tostring | gsub("[\u0000-\u001f]+"; " ");
def one($n): line | gsub("\\s+"; " ") | sub("^ "; "") | .[0:$n];
def summary:
  ((.tool_input | objects) // {}) as $i
  | (($i.file_path // $i.notebook_path) // null) as $fp
  | if .tool_name == "Bash" then "Bash: " + ($i.command // "" | tostring)
    elif .tool_name == "AskUserQuestion" then "question: " + ((($i.questions // []) | arrays | .[0].question?) // "" | tostring)
    elif $fp then (.tool_name // "") + ": " + ($fp | tostring | split("/") | last)
    else (.tool_name // "") end;
((try ($st | fromjson) catch {}) | if type == "object" then . else {} end) as $s
| [ .hook_event_name // "",
    .cwd // "",
    .session_id // "",
    ((.tool_input | objects | .file_path // .notebook_path) // ""),
    (.prompt // "" | one(120)),
    .tool_name // "",
    .notification_type // "",
    (now | floor),
    (if .hook_event_name == "PermissionRequest" or .hook_event_name == "PreToolUse" then summary
     elif .hook_event_name == "Notification" then (.message // "")
     elif .hook_event_name == "StopFailure" then "error: " + (.error // "" | tostring)
     else "" end | one(100)),
    (if .tool_name then .tool_name + ":" + (.tool_input | tojson | .[0:300]) else "" end),
    (.last_assistant_message // "" | one(400)),
    $s.cwd // "", $s.root // "", $s.file // "", $s.prompt // "",
    $s.state // "", $s.session_id // "", $s.start_cwd // "", $s.since // "",
    $s.waiting // "", $s.pending // "", $s.last_message // "", ($s.seen // false),
    $s.marked_root // "", $s.marker // "", $s.project_root // ""
  ] | map(line) | join("\u001f")'

# Ring the bell (terminalSequence is written by Claude Code to the agent's
# terminal): zellij marks the tab until the pane is focused.
BELL_JSON='{"terminalSequence":"\u0007"}'

cmd_hook() {
	local rc mode=sync
	[ "${1:-}" = --async ] && mode=async
	[ -n "${ZELLIJ_PANE_ID:-}" ] || exit 0
	[ -t 0 ] && exit 0
	if [ -n "${AGENTNAV_DEBUG:-}" ]; then
		mkdir -p "$STATE_DIR" && (hook_run "$mode") >/dev/null 2>>"$STATE_DIR/hook.log"
	else
		(hook_run "$mode") >/dev/null 2>&1
	fi
	rc=$?
	[ $rc = 10 ] && [ "${AGENTNAV_BELL:-1}" != 0 ] && printf '%s\n' "$BELL_JSON"
	exit 0
}

# Set or clear a Worktrunk branch marker in DIR, in the background.
wt_marker() {
	command -v wt >/dev/null 2>&1 || return 0
	if [ -n "$2" ]; then
		(wt -C "$1" config state marker set "$2") </dev/null >/dev/null 2>&1 &
	else
		(wt -C "$1" config state marker clear) </dev/null >/dev/null 2>&1 &
	fi
}

# Kept to one jq and one mv (plus git, nvim and zellij only when needed): the
# hook runs on every agent event and must stay fast. Mode "async" is the
# all-tools PostToolUse hook that runs in the background: it only clears a
# needs-you whose approved tool has finished, and reloads nvim after Bash.
# Exits 10 when the agent has just started needing you (ring the bell).
hook_run() {
	local mode=$1 pane=$ZELLIJ_PANE_ID parsed J out moved=0 rc=0
	local event cwd sid file prompt tool ntype now waiting_new key last_new
	local o_cwd o_root o_file o_prompt o_state o_sid o_start o_since o_waiting o_pending o_last o_seen o_marked o_marker o_proj
	local root="" d state ev_file="" start since waiting pending last seen marked marker proj mark_dir
	[ -d "$STATE_DIR" ] || mkdir -p "$STATE_DIR" || return
	state_file "$pane"
	lock
	if [ -f "$SF" ]; then set -- --rawfile st "$SF"; else set -- --arg st ""; fi
	parsed=$(jq -r "$@" "$JQ_HOOK") || {
		drop_lock
		return
	}
	IFS=$US read -r event cwd sid file prompt tool ntype now waiting_new key last_new \
		o_cwd o_root o_file o_prompt o_state o_sid o_start o_since o_waiting o_pending o_last o_seen \
		o_marked o_marker o_proj <<<"$parsed"
	if [ -z "$event" ]; then
		# Empty or eventless input: keep the stored state rather than blank it.
		drop_lock
		return
	fi
	NOW=$now

	if [ "$mode" = async ]; then
		read_nvim_pane "$pane"
		if [ "$o_state" = needs-you ] && [ -n "$o_pending" ] && [ "$key" = "$o_pending" ]; then
			# The tool you approved (or the question you answered) has finished.
			async_write
		else
			drop_lock
		fi
		[ "$tool" = Bash ] && [ -n "$NV" ] && nvim_checktime "$pane"
		return 0
	fi

	# A new Claude session in this pane (not a resume or compaction) starts
	# afresh; otherwise the root is never reset to the start directory.
	if [ -n "$sid" ] && [ "$sid" != "$o_sid" ]; then
		o_cwd="" o_root="" o_file="" o_prompt="" o_state="" o_start="" o_since=""
		o_waiting="" o_pending="" o_last="" o_seen=false o_proj=""
	fi
	start=${o_start:-$cwd}

	# Where the agent is really working: the repo of the file it just edited
	# (the nearest existing parent, since new files may be in new directories)...
	if [ "$event" = PostToolUse ] && [ -n "$file" ]; then
		case $file in /*) ;; *) file="$cwd/$file" ;; esac
		ev_file=$file
		d=${file%/*}
		while [ -n "$d" ] && [ ! -d "$d" ]; do d=${d%/*}; done
		root=$(toplevel "${d:-/}") || root=""
	fi
	# ...else the repo of a new cwd. Claude Code snaps cwd back to the start
	# directory after any command that cd's outside it, so a change back to the
	# start directory only counts when a worktree tool made it...
	if [ -z "$root" ]; then
		if [ "$cwd" != "$o_cwd" ]; then
			case $tool in
			EnterWorktree | ExitWorktree) moved=1 start=$cwd ;;
			*) [ "$cwd" != "$start" ] && moved=1 ;;
			esac
		fi
		if [ $moved = 1 ] || [ -z "$o_root" ]; then
			root=$(toplevel "$cwd") || root=$cwd
		else
			# ...else wherever it was before.
			root=$o_root
		fi
	fi

	waiting=$o_waiting pending=$o_pending
	case $event in
	PermissionRequest | PreToolUse)
		# A permission dialog, or (PreToolUse on AskUserQuestion) a question.
		state=needs-you waiting=$waiting_new pending=$key
		;;
	Notification)
		# Only dialogs need you. The idle reminder Claude Code sends 60s after
		# a turn ends means it is done; other notices leave the state alone.
		# No type at all: assume it needs you.
		case $ntype in
		permission_prompt | elicitation_* | agent_needs_input | "")
			state=needs-you
			[ "$o_state" = needs-you ] && [ -n "$o_waiting" ] || waiting=$waiting_new
			;;
		idle_prompt | agent_completed)
			state=done
			[ "$o_state" = needs-you ] && state=needs-you
			;;
		*) state=${o_state:-working} ;;
		esac
		;;
	PostToolUse | PostToolUseFailure)
		state=working
		if [ "$o_state" = needs-you ] && [ -n "$o_pending" ] && [ "$key" != "$o_pending" ]; then
			# Another tool finished while one still waits for you.
			state=needs-you
		fi
		;;
	StopFailure) state=needs-you waiting=$waiting_new pending="" ;;
	Stop) state=done ;;
	SessionStart) state=idle ;;
	SessionEnd) state=ended ;;
	*) state=working ;;
	esac
	[ "$state" = needs-you ] || waiting="" pending=""
	[ "$o_state" != needs-you ] && [ "$state" = needs-you ] && rc=10
	since=$o_since
	if [ "$state" != "$o_state" ] || [ -z "$since" ]; then
		since=$now seen=false
	else
		seen=$o_seen
	fi
	last=${last_new:-$o_last}
	[ -n "$prompt" ] || prompt=$o_prompt
	[ -n "$ev_file" ] && file=$ev_file || file=$o_file

	# Worktrunk branch markers, like its own Claude Code plugin sets for the
	# session's start directory, but on the worktree the agent is really in.
	proj=$o_proj
	if [ -z "$proj" ] && [ -n "${CLAUDE_PROJECT_DIR:-$start}" ]; then
		proj=$(toplevel "${CLAUDE_PROJECT_DIR:-$start}") || proj=-
	fi
	case $state in working) marker='🤖' ;; ended) marker='' ;; *) marker='💬' ;; esac
	mark_dir=""
	if [ "${AGENTNAV_WT_MARKERS:-1}" != 0 ] && [ -n "$marker" ] && [ "$root" != "$proj" ] && [ -e "$root/.git" ]; then
		mark_dir=$root
	fi
	if [ "$mark_dir" != "$o_marked" ] || { [ -n "$mark_dir" ] && [ "$marker" != "$o_marker" ]; }; then
		[ -n "$o_marked" ] && [ "$o_marked" != "$mark_dir" ] && wt_marker "$o_marked" ""
		[ -n "$mark_dir" ] && wt_marker "$mark_dir" "$marker"
	fi
	marked=$mark_dir

	write_state

	[ -n "$NV" ] || return $rc
	if [ -n "$ev_file" ]; then
		nvim_follow "$pane" "$root" "$ev_file"
	elif [ "$root" != "$o_root" ]; then
		nvim_follow "$pane" "$root" ""
	fi
	if [ "$root" != "$o_root" ]; then
		bounded /dev/null zellij action rename-pane --pane-id "terminal_$NV" "nvim: ${root##*/}"
	fi
	return $rc
}

# The async hook's one change: needs-you back to working. Everything else is
# carried over from the stored state.
async_write() {
	state=working since=$now seen=false waiting="" pending=""
	cwd=$o_cwd root=$o_root start=$o_start sid=$o_sid file=$o_file prompt=$o_prompt
	last=$o_last marked=$o_marked marker=$o_marker proj=$o_proj
	write_state
}

# Write the state file from the hook's variables (and release the lock).
write_state() {
	case $pane in '' | *[!0-9]*) json_str "$pane" ;; *) J=$pane ;; esac
	out="{\"pane\":$J"
	json_str "$cwd" && out="$out,\"cwd\":$J"
	json_str "$root" && out="$out,\"root\":$J"
	json_str "$start" && out="$out,\"start_cwd\":$J"
	json_str "$proj" && out="$out,\"project_root\":$J"
	out="$out,\"state\":\"$state\",\"ts\":${now:-0},\"since\":${since:-0}"
	json_str "$sid" && out="$out,\"session_id\":$J"
	json_str "$file" && out="$out,\"file\":$J"
	json_str "$prompt" && out="$out,\"prompt\":$J"
	json_str "$waiting" && out="$out,\"waiting\":$J"
	json_str "$pending" && out="$out,\"pending\":$J"
	json_str "$last" && out="$out,\"last_message\":$J"
	[ "$seen" = true ] && out="$out,\"seen\":true" || out="$out,\"seen\":false"
	json_str "$marked" && out="$out,\"marked_root\":$J"
	json_str "$marker" && out="$out,\"marker\":$J"
	read_nvim_pane "$pane"
	out="$out,\"nvim_pane\":${NV:-null}}"
	if printf '%s\n' "$out" >"$LOCK"; then commit_lock; else drop_lock; fi
}

# Mark an agent seen (you jumped to it), so a "done" no longer stands out.
mark_seen() {
	state_file "$1"
	[ -f "$SF" ] || return 0
	lock
	if jq '.seen = true' "$SF" >"$LOCK"; then commit_lock; else drop_lock; fi
}

# ---------------------------------------------------------------- nvim

cmd_nvim() {
	[ $# -ge 1 ] || die "usage: agentnav nvim <agent-pane-id> [file]"
	local agent=${1#terminal_} file=${2:-} lua
	need_session
	mkdir -p "$SOCK_DIR" || die "cannot create $SOCK_DIR"
	[ -O "$SOCK_DIR" ] || die "$SOCK_DIR is not owned by you"
	chmod 700 "$SOCK_DIR"
	sock_path "$agent"
	rm -f "$SOCK"

	state_file "$agent"
	nvim_file "$agent"
	if [ -n "${ZELLIJ_PANE_ID:-}" ]; then
		mkdir -p "$STATE_DIR"
		printf '%s\n' "$ZELLIJ_PANE_ID" >"$NVF.$$" && mv -f "$NVF.$$" "$NVF"
		if [ -f "$SF" ]; then
			lock
			if jq --arg nv "$ZELLIJ_PANE_ID" '.nvim_pane = ($nv | tonumber? // $nv)' "$SF" >"$LOCK"; then
				commit_lock
			else
				drop_lock
			fi
		fi
	fi

	lua="$(script_dir)/nvim/agentnav.lua"
	# The ATTENTION dialog for a stale swap file would block this nvim and every
	# remote call: open the startup file read-only instead (agentnav.lua reports
	# it and removes this autocmd).
	exec nvim --listen "$SOCK" \
		--cmd "augroup agentnav_start | autocmd SwapExists * let v:swapchoice = 'o' | let g:agentnav_swap = expand('<afile>') | augroup END" \
		-c "luafile ${lua// /\\ }" -- ${file:+"$file"}
}

# ---------------------------------------------------------------- edit

# Open a new pane running CMD... beside pane TARGET, then move it to the left.
open_left_of() {
	local target=$1 cwd=$2 name=$3 id
	shift 3
	zellij action focus-pane-id "terminal_$target" >/dev/null 2>&1 || true
	id=$(zellij action new-pane --direction right --close-on-exit --cwd "$cwd" --name "$name" -- "$@") ||
		die "zellij action new-pane failed"
	zellij action move-pane ${id:+--pane-id "$id"} left || true
}

cmd_edit() {
	local full=0 target="" panes agent="" info root file nv cwd rc f p d
	while [ $# -gt 0 ]; do
		case $1 in
		--full) full=1 ;;
		-*) die "usage: agentnav edit [--full] [pane-id]" ;;
		*) target=${1#terminal_} ;;
		esac
		shift
	done
	need_session
	list_panes
	panes=$PANES

	# The tiled pane we were on keeps is_focused while this floating pane is
	# open, but is_focused is per tab, so look only in our own tab.
	if [ -z "$target" ]; then
		target=$(printf '%s' "$panes" | jq -r --arg me "${ZELLIJ_PANE_ID:-}" '
			map(select(.is_plugin | not)) as $t
			| ($t | map(select((.id | tostring) == $me)) | .[0].tab_id) as $tab
			| $t | map(select(.tab_id == $tab and .is_focused and (.is_floating | not)
				and (.id | tostring) != $me)) | .[0].id // empty')
		[ -n "$target" ] || die "cannot find the focused pane"
	fi

	state_file "$target"
	if [ -f "$SF" ]; then
		agent=$target
	else
		# Pressed on an agent's nvim: act for that agent.
		session_files nvim
		for f in ${FOUND[@]+"${FOUND[@]}"}; do
			read -r p <"$f" || continue
			if [ "$p" = "$target" ]; then
				agent=${f#"$STATE_DIR/${SKEY}_"}
				agent=${agent%.nvim}
				break
			fi
		done
	fi

	if [ -z "$agent" ]; then
		cwd=$(printf '%s' "$panes" | jq -r --arg p "$target" \
			'map(select((.is_plugin | not) and (.id | tostring) == $p)) | .[0].pane_cwd // empty')
		[ -d "$cwd" ] || cwd=$PWD
		open_left_of "$target" "$cwd" "nvim: ${cwd##*/}" nvim
	else
		mark_seen "$agent"
		state_file "$agent"
		info=$(jq -r '[.root // .cwd // "", .file // ""] | map(tostring) | join("\u001f")' "$SF") ||
			die "cannot read $SF"
		IFS=$US read -r root file <<<"$info"
		read_nvim_pane "$agent"
		nv=$NV
		[ -d "$root" ] || root=$PWD
		# git gives the root as a real path; the agent may have used a symlinked
		# one (/tmp vs /private/tmp on macOS), so compare real paths.
		if [ -n "$file" ] && [ -e "$file" ] && d=$(cd -P "${file%/*}" 2>/dev/null && pwd); then
			file="$d/${file##*/}"
		fi
		case $file in "$root"/*) [ -e "$file" ] || file="" ;; *) file="" ;; esac

		# Reuse the agent's nvim if its pane is alive and nvim answers. One that
		# timed out is alive but stuck (e.g. at a hit-enter prompt): jump to it
		# rather than open a second nvim for the same agent.
		rc=1
		if [ -n "$nv" ] &&
			printf '%s' "$panes" | jq -e --arg p "$nv" \
				'any(.[]; (.is_plugin | not) and (.id | tostring) == $p and (.exited | not))' >/dev/null; then
			nvim_follow "$agent" "$root" "$file"
			rc=$?
		fi
		if [ $rc = 0 ] || [ $rc -ge 128 ]; then
			zellij action focus-pane-id "terminal_$nv" >/dev/null 2>&1 || true
		else
			open_left_of "$agent" "$root" "nvim: ${root##*/}" "$SELF" nvim "$agent" ${file:+"$file"}
		fi
	fi
	[ $full = 1 ] && zellij action toggle-fullscreen
	return 0
}

# ---------------------------------------------------------------- ls

# Live agents in this session, one US-separated line each: pane, tab, state,
# root, ts, since, seen, prompt, waiting. Also prints "gc<US>file" for state
# files whose pane no longer exists.
JQ_ROWS='
($panes | map(select(.is_plugin | not))) as $all
| ($all | map({key: (.id | tostring), value: .}) | from_entries) as $byid
| inputs as $s
| ($byid[$s.pane | tostring]) as $p
| if $p == null then ["gc", input_filename]
  elif ($p.exited or $s.state == "ended") then empty
  else [$s.pane, $p.tab_id, $s.state, ($s.root // $s.cwd // ""), ($s.ts // 0),
        ($s.since // $s.ts // 0), ($s.seen // false), ($s.prompt // ""), ($s.waiting // "")]
  end
| map(tostring | gsub("[\u0000-\u001f]+"; " ")) | join("\u001f")'

# The agents as JQ_ROWS lines, into AGENT_ROWS (gc lines included).
agent_rows() {
	AGENT_ROWS=""
	session_files json
	[ ${#FOUND[@]} -gt 0 ] || return 0
	list_panes
	AGENT_ROWS=$(jq -rn --argjson panes "$PANES" "$JQ_ROWS" "${FOUND[@]}") || AGENT_ROWS=""
}

# repo/branch and "N files (M new)" for ROOT, into REPO_BRANCH and FILES.
git_info() {
	local root=$1 common branch="" n=0 m=0 line repo
	REPO_BRANCH=${root##*/} FILES="-"
	common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
	# Group worktrees under their repo: the parent of the shared .git dir
	# (or the name of a bare repo.git).
	case ${common##*/} in
	.git | .bare) repo=${common%/*} repo=${repo##*/} ;;
	*.git) repo=${common##*/} repo=${repo%.git} ;;
	*) repo=${common%/*} repo=${repo##*/} ;;
	esac
	while IFS= read -r line; do
		case $line in
		"# branch.head "*) branch=${line#\# branch.head } ;;
		"? "*) n=$((n + 1)) m=$((m + 1)) ;;
		"1 A"* | "2 A"*) n=$((n + 1)) m=$((m + 1)) ;;
		[12u]" "*) n=$((n + 1)) ;;
		esac
	done <<EOF
$(git -C "$root" status --porcelain=v2 --branch 2>/dev/null)
EOF
	REPO_BRANCH="$repo/${branch:-?}"
	if [ $n = 1 ]; then FILES="1 file"; else FILES="$n files"; fi
	[ $m -gt 0 ] && FILES="$FILES ($m new)"
	return 0
}

# 75s -> 1m, 2h ...
age() {
	if [ "$1" -lt 60 ]; then
		AGE="${1}s"
	elif [ "$1" -lt 3600 ]; then
		AGE="$(($1 / 60))m"
	else
		AGE="$(($1 / 3600))h"
	fi
}

# Claude Code shows "esc to interrupt" while it works. A "working" agent that
# has been quiet for 30s without it was most likely interrupted with Esc, which
# fires no Stop hook.
interrupted() {
	zellij action dump-screen --pane-id "terminal_$1" 2>/dev/null | grep -q 'esc to interrupt' && return 1
	return 0
}

# Rows for the dashboard: pane<TAB>tab<TAB>display, best first, after a header
# row; ANSI colours when COLOR=1. Prints nothing when there are no agents.
# Order: needs you (longest waiting first), done and not yet seen, done,
# working, interrupted, idle.
ls_rows() {
	local now pane tab state root ts since seen prompt waiting icon text rank sortkey w=11 i n=0
	local red="" green="" dim="" off=""
	local -a k_rank k_key k_pane k_tab k_icon k_rb k_age k_files k_text
	[ "${COLOR:-}" = 1 ] && red=$'\033[31m' green=$'\033[32m' dim=$'\033[2m' off=$'\033[0m'
	agent_rows
	[ -n "$AGENT_ROWS" ] || return 0
	now=$(date +%s)
	while IFS=$US read -r pane tab state root ts since seen prompt waiting; do
		[ -n "$pane" ] || continue
		if [ "$pane" = gc ]; then
			rm -f "$tab" "${tab%.json}.nvim"
			continue
		fi
		[ "$state" = working ] && [ $((now - ts)) -gt 30 ] && interrupted "$pane" && state=interrupted
		text=$prompt
		case $state in
		needs-you) rank=0 icon="${red}!${off}" text="${red}${waiting:-$prompt}${off}" ;;
		done)
			if [ "$seen" = true ]; then
				rank=2 icon="${dim}✓${off}"
			else
				rank=1 icon="${green}✓${off}"
			fi
			;;
		working) rank=3 icon='●' ;;
		interrupted) rank=4 icon='○' text="interrupted? $prompt" ;;
		*) rank=5 icon="${dim}○${off}" ;;
		esac
		git_info "$root"
		age $((now - since))
		sortkey=$REPO_BRANCH
		[ $rank = 0 ] && sortkey=$(printf '%012d' "$since")
		k_rank[n]=$rank k_key[n]=$sortkey k_pane[n]=$pane k_tab[n]=$tab k_icon[n]=$icon
		k_rb[n]=$REPO_BRANCH k_files[n]=$FILES k_text[n]=$text k_age[n]=$AGE
		[ ${#REPO_BRANCH} -gt $w ] && w=${#REPO_BRANCH}
		n=$((n + 1))
	done <<EOF
$AGENT_ROWS
EOF
	[ $n -gt 0 ] || return 0
	[ $w -gt 48 ] && w=48
	i=0
	{
		printf -- '-1\t\t-\t-\t   %-*s  %5s  %-16s  %s\n' "$w" "REPO/BRANCH" "AGE" "FILES" "LAST PROMPT / WAITING ON"
		while [ $i -lt $n ]; do
			printf '%s\t%s\t%s\t%s\t%s  %-*.*s  %5s  %-16s  %s\n' "${k_rank[i]}" "${k_key[i]}" \
				"${k_pane[i]}" "${k_tab[i]}" "${k_icon[i]}" "$w" "$w" "${k_rb[i]}" \
				"${k_age[i]}" "${k_files[i]}" "${k_text[i]}"
			i=$((i + 1))
		done
	} | sort -t "$TAB" -k1,1n -k2,2 | cut -f3-
}

cmd_preview() {
	local pane=${1#terminal_} info root state waiting prompt last
	pane=${pane%%[!0-9]*}
	state_file "$pane"
	info=$(jq -r '[.root // .cwd // "", .state // "", .waiting // "", .prompt // "", .last_message // ""]
		| map(tostring) | join("\u001f")' "$SF" 2>/dev/null)
	IFS=$US read -r root state waiting prompt last <<<"$info"
	printf '\033[1m%s\033[0m\n' "$root"
	[ -n "$waiting" ] && printf '\033[31mneeds you: %s\033[0m\n' "$waiting"
	[ -n "$prompt" ] && printf 'prompt: %s\n' "$prompt"
	[ -n "$last" ] && printf '\033[2mreply: %s\033[0m\n' "$last"
	[ -d "$root" ] && git -C "$root" -c color.status=always status -sb 2>/dev/null | head -n 12
	printf '\033[2m%s\033[0m\n' "────────────────────────────────────────"
	zellij action dump-screen --ansi --pane-id "terminal_$pane" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -n 40
}

# Jump to pane PANE in tab TAB and count it as seen.
jump_to() {
	zellij action go-to-tab-by-id "$2" >/dev/null 2>&1 || true
	zellij action focus-pane-id "terminal_$1" >/dev/null 2>&1 || true
	mark_seen "$1"
}

cmd_ls() {
	local rows out key sel pane tab q fzf=0
	need_session
	command -v fzf >/dev/null 2>&1 && [ -t 1 ] && fzf=1
	rows=$(COLOR=$fzf ls_rows)
	if [ -z "$rows" ]; then
		echo "no agents in zellij session $SESSION"
		[ $fzf = 1 ] && sleep 1.5
		return 0
	fi
	if [ $fzf = 0 ]; then
		printf '%s\n' "$rows" | cut -f3-
		return 0
	fi
	q=$(printf '%q' "$SELF")
	# fzf runs preview/reload through $SHELL, which may be fish.
	out=$(printf '%s\n' "$rows" | SHELL=/bin/sh fzf --delimiter "$TAB" --with-nth 3.. --reverse \
		--no-sort --ansi --prompt 'agents> ' --expect ctrl-e --header-lines 1 \
		--header 'enter: jump   ctrl-e: jump + nvim   ctrl-r: reload' \
		--preview "$q _preview {1}" --preview-window 'down,60%,border-top,wrap' \
		--bind "ctrl-r:reload(COLOR=1 $q _rows)")
	[ -n "$out" ] || return 0
	key=${out%%"$NL"*}
	sel=${out#*"$NL"}
	[ -n "$sel" ] && [ "$sel" != "$out" ] || return 0
	pane=${sel%%"$TAB"*}
	sel=${sel#*"$TAB"}
	tab=${sel%%"$TAB"*}
	jump_to "$pane" "$tab"
	[ "$key" = ctrl-e ] && exec "$SELF" edit "$pane"
	return 0
}

# Jump to the agent that has needed you longest; failing that, the one that
# finished longest ago and you haven't looked at yet.
cmd_next() {
	local pane tab state root ts since seen prompt waiting class best="" best_tab="" best_class=9 best_since=""
	need_session
	agent_rows
	while IFS=$US read -r pane tab state root ts since seen prompt waiting; do
		case $pane in '' | gc) continue ;; esac
		case $state in
		needs-you) class=0 ;;
		done) [ "$seen" = true ] && continue || class=1 ;;
		*) continue ;;
		esac
		if [ $class -lt $best_class ] || { [ $class = $best_class ] && [ "$since" -lt "$best_since" ]; }; then
			best=$pane best_tab=$tab best_class=$class best_since=$since
		fi
	done <<EOF
$AGENT_ROWS
EOF
	if [ -z "$best" ]; then
		echo "agentnav: no agent needs you"
		[ -t 1 ] && sleep 1
		return 0
	fi
	jump_to "$best" "$best_tab"
}

# ---------------------------------------------------------------- main

usage() {
	cat <<'EOF'
usage: agentnav <command>
  hook                       Claude Code hook (reads the event JSON on stdin)
  edit [--full] [pane-id]    open or jump to the nvim for the focused agent
  ls                         dashboard of the agents in this zellij session
  next                       jump to the agent that has needed you longest
  nvim <agent-pane> [file]   internal: start the nvim bound to an agent
EOF
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
hook) cmd_hook "$@" ;;
edit) cmd_edit "$@" ;;
nvim) cmd_nvim "$@" ;;
ls) cmd_ls ;;
next) cmd_next ;;
_rows) need_session && ls_rows ;;
_preview) need_session && cmd_preview "$@" ;;
-h | --help | help) usage ;;
*)
	usage >&2
	exit 2
	;;
esac
