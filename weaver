#!/usr/bin/env bash
# weaver: keep track of the coding agents running in zellij panes, and open
# neovim in the worktree each agent is really editing.
#
#   weaver                          attach to or start the zellij session; inside it, the dashboard
#   weaver new [task...]            start a thread: a tab with nvim and a new agent, in a new worktree
#   weaver close [pane-id]          close an agent, its nvim and its thread's tab
#   weaver resume [--all] [which]   bring back threads lost when their zellij went
#   weaver quit [--yes]             quit the zellij session and everything in it (threads come back)
#   weaver send PANE < text         the text to an agent's prompt (review notes from its nvim)
#   weaver hook [--async]           Claude Code hook for every event (JSON on stdin)
#   weaver event [--bell]           report an event from any agent (normalized JSON on stdin)
#   weaver adapt codex [--bell]     Codex hook (its own event JSON on stdin)
#   weaver edit [--full] [pane-id]  open, or jump to, the nvim bound to the focused agent
#   weaver nvim <agent-pane> [file] internal: start the nvim bound to one agent
#   weaver ls                       live dashboard of every agent in this zellij session
#   weaver next                     jump to the next agent that needs you (repeat to cycle)
#   weaver status [--zjstatus]      the agent counts (formatted for zjstatus)
#   weaver snapshot --reviewed [dir] mark the worktree reviewed
#
# Must stay bash 3.2 compatible (macOS /bin/bash): no mapfile, no ${x,,}, no
# BASHPID, no GNU-only flags.

# The state glyphs: Micrographics task cells (the vault's checkboxes, as
# brackets), the same everywhere: the dashboard, home, the status counts, the
# nvim bar and Worktrunk's markers.
#   [!] needs you (red)   [x] done (green; faint once seen)   [/] working
#   [ ] idle              [-] interrupted, or ended
G_NEED='[!]' G_DONE='[x]' G_SEEN='[x]' G_WORK='[/]' G_IDLE='[ ]' G_INT='[-]' G_END='[-]'

# A state's cell, into GCELL: the one mapping from states to glyphs (the board,
# home, the sidebar, Worktrunk's markers; nvim's GLYPH in status.lua matches).
state_cell() {
	case $1 in
	needs-you) GCELL=$G_NEED ;;
	done) GCELL=$G_DONE ;;
	working | starting) GCELL=$G_WORK ;;
	interrupted) GCELL=$G_INT ;;
	ended) GCELL=$G_END ;;
	*) GCELL=$G_IDLE ;;
	esac
}

# The counts (needs you, done, working) in the status line's #[...] styles,
# zjstatus's and tmux's, into COUNTS_FMT: each count's cell faint brackets,
# its mark in the signal colour.
counts_fmt() {
	COUNTS_FMT=""
	[ "${1:-0}" -gt 0 ] && COUNTS_FMT="$COUNTS_FMT#[fg=#616161][#[fg=#ff3b2f]!#[fg=#616161]]#[fg=#999999] $1  "
	[ "${2:-0}" -gt 0 ] && COUNTS_FMT="$COUNTS_FMT#[fg=#616161][#[fg=#39d97a]x#[fg=#616161]]#[fg=#999999] $2  "
	[ "${3:-0}" -gt 0 ] && COUNTS_FMT="$COUNTS_FMT#[fg=#616161][#[fg=#999999]/#[fg=#616161]]#[fg=#999999] $3  "
	return 0
}

# zjstatus runs `weaver status --zjstatus` every couple of seconds in every
# tab: answer from the counts the hooks keep, before parsing anything else.
# It must never fail or hang zjstatus: no external command, only a file read
# (bounded by read -t), empty output and status 0 on anything unexpected.
# `weaver status --tmux SESSION` answers the same for a tmux session (whose
# status line weaver sets itself, push_status).
if [ "${1:-}" = status ] && { [ "${2:-}" = --zjstatus ] || [ "${2:-}" = --tmux ]; }; then
	n=0 d=0 w=0
	k=${ZELLIJ_SESSION_NAME:-}
	[ "$2" = --tmux ] && k=${3:-} && [ -n "$k" ] && k="tmux-$k"
	f="${XDG_STATE_HOME:-${HOME:-/nonexistent}/.local/state}/weaver/${k//\//_}.status"
	[ -n "$k" ] && [ -f "$f" ] && { read -r -t 1 n d w _ <"$f"; } 2>/dev/null
	case "${n:-0}${d:-0}${w:-0}" in *[!0-9]*) n=0 d=0 w=0 ;; esac
	counts_fmt "$n" "$d" "$w"
	printf '%s\n' "$COUNTS_FMT"
	exit 0
fi

set -u

# The hook's string work is all byte-wise, and bash's pattern matching is
# several times faster in the C locale than in UTF-8. Restored (load_rest) for
# the background work and never seen by the other commands.
if [ "${1:-}" = hook ]; then
	WEAVER_LC_ALL=${LC_ALL-} WEAVER_LC_SET=${LC_ALL+1}
	LC_ALL=C
fi

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/weaver"
LOG_DIR="$STATE_DIR/log"
# /tmp rather than $TMPDIR: macOS caps unix socket paths at ~104 bytes.
SOCK_DIR="/tmp/weaver-${UID:-$(id -u)}"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
# The multiplexer: tmux or zellij. $WEAVER_MUX says, else the session weaver
# runs in; outside both, tmux. MY_PANE is the pane this runs in (empty in a
# tmux popup or run-shell, which are not panes), SESSION its session's name.
# A tmux session's files are keyed tmux-<name> (SKEY), so a zellij and a tmux
# session of one name never mix their pane ids.
if [ -n "${WEAVER_MUX:-}" ]; then
	MUX=$WEAVER_MUX
elif [ -n "${ZELLIJ_SESSION_NAME:-}" ]; then
	MUX=zellij
else
	MUX=tmux
fi
case $MUX in
tmux | zellij) ;;
*)
	# A hook never fails the agent over it.
	[ "${1:-}" = hook ] && exit 0
	printf 'weaver: WEAVER_MUX is tmux or zellij, not %s\n' "$MUX" >&2
	exit 1
	;;
esac
if [ "$MUX" = tmux ]; then
	MY_PANE=${TMUX_PANE:-}
	MY_PANE=${MY_PANE#%}
	SESSION=""
	if [ -n "${TMUX:-}" ]; then
		# weaver's tmux sessions set it for their panes; anywhere else, ask.
		SESSION=${WEAVER_TMUX_SESSION:-$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#S' 2>/dev/null)}
	fi
	SKEY="${SESSION:+tmux-}${SESSION//\//_}"
else
	MY_PANE=${ZELLIJ_PANE_ID:-}
	SESSION="${ZELLIJ_SESSION_NAME:-}"
	SKEY="${SESSION//\//_}"
fi
US=$'\037' # field separator for jq output; never appears in paths or prompts
RS=$'\036' # list separator inside one field
TAB=$'\t'
NL=$'\n'

# Micrographics: ink and greys, with green and red only as signals.
C_RED=$'\033[38;2;255;59;47m'
C_GREEN=$'\033[38;2;57;217;122m'
C_GREY=$'\033[38;2;153;153;153m'
C_DIM=$'\033[38;2;97;97;97m'
C_BOLD=$'\033[1m'
C_INK=$'\033[38;2;255;255;255m'
C_OFF=$'\033[0m'
# fzf in Micrographics: the current line pure-inverted, greys for the chrome.
FZF_COLORS='fg:-1,bg:-1,hl:-1:underline,fg+:#000000:strip,bg+:#ffffff,hl+:#000000:underline,gutter:-1,pointer:#000000,marker:#ffffff,header:-1,footer:#616161,border:#616161,preview-border:#616161,query:#ffffff,prompt:#999999,info:#616161,ghost:#616161,spinner:#616161,separator:#616161,label:#999999'

case $0 in /*) SELF=$0 ;; *) SELF="$PWD/$0" ;; esac


die() {
	printf 'weaver: %s\n' "$*" >&2
	exit 1
}

need_session() {
	[ -n "$SESSION" ] || die "not inside a zellij or tmux session"
}

# ---------------------------------------------------------------- multiplexer
#
# What weaver asks of zellij or tmux, by MUX. tmux answers in zellij's JSON
# (list-panes -j, list-tabs -j) so the rest of weaver reads one shape: a tab
# is a tmux window (its id @N as N, its index as its position), a pane's id
# %N is N, and nothing floats (tmux's popups are not panes).

# weaver's own tmux server: $WEAVER_TMUX_SOCKET, a name (tmux -L) or a
# socket's path (tmux -S); "weaver" by default.
case ${WEAVER_TMUX_SOCKET:-weaver} in
*/*) TSOCK=(-S "$WEAVER_TMUX_SOCKET") ;;
*) TSOCK=(-L "${WEAVER_TMUX_SOCKET:-weaver}") ;;
esac

# tmux: the server we run in, else weaver's own.
tm() {
	if [ -n "${TMUX:-}" ]; then
		tmux "$@"
	else
		tmux "${TSOCK[@]}" "$@"
	fi
}

# The session's panes, as zellij's list-panes -a -j.
mux_panes() {
	local out
	if [ "$MUX" != tmux ]; then
		zellij action list-panes -a -j 2>/dev/null
		return
	fi
	out=$(tm list-panes -s -t "=$SESSION" -F "#{pane_id}$US#{window_id}$US#{window_name}$US#{window_index}$US#{pane_dead}$US#{pane_start_command}$US#{pane_width}$US#{pane_height}$US#{pane_left}$US#{pane_top}$US#{pane_title}$US#{pane_current_path}$US#{pane_active}" 2>/dev/null) ||
		return 1
	printf '%s\n' "$out" | jq -Rsc '[split("\n")[] | select(length > 0) | split("\u001f")
		| {id: (.[0][1:] | tonumber), is_plugin: false, is_floating: false,
		   tab_id: (.[1][1:] | tonumber), tab_name: .[2], tab_position: (.[3] | tonumber),
		   exited: (.[4] == "1"), terminal_command: .[5],
		   pane_columns: (.[6] | tonumber), pane_rows: (.[7] | tonumber),
		   pane_x: (.[8] | tonumber), pane_y: (.[9] | tonumber),
		   title: .[10], pane_cwd: .[11], is_focused: (.[12] == "1")}]'
}

# The session's tabs, as zellij's list-tabs -j.
mux_tabs() {
	local out
	if [ "$MUX" != tmux ]; then
		zellij action list-tabs -j 2>/dev/null
		return
	fi
	out=$(tm list-windows -t "=$SESSION" -F "#{window_id}$US#{window_index}$US#{window_name}$US#{window_active}$US#{window_width}$US#{window_height}" 2>/dev/null) ||
		return 1
	printf '%s\n' "$out" | jq -Rsc '[split("\n")[] | select(length > 0) | split("\u001f")
		| {tab_id: (.[0][1:] | tonumber), position: (.[1] | tonumber), name: .[2],
		   active: (.[3] == "1"), viewport_columns: (.[4] | tonumber), viewport_rows: (.[5] | tonumber)}]'
}

mux_go_tab() {
	if [ "$MUX" = tmux ]; then
		tm select-window -t "@$1" >/dev/null 2>&1
	else
		zellij action go-to-tab-by-id "$1" >/dev/null 2>&1
	fi
}

mux_close_pane() {
	if [ "$MUX" = tmux ]; then
		tm kill-pane -t "%$1" >/dev/null 2>&1
	else
		zellij action close-pane --pane-id "terminal_$1" >/dev/null 2>&1
	fi
}

mux_rename_pane() {
	if [ "$MUX" = tmux ]; then
		tm select-pane -t "%$1" -T "$2" </dev/null >/dev/null 2>&1
	else
		zellij action rename-pane --pane-id "terminal_$1" "$2" </dev/null >/dev/null 2>&1
	fi
}

mux_rename_tab() {
	if [ "$MUX" = tmux ]; then
		tm rename-window -t "@$1" "$2" </dev/null >/dev/null 2>&1
	else
		zellij action rename-tab-by-id "$1" "$2" </dev/null >/dev/null 2>&1
	fi
}

# Pane $1's screen, with its colours.
mux_screen() {
	if [ "$MUX" = tmux ]; then
		tm capture-pane -p -e -t "%$1" 2>/dev/null
	else
		zellij action dump-screen --ansi --pane-id "terminal_$1" 2>/dev/null
	fi
}

# The panes your clients are looking at, into MUX_CLIENT_PANES (" 3 7 ").
mux_clients() {
	local out
	if [ "$MUX" = tmux ]; then
		out=$(tm list-clients -F '#{pane_id}' 2>/dev/null)
		out=${out//%/}
		MUX_CLIENT_PANES=" ${out//$NL/ } "
	else
		MUX_CLIENT_PANES=" $(zellij action list-clients 2>/dev/null | awk 'NR > 1 { sub("terminal_", "", $2); printf "%s ", $2 }')"
	fi
	return 0
}

# The running sessions' keys (SKEY), one per line, of both: zellij's, and
# tmux's on weaver's server and the one we run in.
mux_session_keys() {
	zellij list-sessions --short --no-formatting 2>/dev/null | sed 's|/|_|g'
	command -v tmux >/dev/null 2>&1 || return 0
	{
		tmux "${TSOCK[@]}" list-sessions -F '#S' 2>/dev/null
		[ -n "${TMUX:-}" ] && tmux list-sessions -F '#S' 2>/dev/null
	} | sed 's|/|_|g; s|^|tmux-|'
}

# tmux: the sessions of the server we run in (else weaver's), one
# "<key> <epoch it was created>" per line.
tmux_sessions() {
	tm list-sessions -F '#S #{session_created}' 2>/dev/null | sed 's|/|_|g; s|^|tmux-|'
}

state_file() { SF="$STATE_DIR/${SKEY}_$1.json"; }
sock_path() { SOCK="$SOCK_DIR/${SKEY}_$1.sock"; }
# The agent's nvim lives in its own file, written only by `weaver edit` and
# `weaver nvim`, so racing hooks can never lose it: line 1 its pane id, line 2
# its pid (empty while it starts).
nvim_file() { NVF="$STATE_DIR/${SKEY}_$1.nvim"; }
# The agent's nvim pane into NV and pid into NVPID; both empty when the file is
# stale (that nvim has exited), so a reused pane id is never renamed.
read_nvim_pane() {
	NV="" NVPID=""
	nvim_file "$1"
	[ -f "$NVF" ] || return 0
	{
		read -r NV
		read -r NVPID
	} <"$NVF"
	case $NV in *[!0-9]*) NV="" ;; esac
	case $NVPID in *[!0-9]*) NVPID="" ;; esac
	if [ -n "$NVPID" ] && ! kill -0 "$NVPID" 2>/dev/null; then
		NV="" NVPID=""
	fi
}

# Serialise read-modify-write of state file $SF. The lock is $SF.lock, created
# exclusively (noclobber) holding the owner's pid; the new state is written
# into it and renamed over $SF, which also releases it. A waiter removes a
# lock only when its owner is no longer running, so a held lock is never
# stolen however long it is held. After ~2s it goes ahead with a private file
# rather than block the agent (risking a lost update, never a corrupt file).
lock() {
	local i=0 owner again
	LOCK="$SF.lock"
	set -C
	until { printf '%s\n' "$$" >"$LOCK"; } 2>/dev/null; do
		i=$((i + 1))
		owner=""
		{ read -r owner <"$LOCK"; } 2>/dev/null
		case $owner in
		'' | *[!0-9]*) ;; # being written: its owner is alive
		*)
			if ! kill -0 "$owner" 2>/dev/null; then
				# Read again just before removing, so a lock that another
				# waiter has meanwhile retaken survives.
				again=""
				{ read -r again <"$LOCK"; } 2>/dev/null
				[ "$again" = "$owner" ] && rm -f "$LOCK"
				continue
			fi
			;;
		esac
		if [ $i -ge 100 ]; then
			LOCK="$SF.$$.tmp"
			break
		fi
		sleep 0.02
	done
	set +C
}
commit_lock() { mv -f "$LOCK" "$SF"; }
drop_lock() { rm -f "$LOCK"; }

# JSON string literal for $1, into J. jq has already turned control characters
# into spaces in what comes from the agent; for anything else (git paths), tabs
# and newlines are escaped and other control characters become spaces.
json_str() {
	case $1 in
	*[\\\"[:cntrl:]]*) ;;
	*)
		J="\"$1\""
		return 0
		;;
	esac
	local s=${1//\\/\\\\}
	s=${s//\"/\\\"}
	s=${s//$TAB/\\t}
	s=${s//$NL/\\n}
	s=${s//[[:cntrl:]]/ }
	J="\"$s\""
}

# The work tree holding directory $1, into TOP: the nearest ancestor with a
# .git (a directory, or the file of a worktree or submodule), as a physical
# path like git's. No git spawn: the hook calls this on every move. Returns 1
# outside a repository.
find_top() {
	local d old=$PWD
	TOP=""
	cd -P -- "$1" 2>/dev/null || return 1
	d=$PWD
	cd -- "$old" 2>/dev/null
	[ "$d" = / ] && d=""
	while :; do
		if [ -e "$d/.git" ]; then
			TOP=${d:-/}
			return 0
		fi
		[ -n "$d" ] || return 1
		d=${d%/*}
	done
}
# The work tree holding path $1 (a file that may not exist yet, in directories
# that may not exist yet), into TOP.
file_top() {
	local d=${1%/*}
	while [ -n "$d" ] && [ ! -d "$d" ]; do d=${d%/*}; done
	find_top "${d:-/}"
}
# Is the agent process PID (started at PROC_START, if known) still running?
# kill -0 alone would trust a reused pid; ps confirms the start time.
agent_alive() {
	local pid=$1 start=${2:-} now
	case $pid in '' | *[!0-9]*) return 0 ;; esac
	kill -0 "$pid" 2>/dev/null || return 1
	[ -n "$start" ] || return 0
	now=$(TZ=UTC LC_ALL=C ps -o lstart= -p "$pid" 2>/dev/null)
	[ -n "$now" ] || return 0
	# Compare word by word: ps pads single-digit days.
	set -f
	set -- $now
	now="$*"
	set -- $start
	set +f
	[ "$now" = "$*" ]
}

# procStart of Claude Code process $1, from its session file (no spawn), into
# PROC_START; empty if unknown.
claude_proc_start() {
	local line="" re='"procStart":"([^"]*)"'
	PROC_START=""
	[ -f "$CLAUDE_DIR/sessions/$1.json" ] || return 0
	{ IFS= read -r line <"$CLAUDE_DIR/sessions/$1.json"; } 2>/dev/null
	[[ $line =~ $re ]] && PROC_START=${BASH_REMATCH[1]}
	return 0
}

# The hook parses only the code above the hook's dispatch, so it starts fast;
# everything else (the background work, the other commands) is defined below
# it, and loaded by sourcing this file again.
load_rest() {
	if [ "${LC_ALL-}" = C ] && [ -n "${WEAVER_LC_SET+x}" ]; then
		if [ -n "$WEAVER_LC_SET" ]; then LC_ALL=$WEAVER_LC_ALL; else unset LC_ALL; fi
	fi
	[ -n "${WEAVER_REST:-}" ] || WEAVER_SOURCED=1 . "$SELF"
}

# ---------------------------------------------------------------- hook

# The hook event (stdin) plus the stored state ($st), as one US-separated line;
# see the read in hook_run for the fields. key identifies a tool call (name +
# input), so the PostToolUse of an approved tool can be matched to the
# PermissionRequest that asked for it. Arrays (files, subagents, tasks) come
# back already updated, as JSON.
# The hook's one jq program: the event (stdin) plus the stored state ($st), as
# one US-separated line; see the read in hook_run for the fields. key
# identifies a tool call (name + input), so the PostToolUse of an approved
# tool can be matched to the PermissionRequest that asked for it. Arrays
# (files, subagents, tasks) come back already updated, as JSON.

JQ_TOOLS='
def edit_file:
  (.tool_name // "") as $t
  | if .hook_event_name == "PostToolUse" and ($t == "Edit" or $t == "Write" or $t == "MultiEdit" or $t == "NotebookEdit") then
      ((.tool_input | objects | .file_path // .notebook_path) // "") | line
      | if . == "" or startswith("/") then . else (.cwd // "" | tostring) + "/" + . end
    else "" end;
# Absolute paths in a Bash command (cd targets, VAR=/path, arguments), or in
# an MCP tool input: where to look for what it changed.
def command_paths:
  if (.tool_name // "") | startswith("mcp__") then
    [.tool_input | .. | strings | select(startswith("/")) | line] | unique | .[0:8] | join("\u001e")
  elif .tool_name != "Bash" then "" else
  ([39] | implode) as $q
  | [(.tool_input | objects | .command // "") | tostring
     | scan("(?:^|[\\s=;&|(\"" + $q + ":])(/[^\\s\"" + $q + ";&|()<>`$*?:]+)") | .[0] | line]
  | unique | .[0:8] | join("\u001e") end;
# A rejected permission dialog stops the agent until you say more; with
# feedback typed in, it carries on.
def rejected:
  .hook_event_name == "PostToolBatch"
  and ([(.tool_calls // []) | arrays | .[] | objects | (.tool_response // "") | tostring
        | select(test("doesn.t want to proceed with this tool use") and (test("the user said:") | not))]
       | length > 0);
def files_new($files; $file): if $file != "" then ($files - [$file]) + [$file] | .[-200:] else $files end;
def subs_new($subs; $aid; $now):
  if .hook_event_name == "SubagentStart" and $aid != "" then
    ($subs | map(select(.id != $aid))) + [{id: $aid, type: (.agent_type // "" | one(40)), since: ($now | floor)}]
  elif .hook_event_name == "SubagentStop" then $subs | map(select(.id != $aid))
  elif .hook_event_name == "Stop" and (background | length) == 0 then []
  elif .hook_event_name == "SessionStart" and .source != "compact" then []
  else $subs end;
def tasks_new($tasks):
  (.task_id // "" | tostring) as $tid
  | (.task_subject // "" | one(80)) as $tsub
  | if .hook_event_name == "TaskCreated" then ($tasks | map(select(.id != $tid))) + [{id: $tid, subject: $tsub, done: false}] | .[-30:]
    elif .hook_event_name == "TaskCompleted" then
      if any($tasks[]; .id == $tid) then $tasks | map(if .id == $tid then .done = true else . end)
      else $tasks + [{id: $tid, subject: $tsub, done: true}] | .[-30:] end
    elif .hook_event_name == "SessionStart" and .source != "compact" and .source != "resume" then []
    else $tasks end;
'
JQ_DEFS='
def line: tostring | gsub("[\u0000-\u001f\u007f]+"; " ");
def one($n): tostring | gsub("[\\s\u0000-\u001f\u007f]+"; " ") | ltrimstr(" ") | rtrimstr(" ") | .[0:$n];
def summary:
  ((.tool_input | objects) // {}) as $i
  | (($i.file_path // $i.notebook_path) // null) as $fp
  | if .tool_name == "Bash" then "Bash: " + ($i.command // "" | tostring)
    elif .tool_name == "AskUserQuestion" then "question: " + ((($i.questions // []) | arrays | .[0].question?) // "" | tostring)
    elif $fp then (.tool_name // "") + ": " + ($fp | tostring | split("/") | last)
    else (.tool_name // "") end;
# Subagent reports, task notifications and peer messages arrive as prompts,
# but are not yours.
def yours:
  (.source // "user") == "user"
  and ((.prompt // "") | tostring
       | test("^\\s*(<agent-message|<task-notification|<teammate-message|<channel|Another Claude session sent a message)") | not);
# Background subagents and workflows still running when the agent stops: it
# will wake up when they report back.
def background: [(.background_tasks // []) | arrays | .[] | objects | select(.type == "subagent" or .type == "workflow")];
'
JQ_MAIN='
((try ($st | fromjson) catch {}) | if type == "object" then . else {} end) as $s
| (.session_id // "" | tostring) as $sid
| (if ($s.session_id // "") == $sid then $s else {} end) as $o
| (.agent_id // "" | tostring) as $aid
| (now) as $now
| edit_file as $file
| command_paths as $paths
| [ .hook_event_name // "",
    .cwd // "",
    $sid,
    $file,
    (if .hook_event_name == "UserPromptSubmit" and yours then .prompt // "" | one(120) else "" end),
    (if .hook_event_name == "UserPromptSubmit" and yours then .prompt // "" | one(2000) else "" end),
    .tool_name // "",
    .notification_type // "",
    ($now | floor),
    ($now * 1000 | floor),
    (if .hook_event_name == "PermissionRequest" or .hook_event_name == "PreToolUse" then summary
     elif .hook_event_name == "Notification" then (.message // "")
     elif .hook_event_name == "StopFailure" then "error: " + (.error // "" | tostring)
     else "" end | one(100)),
    (if .tool_name then .tool_name + ":" + (.tool_input | tojson | .[0:300]) else "" end),
    (.last_assistant_message // "" | one(400)),
    $aid,
    (.agent_type // "" | one(40)),
    (if .hook_event_name == "Stop" then background | length else "" end),
    (if .hook_event_name == "Stop" then background | map(.description // "" | one(80)) | join("; ") | one(240) else "" end),
    .source // "",
    (if .is_interrupt == true then 1 else "" end),
    (.session_title // "" | one(80)),
    .prompt_id // "",
    .transcript_path // "",
    .new_cwd // "",
    (if rejected then 1 else "" end),
    (.error // "" | tostring | one(100)),
    (if .tool_name == "Bash" then (.tool_input | objects | .command // "") | one(200) else "" end),
    (if .hook_event_name == "SessionEnd" then .reason // "" | one(40) else "" end),
    $s.cwd // "", $s.root // "", $s.file // "", $s.prompt // "",
    $s.state // "", $s.session_id // "", $s.start_cwd // "", $s.since // "",
    $s.waiting // "", $s.pending // "", $s.last_message // "", ($s.seen // false),
    $s.marked_root // "", $s.marker // "", $s.project_root // "",
    $s.background // "", $s.background_tasks // "",
    $s.pid // "", $s.proc_start // "", $o.title // "", $o.turn // 0, $o.turn_ended // 0,
    $o.prompt_id // "", $o.transcript // "", $s.agent // "", $o.end_reason // "",
    (files_new(($o.files // []) | arrays; $file) | tojson),
    (subs_new(($o.subagents // []) | arrays; $aid; $now) | tojson),
    (tasks_new(($o.tasks // []) | arrays) | tojson)
  ] | map(tostring) | join("\u001f") | gsub("[\u0000-\u001d\u007f]"; " ")
  | . + "\u001f" + (($o.turn_roots // []) | arrays | map(line) | join("\u001e")) + "\u001f" + $paths'

# Ring the bell (terminalSequence is written by Claude Code to the agent's
# terminal): zellij marks the tab until you look at it.
BELL_JSON='{"terminalSequence":"\u0007"}'

cmd_hook() {
	local rc mode=sync
	[ "${1:-}" = --async ] && mode=async
	[ -n "${MY_PANE:-}" ] && [ -n "$SESSION" ] || exit 0
	[ -t 0 ] && exit 0
	if [ -n "${WEAVER_DEBUG:-}" ]; then
		[ "$WEAVER_DEBUG" = trace ] && set -x
		mkdir -p "$STATE_DIR" && (hook_run "$mode") >/dev/null 2>>"$STATE_DIR/hook.log"
	else
		(hook_run "$mode") >/dev/null 2>&1
	fi
	rc=$?
	if [ "$mode" = sync ]; then
		case ${WEAVER_BELL:-1}:$rc in
		1:10 | 1:11 | needs-you:10) printf '%s\n' "$BELL_JSON" ;;
		esac
	fi
	exit 0
}

# The stored state's state and pid, read without a spawn, into PK_STATE and
# PK_PID (and PK_START).
peek_state() {
	local line="" re_s='"state":"([a-z-]+)"' re_p='"pid":([0-9]+)' re_t='"proc_start":"([^"]*)"'
	PK_STATE="" PK_PID="" PK_START=""
	[ -f "$SF" ] && { IFS= read -r line <"$SF"; } 2>/dev/null
	[[ $line =~ $re_s ]] && PK_STATE=${BASH_REMATCH[1]}
	[[ $line =~ $re_p ]] && PK_PID=${BASH_REMATCH[1]}
	[[ $line =~ $re_t ]] && PK_START=${BASH_REMATCH[1]}
	return 0
}

# The async hook runs after every tool call; most of them change nothing. Read
# the event only as far as its tool name (comma-separated chunks, so no
# multibyte character is split) into HEAD, and return 1 when there is nothing
# to do.
async_gate() {
	local part i t
	HEAD=""
	for ((i = 0; i < 16; i++)); do
		if ! IFS= read -r -d , part; then
			HEAD="$HEAD$part"
			break
		fi
		HEAD="$HEAD$part,"
		case $part in *'"tool_name":'* | *'"hook_event_name":"'[!P]*) break ;; esac
	done
	case $HEAD in
	*'"hook_event_name":"PostToolUse"'*)
		t=${HEAD#*\"tool_name\":\"}
		t=${t%%\"*}
		case $t in
		Bash | Edit | Write | MultiEdit | NotebookEdit | EnterWorktree | ExitWorktree) return 0 ;;
		mcp__*)
			case $t in
			*[Ww]rite* | *[Ee]dit* | *[Rr]eplace* | *[Ii]nsert* | *[Cc]reate* | *[Pp]atch* | *[Aa]pply* | \
				*[Rr]ename* | *[Mm]ove* | *[Dd]elete*) return 0 ;;
			esac
			;;
		esac
		[ "$PK_STATE" != working ]
		;;
	*'"hook_event_name":"PostToolBatch"'*) [ "$PK_STATE" = needs-you ] ;;
	*) return 0 ;;
	esac
}

# Append one line to the agent session's activity log: $1 is the event's
# fields after "ev", as JSON members (`,"k":v...`).
log_line() {
	[ -n "$LOGF" ] || return 0
	json_str "$pane"
	printf '{"t":%s,"pane":%s,"turn":%s,"ev":"%s"%s}\n' "${now:-0}" "$J" "${turn:-0}" "$1" "${2:-}" >>"$LOGF" 2>/dev/null
}

# Kept to one jq and one mv, plus forks: the hook runs on every agent event
# and must stay fast. nvim, zellij, Worktrunk, snapshots and the status bar
# are all updated from a background fork (hook_bg) after the state is written.
# Mode "async" is the hook Claude Code runs in the background after every tool
# call (and for the events nobody waits on); it returns at once when the call
# can change nothing, and after Bash or an MCP edit tool follows the files the
# call changed.
# Returns 10 when the agent has just started needing you, 11 when it has just
# finished (ring the bell).
hook_run() {
	local mode=$1 pane=$MY_PANE parsed J out moved=0 rc=0 HEAD=""
	local event cwd sid file prompt prompt_long tool ntype now now_ms waiting_new key last_new aid atype bg_new bgdesc_new
	local source interrupt title_new prompt_id transcript new_cwd rejected err cmd end_new
	local o_cwd o_root o_file o_prompt o_state o_sid o_start o_since o_waiting o_pending o_last o_seen
	local o_marked o_marker o_proj o_bg o_bgdesc o_pid o_procstart o_title o_turn o_turn_ended o_promptid
	local o_transcript o_agent o_end o_turn_roots files_json subs_json tasks_json paths end_reason
	local root="" d state ev_file="" start since waiting pending last seen marked marker proj mark_dir bg bgdesc
	local pid proc_start title turn turn_ended turn_roots agent_kind=${WEAVER_AGENT:-claude} LOGF=""
	local snap_prev="" snap_start="" snap_end="" first_touch="" prev_prompt="" turn_prompt="" seq
	[ -d "$STATE_DIR" ] || mkdir -p "$STATE_DIR" || return
	state_file "$pane"
	peek_state
	# A session nested in this pane's agent (claude -p, an SDK script) inherits
	# ZELLIJ_PANE_ID: while the pane's own agent runs, its events are not ours.
	local me=${WEAVER_AGENT_PID:-${CLAUDE_PID:-}}
	if [ -n "$me" ] && [ -n "$PK_PID" ] && [ "$me" != "$PK_PID" ]; then
		if agent_alive "$PK_PID" "$PK_START"; then
			[ "$PK_STATE" != ended ] && return 0
		else
			# The pane's last agent died with a zellij that is gone, and this
			# zellij gave its pane id to a new agent: keep the old one's
			# thread as lost before this state replaces it.
			load_rest
			lost_check "$SF" && lose "$SF" "$PK_PID"
			peek_state
		fi
	fi
	if [ "$mode" = async ]; then async_gate || return 0; fi
	lock
	if [ -f "$SF" ]; then set -- --rawfile st "$SF"; else set -- --arg st ""; fi
	if [ "$mode" = async ]; then
		parsed=$(jq -rRs --arg h "$HEAD" "$@" '($h + .) | fromjson | '"$JQ_DEFS$JQ_TOOLS$JQ_MAIN")
	else
		parsed=$(jq -r "$@" "$JQ_DEFS$JQ_TOOLS$JQ_MAIN")
	fi || {
		drop_lock
		return
	}
	IFS=$US read -r event cwd sid file prompt prompt_long tool ntype now now_ms waiting_new key last_new \
		aid atype bg_new bgdesc_new source interrupt title_new prompt_id transcript new_cwd rejected err cmd end_new \
		o_cwd o_root o_file o_prompt o_state o_sid o_start o_since o_waiting o_pending o_last o_seen \
		o_marked o_marker o_proj o_bg o_bgdesc o_pid o_procstart o_title o_turn o_turn_ended o_promptid \
		o_transcript o_agent o_end files_json subs_json tasks_json o_turn_roots paths <<<"$parsed"
	if [ -z "$event" ]; then
		# Empty or eventless input: keep the stored state rather than blank it.
		drop_lock
		return
	fi
	NOW=$now seq=$now_ms
	read_nvim_pane "$pane"

	# A new agent session in this pane (not a resume or compaction) starts
	# afresh; otherwise the root is never reset to the start directory.
	if [ -n "$sid" ] && [ "$sid" != "$o_sid" ]; then
		o_cwd="" o_root="" o_file="" o_prompt="" o_state="" o_start="" o_since=""
		o_waiting="" o_pending="" o_last="" o_seen=false o_proj="" o_bg="" o_bgdesc=""
	fi
	pid=${me:-$o_pid} proc_start=$o_procstart
	if [ -n "$pid" ] && { [ "$pid" != "$o_pid" ] || [ -z "$proc_start" ]; }; then
		claude_proc_start "$pid"
		proc_start=$PROC_START
		# Not Claude Code (or before it writes its session file): ask ps, once.
		if [ -z "$proc_start" ] && [ "$pid" != "$o_pid" ]; then
			proc_start=$(TZ=UTC LC_ALL=C ps -o lstart= -p "$pid" 2>/dev/null)
			proc_start=${proc_start%"${proc_start##*[! ]}"}
		fi
	fi

	# A subagent reports its own cwd: only the main agent's is tracked.
	[ -n "$aid" ] && [ -n "$o_cwd" ] && cwd=$o_cwd
	[ "$event" = CwdChanged ] && [ -n "$new_cwd" ] && cwd=$new_cwd
	start=${o_start:-$cwd}
	proj=$o_proj
	if [ -z "$proj" ]; then
		if find_top "${CLAUDE_PROJECT_DIR:-$start}"; then proj=$TOP; else proj=-; fi
	fi

	# Where the agent is really working: the repo of the file it (or one of its
	# subagents) just edited...
	if [ -n "$file" ]; then
		ev_file=$file
		file_top "$file" && root=$TOP
	fi
	# ...else the repo of a new cwd, if it is another repo or worktree. Claude
	# Code snaps cwd back to the start directory after any command that cd's
	# outside it, and an agent looking around its own checkout may still be
	# working in a worktree, so only a real move counts: the worktree tools,
	# CwdChanged, or a cwd in another repo...
	if [ -z "$root" ]; then
		if [ "$cwd" != "$o_cwd" ]; then
			case $event:$tool in
			CwdChanged:*) moved=1 ;;
			*:EnterWorktree | *:ExitWorktree) moved=1 start=$cwd ;;
			*)
				if [ "$cwd" != "$start" ]; then
					if find_top "$cwd"; then d=$TOP; else d=$cwd; fi
					[ "$d" != "$proj" ] && moved=1
				fi
				;;
			esac
		fi
		if [ $moved = 1 ] || [ -z "$o_root" ]; then
			if find_top "$cwd"; then root=$TOP; else root=$cwd; fi
		else
			# ...else wherever it was before.
			root=$o_root
		fi
	fi

	# Turns: each prompt of yours starts one; it ends at Stop, StopFailure or
	# an interrupt. The roots it touches are snapshotted at its end.
	turn=${o_turn:-0} turn_ended=${o_turn_ended:-0} turn_roots=$o_turn_roots
	case $turn in *[!0-9]*) turn=0 ;; esac
	case $turn_ended in *[!0-9]*) turn_ended=0 ;; esac
	if [ "$event" = UserPromptSubmit ] && [ -n "$prompt" ]; then
		# Esc while the model was writing fires nothing: the previous turn
		# ends here.
		[ $turn -gt $turn_ended ] && snap_prev=$turn
		turn=$((turn + 1)) turn_ended=$((turn - 1))
		turn_roots=$root snap_start=1
	elif [ $turn -gt 0 ] && [ -n "$root" ] && { [ -n "$ev_file" ] || [ $moved = 1 ]; }; then
		case "$RS$turn_roots$RS" in
		*"$RS$root$RS"*) ;;
		*)
			turn_roots="$turn_roots${turn_roots:+$RS}$root"
			first_touch=$root
			;;
		esac
	fi
	case $event in
	Stop | StopFailure) [ $turn -gt 0 ] && snap_end=1 ;;
	PostToolUseFailure) [ -n "$interrupt" ] && [ $turn -gt 0 ] && snap_end=1 ;;
	esac
	[ -n "$snap_end" ] && turn_ended=$turn

	waiting=$o_waiting pending=$o_pending bg=$o_bg bgdesc=$o_bgdesc
	state=${o_state:-working}
	case $event in
	SessionStart)
		# A compaction is not a new start: the agent carries on as it was.
		if [ "$source" = compact ]; then state=${o_state:-idle}; else state=idle bg="" bgdesc=""; fi
		;;
	UserPromptSubmit) state=working bg="" bgdesc="" ;;
	PermissionRequest | PreToolUse)
		# A permission dialog, or (PreToolUse on AskUserQuestion) a question.
		state=needs-you waiting=$waiting_new pending=$key
		;;
	Notification)
		case $ntype in
		permission_prompt | elicitation_dialog | elicitation_url_dialog | agent_needs_input | \
			worker_permission_prompt | quota_auto_resume_stale | "")
			# A dialog: keep the more specific text of the request that opened it.
			state=needs-you
			[ "$o_state" = needs-you ] && [ -n "$o_waiting" ] || waiting=$waiting_new
			;;
		elicitation_complete | elicitation_response) [ "$o_state" = needs-you ] && state=working ;;
		quota_auto_resume_fired) state=working ;;
		idle_prompt)
			# The reminder 60s after the agent went quiet: still "working" means
			# Esc stopped it (no Stop fires), unless background work is pending.
			case $o_state in
			working) [ "${o_bg:-0}" -gt 0 ] 2>/dev/null || state=interrupted ;;
			'') state=done ;;
			esac
			;;
		esac
		# agent_completed is about a background agent, not this one.
		;;
	PostToolUse | PostToolUseFailure)
		state=working
		if [ "$event" = PostToolUseFailure ] && [ -n "$interrupt" ]; then
			state=interrupted
		elif [ "$o_state" = needs-you ] && [ -n "$o_pending" ] && [ "$key" != "$o_pending" ]; then
			# Another tool finished while one still waits for you.
			state=needs-you
		else
			# A late async hook must not undo a Stop or an interrupt: async
			# hooks run in parallel and land in any order. One of the turn
			# that ended (its prompt_id) never does; without a prompt_id,
			# one within 3 s of it.
			case $o_state in
			done | idle | interrupted)
				if { [ -n "$prompt_id" ] && [ "$prompt_id" = "$o_promptid" ]; } ||
					[ $((now - ${o_since:-0})) -lt 3 ] 2>/dev/null; then
					state=$o_state
				fi
				;;
			ended) state=ended ;;
			esac
		fi
		;;
	PostToolBatch)
		# Every call in the batch has resolved, so the dialog has been answered.
		if [ "$o_state" = needs-you ]; then
			if [ -n "$rejected" ]; then state=interrupted; else state=working; fi
		fi
		;;
	StopFailure) state=needs-you waiting=$waiting_new pending="" ;;
	Stop)
		# Not done while background subagents work on: their reports wake it.
		bg=$bg_new bgdesc=$bgdesc_new
		state=done
		[ "${bg:-0}" -gt 0 ] 2>/dev/null && state=working
		;;
	SessionEnd) state=ended bg="" bgdesc="" ;;
	esac
	# Why the session ended (Claude Code's SessionEnd reason): /exit, /clear or
	# a logout ends it on purpose; a hangup (its zellij going) is "other".
	end_reason=$o_end
	[ "$event" = SessionEnd ] && end_reason=$end_new
	[ "$state" = needs-you ] || waiting="" pending=""
	if [ "$state" != "$o_state" ]; then
		case $state in needs-you) rc=10 ;; done) rc=11 ;; esac
	fi
	since=$o_since
	if [ "$state" != "$o_state" ] || [ -z "$since" ]; then
		since=$now seen=false
	else
		seen=$o_seen
	fi
	case $event in Stop | StopFailure) last=${last_new:-$o_last} ;; *) last=$o_last ;; esac
	[ -n "$prompt" ] || prompt=$o_prompt
	[ -n "$ev_file" ] && file=$ev_file || file=$o_file
	title=${title_new:-$o_title}
	prompt_id=${prompt_id:-$o_promptid}
	transcript=${transcript:-$o_transcript}

	# Worktrunk branch markers, like its own Claude Code plugin sets for the
	# session's start directory, but on the worktree the agent is really in.
	# weaver's glyph for the state, not Worktrunk's emoji.
	if [ "$state" = ended ]; then
		marker=''
	else
		state_cell "$state"
		marker=$GCELL
	fi
	mark_dir=""
	if [ "${WEAVER_WT_MARKERS:-1}" != 0 ] && [ -n "$marker" ] && [ "$root" != "$proj" ] && [ -e "$root/.git" ]; then
		mark_dir=$root
	fi
	marked=$mark_dir

	write_state

	# The activity log, and the prompt the turn's snapshots are labelled with.
	if [ -n "$sid" ]; then
		LOGF="$LOG_DIR/$sid.jsonl"
		[ -d "$LOG_DIR" ] || mkdir -p "$LOG_DIR"
	fi
	if [ -n "$snap_prev$snap_end" ] && [ -f "$STATE_DIR/${SKEY}_$pane.prompt" ]; then
		IFS= read -r turn_prompt <"$STATE_DIR/${SKEY}_$pane.prompt"
		prev_prompt=$turn_prompt
	fi
	[ -n "$snap_start" ] && printf '%s\n' "$prompt_long" >"$STATE_DIR/${SKEY}_$pane.prompt"
	hook_log

	if [ "$mode" = async ] && [ "$event" = PostToolUse ] && case $tool in Bash | mcp__*) true ;; *) false ;; esac then
		# Following a Bash or MCP edit needs git: this process runs in the
		# background anyway, so do it here.
		load_rest
		if ! follow_bash_edits; then
			[ "$tool" = Bash ] && json_str "$cmd" && log_line bash ",\"cmd\":$J"
			[ -n "$NV" ] && nvim_event checktime ""
		fi
	fi
	# The background work, only when there is some: a fork is cheap, but the
	# work it starts (a zellij call or two) is not.
	if [ "$state" != "$o_state" ] || [ "$root" != "$o_root" ] || [ -n "$ev_file$snap_prev$snap_start$snap_end$first_touch" ] ||
		[ "$title" != "$o_title" ] || [ "$marker" != "$o_marker" ] || [ "$mark_dir" != "$o_marked" ] ||
		[ "$event" = SessionStart ] || [ "$event" = UserPromptSubmit ]; then
		if [ -n "${WEAVER_DEBUG:-}" ]; then
			(load_rest && hook_bg) </dev/null >/dev/null 2>>"$STATE_DIR/hook.log" &
		else
			(load_rest && hook_bg) </dev/null >/dev/null 2>&1 &
		fi
	fi
	return $rc
}

# The activity log lines for this event (see docs/design.md).
hook_log() {
	local jr
	[ -n "$LOGF" ] || return 0
	case $event in
	SessionStart) json_str "$source" && log_line session ",\"source\":$J" ;;
	UserPromptSubmit)
		if [ -n "$snap_start" ]; then
			json_str "$prompt_id" && jr=$J
			json_str "$prompt_long" && log_line prompt ",\"text\":$J,\"prompt_id\":$jr"
		fi
		;;
	PostToolUse)
		if [ -n "$ev_file" ]; then
			json_str "$root" && jr=$J
			json_str "$ev_file" && out=",\"file\":$J,\"root\":$jr"
			json_str "$tool" && out="$out,\"tool\":$J"
			[ -n "$aid" ] && json_str "$aid" && out="$out,\"agent_id\":$J"
			log_line edit "$out"
		fi
		;;
	PostToolUseFailure) [ -n "$interrupt" ] && json_str "$tool" && log_line interrupt ",\"tool\":$J" ;;
	SubagentStart | SubagentStop)
		json_str "$aid" && out=",\"agent_id\":$J"
		json_str "$atype" && out="$out,\"agent_type\":$J"
		if [ "$event" = SubagentStart ]; then out="$out,\"phase\":\"start\""; else out="$out,\"phase\":\"stop\""; fi
		log_line subagent "$out"
		;;
	Stop) json_str "$last_new" && log_line stop ",\"last\":$J" ;;
	StopFailure) json_str "$err" && log_line error ",\"error\":$J" ;;
	SessionEnd) log_line end ;;
	esac
	if [ $moved = 1 ] && [ "$root" != "$o_root" ]; then
		json_str "$root" && jr=$J
		json_str "$cwd" && log_line cwd ",\"cwd\":$J,\"root\":$jr"
	fi
	if [ "$state" != "$o_state" ]; then
		[ "$state" = needs-you ] && json_str "$waiting" && log_line needs-you ",\"waiting\":$J"
		log_line state ",\"state\":\"$state\""
	fi
	return 0
}

# Write the state file from the hook's variables (and release the lock).
write_state() {
	case $pane in '' | *[!0-9]*) json_str "$pane" ;; *) J=$pane ;; esac
	out="{\"pane\":$J,\"agent\":\"$agent_kind\""
	out="$out,\"state\":\"$state\",\"ts\":${now:-0},\"since\":${since:-0}"
	[ "$seen" = true ] && out="$out,\"seen\":true" || out="$out,\"seen\":false"
	json_str "$sid" && out="$out,\"session_id\":$J"
	case $pid in '' | *[!0-9]*) ;; *) out="$out,\"pid\":$pid" ;; esac
	json_str "$proc_start" && out="$out,\"proc_start\":$J"
	json_str "$title" && out="$out,\"title\":$J"
	out="$out,\"turn\":${turn:-0},\"turn_ended\":${turn_ended:-0}"
	json_str "$prompt_id" && out="$out,\"prompt_id\":$J"
	json_str "$transcript" && out="$out,\"transcript\":$J"
	json_str "$cwd" && out="$out,\"cwd\":$J"
	json_str "$root" && out="$out,\"root\":$J"
	json_str "$start" && out="$out,\"start_cwd\":$J"
	json_str "$proj" && out="$out,\"project_root\":$J"
	json_str "$file" && out="$out,\"file\":$J"
	json_str "$prompt" && out="$out,\"prompt\":$J"
	json_str "$waiting" && out="$out,\"waiting\":$J"
	json_str "$pending" && out="$out,\"pending\":$J"
	json_str "$last" && out="$out,\"last_message\":$J"
	json_str "$marked" && out="$out,\"marked_root\":$J"
	json_str "$marker" && out="$out,\"marker\":$J"
	case $bg in '' | *[!0-9]*) bg=0 ;; esac
	json_str "$bgdesc" && out="$out,\"background\":$bg,\"background_tasks\":$J"
	out="$out,\"nvim_pane\":${NV:-null}"
	[ -n "$end_reason" ] && json_str "$end_reason" && out="$out,\"end_reason\":$J"
	[ -n "$sid" ] && json_str "$LOG_DIR/$sid.jsonl" && out="$out,\"log\":$J"
	out="$out,\"subagents\":${subs_json:-[]},\"tasks\":${tasks_json:-[]}"
	local IFS=$RS r rl=""
	set -f
	for r in $turn_roots; do
		json_str "$r" && rl="$rl${rl:+,}$J"
	done
	set +f
	out="$out,\"turn_roots\":[$rl],\"files\":${files_json:-[]}}"
	if printf '%s\n' "$out" >|"$LOCK"; then commit_lock; else drop_lock; fi
}

# ---------------------------------------------------------------- other agents

# `weaver event` takes one event of any agent as normalized JSON (see
# docs/design.md, Events) and turns it into the Claude Code hook input the
# state machine above understands. Adapters (`weaver adapt codex`) translate
# an agent's own hook input into it.
JQ_EVENT='
def s: tostring;
{ session_id: (.session // "" | s), transcript_path: (.transcript // "" | s), cwd: (.cwd // "" | s),
  prompt_id: (.prompt_id // "" | s), session_title: (.title // "" | s) }
+ (if .event == "session_start" then {hook_event_name: "SessionStart", source: (.source // "startup")}
   elif .event == "compact" then {hook_event_name: "SessionStart", source: "compact"}
   elif .event == "prompt" then {hook_event_name: "UserPromptSubmit", prompt: (.prompt // "" | s),
     source: (if .user == false then "system" else "user" end)}
   elif .event == "needs_you" then {hook_event_name: "Notification", notification_type: "permission_prompt",
     message: (.waiting // "" | s)}
   elif .event == "answered" then {hook_event_name: "Notification", notification_type: "elicitation_response", message: ""}
   elif .event == "tool_done" then
     if (.file // "") != "" then {hook_event_name: "PostToolUse", tool_name: "Edit", tool_input: {file_path: (.file | s)}}
     else {hook_event_name: "PostToolUse", tool_name: "Bash",
       tool_input: {command: ((.command // .tool // "") | s) + " " + ((.paths // []) | map(s) | join(" "))}} end
   elif .event == "tool_failed" then {hook_event_name: "PostToolUseFailure", tool_name: (.tool // "" | s), tool_input: {},
     error: (.error // "" | s)}
   elif .event == "interrupt" then {hook_event_name: "PostToolUseFailure", tool_name: (.tool // "" | s), tool_input: {},
     is_interrupt: true}
   elif .event == "stop" then {hook_event_name: "Stop", last_assistant_message: (.message // "" | s)}
   elif .event == "error" then {hook_event_name: "StopFailure", error: (.error // "" | s)}
   elif .event == "session_end" then {hook_event_name: "SessionEnd"}
   elif .event == "subagent_start" then {hook_event_name: "SubagentStart", agent_id: (.subagent // "" | s),
     agent_type: (.subagent_type // "" | s)}
   elif .event == "subagent_stop" then {hook_event_name: "SubagentStop", agent_id: (.subagent // "" | s),
     agent_type: (.subagent_type // "" | s)}
   else {} end)'

# Codex (0.162+) hook input, as normalized events. Its hooks mirror Claude
# Code s, without Notification; tool names differ, so any tool may have
# changed files: edits are found the way Bash edits are.
JQ_CODEX='
def s: tostring;
def patch_files: [(.tool_input | .. | strings) | scan("\\*\\*\\* (?:Update|Add) File: ([^\n]+)") | .[0]];
{agent: "codex", session: (.session_id // "" | s), cwd: (.cwd // "" | s), transcript: (.transcript_path // ""),
 prompt_id: (.turn_id // "")}
+ (if .hook_event_name == "SessionStart" then {event: "session_start", source: (.source // "startup")}
   elif .hook_event_name == "UserPromptSubmit" then {event: "prompt", prompt: (.prompt // "")}
   elif .hook_event_name == "PermissionRequest" then {event: "needs_you",
     waiting: ((.tool_name // "") + ": " + ((.tool_input | objects | .command // .cmd // .file_path // .path) // ""
       | if type == "array" then map(s) | join(" ") else s end))}
   elif .hook_event_name == "PostToolUse" then
     ((.tool_input | objects | .file_path // .path // null) // (patch_files | .[0]) // "") as $f
     | {event: "tool_done", tool: (.tool_name // ""),
        file: (if ($f | s | startswith("/")) then $f elif $f != "" then (.cwd // "") + "/" + $f else "" end),
        command: ((.tool_input | objects | .command // .cmd) // "" | if type == "array" then join(" ") else s end)}
   elif .hook_event_name == "Interrupt" then {event: "interrupt"}
   elif .hook_event_name == "Stop" then {event: "stop", message: (.last_assistant_message // "")}
   elif .hook_event_name == "SessionEnd" then {event: "session_end"}
   elif .hook_event_name == "SubagentStart" then {event: "subagent_start", subagent: (.agent_id // ""), subagent_type: (.agent_type // "")}
   elif .hook_event_name == "SubagentStop" then {event: "subagent_stop", subagent: (.agent_id // ""), subagent_type: (.agent_type // "")}
   elif .hook_event_name == "PreCompact" or .hook_event_name == "PostCompact" then {event: "compact"}
   else {event: "none"} end)'

# weaver event [--bell]: one normalized event on stdin. The agent is the pane
# ZELLIJ_PANE_ID names (or "pane"). With --bell, a change to needs-you or
# done rings the terminal bell on /dev/tty, for agents that cannot ask their
# The meta fields of a normalized event (agent, pid, pane), US-separated.
JQ_META='[.agent // "", .pid // "", .pane // ""] | map(tostring | gsub("[\u0000-\u001f]+"; "")) | join("\u001f")'

# own terminal to (zellij marks the tab).
cmd_event() {
	local adapter="" bell=0 meta json agent pid pane mode=sync rc ev
	while [ $# -gt 0 ]; do
		case $1 in
		--bell) bell=1 ;;
		--adapter) adapter=$2 && shift ;;
		esac
		shift
	done
	[ -t 0 ] && die "usage: weaver event [--bell] < event.json"
	case $adapter in
	'') meta=$(jq -rc '('"$JQ_META"'), ('"$JQ_EVENT"')') ;;
	codex) meta=$(jq -rc '('"$JQ_CODEX"') | ('"$JQ_META"'), ('"$JQ_EVENT"')') ;;
	*) die "unknown adapter: $adapter" ;;
	esac || exit 0
	IFS=$NL read -r -d '' meta json <<<"$meta"
	IFS=$US read -r agent pid pane <<<"$meta"
	# An agent's name goes into the state file and nvim's events as it is.
	case $agent in [a-z]*) ;; *) exit 0 ;; esac
	case $agent in *[!a-z0-9_-]*) exit 0 ;; esac
	# A pane is digits: tmux's %3 and zellij's terminal_3 are pane 3.
	pane=${pane#terminal_} pane=${pane#%}
	case $pane in *[!0-9]*) pane="" ;; esac
	case $pid in *[!0-9]*) pid="" ;; esac
	pane=${pane:-${MY_PANE:-}}
	[ -n "$pane" ] && [ -n "$SESSION" ] && [ -n "$agent" ] || exit 0
	case $json in *'"hook_event_name"'*) ;; *) exit 0 ;; esac
	case $json in *'"PostToolUse'* | *'"Subagent'*) mode=async ;; esac
	pid=${pid:-${WEAVER_AGENT_PID:-}}
	# The agent process, once per session: the nearest ancestor that is not a
	# shell (an agent may run its hooks through one).
	if [ -z "$pid" ] && [ -n "$adapter" ]; then
		case $json in *'"SessionStart"'*) agent_ancestor && pid=$ANCESTOR ;; esac
	fi
	(printf '%s' "$json" | MY_PANE=$pane WEAVER_AGENT=$agent WEAVER_AGENT_PID=$pid hook_run "$mode") >/dev/null 2>&1
	rc=$?
	if [ $bell = 1 ]; then
		case ${WEAVER_BELL:-1}:$rc in
		1:10 | 1:11 | needs-you:10) { printf '\a' >/dev/tty; } 2>/dev/null ;;
		esac
	fi
	exit 0
}

# The nearest ancestor of this process that is not a shell, into ANCESTOR.
agent_ancestor() {
	local p=$PPID i comm
	ANCESTOR=""
	for i in 1 2 3 4; do
		comm=$(ps -o comm= -p "$p" 2>/dev/null) || return 1
		case ${comm##*/} in
		sh | bash | zsh | dash | fish | -sh | -bash | -zsh | -fish | env) p=$(ps -o ppid= -p "$p" 2>/dev/null) && p=${p// /} ;;
		*)
			ANCESTOR=$p
			return 0
			;;
		esac
	done
	return 1
}

# weaver adapt AGENT: an agent's own hook input (stdin) into weaver.
cmd_adapt() {
	case ${1:-} in
	codex)
		shift
		cmd_event --adapter codex "$@"
		;;
	*) die "usage: weaver adapt codex [--bell]" ;;
	esac
}

# ---------------------------------------------------------------- dispatch

if [ -z "${WEAVER_SOURCED:-}" ] && [ "${1:-}" = hook ]; then
	shift
	cmd_hook "$@"
fi
if [ -z "${WEAVER_SOURCED:-}" ]; then
	case ${1:-} in
	event) shift && cmd_event "$@" ;;
	adapt) shift && cmd_adapt "$@" ;;
	esac
fi

# ---------------------------------------------------------------- the rest

WEAVER_REST=1

# This session's per-pane files with extension $1, into the array FOUND. Only
# <session>_<digits>.$1 counts, so session "a" never claims session "a_b"'s files.
session_files() {
	local f p
	FOUND=()
	for f in "$STATE_DIR/${SKEY}"_*."$1"; do
		p=${f#"$STATE_DIR/${SKEY}_"}
		p=${p%."$1"}
		case $p in '' | *[!0-9]*) continue ;; esac
		FOUND[${#FOUND[@]}]=$f
	done
}

# Directory holding the real script, following symlinks without GNU readlink -f.
script_dir() {
	local p=$SELF d
	while [ -L "$p" ]; do
		d=$(cd -P "${p%/*}" && pwd)
		p=$(readlink "$p")
		case $p in /*) ;; *) p="$d/$p" ;; esac
	done
	cd -P "${p%/*}" && pwd
}

# bounded OUT CMD... runs CMD with stdout to OUT and stdin/stderr on /dev/null,
# killed after 2s so a busy nvim or zellij can never block the caller. Returns
# CMD's status, or 142 if it was killed. (A killed nvim client exits 1, so its
# own status can't tell us; the killer reports firing with status 3.)
bounded() {
	local out=$1 pid killer rc
	shift
	"$@" </dev/null >"$out" 2>/dev/null &
	pid=$!
	(
		trap 'kill $s 2>/dev/null; exit 0' TERM
		sleep 2 &
		s=$!
		wait $s
		trap '' TERM
		kill "$pid"
		exit 3
	) </dev/null >/dev/null 2>&1 &
	killer=$!
	wait "$pid" 2>/dev/null
	rc=$?
	kill "$killer" 2>/dev/null
	wait "$killer" 2>/dev/null
	[ $? = 3 ] && return 142
	return $rc
}

toplevel() { git -C "$1" rev-parse --show-toplevel 2>/dev/null; }

# All panes as a JSON array, into PANES. Retried: zellij's list-panes has once
# been seen returning output that was not JSON (tmux's is jq's own).
list_panes() {
	local i
	for i in 1 2 3; do
		if [ "$MUX" = tmux ]; then
			PANES=$(mux_panes) && [ -n "$PANES" ] && return 0
		else
			PANES=$(mux_panes) &&
				printf '%s' "$PANES" | jq -e 'type == "array"' >/dev/null 2>&1 && return 0
		fi
		sleep 0.1
	done
	PANES=""
	return 1
}

# The pane you were on when you pressed the key that opened this floating
# weaver pane, into FOCUSED. zellij reports is_focused per client, and
# `focus-pane-id` from the command line leaves phantom focus behind, so ask
# zellij instead: hide the floating panes and see where your client lands
# (this pane keeps running; it closes when weaver exits). Outside a floating
# pane, the focused tiled pane of our own tab.
focused_pane() {
	local me=${MY_PANE:-} id cur floats
	FOCUSED=""
	# tmux: a popup or run-shell is not a pane, so the session's active pane
	# is the one you were on.
	if [ "$MUX" = tmux ]; then
		cur=$(tm display-message -p -t "=$SESSION:" '#{pane_id}' 2>/dev/null)
		cur=${cur#%}
		[ "$cur" != "$me" ] && FOCUSED=$cur
		return 0
	fi
	if [ -n "$me" ] && printf '%s' "$PANES" | jq -e --arg me "$me" \
		'any(.[]; (.is_plugin | not) and (.id | tostring) == $me and .is_floating)' >/dev/null 2>&1; then
		floats=" $(printf '%s' "$PANES" | jq -r '[.[] | select((.is_plugin | not) and .is_floating) | .id] | join(" ")') "
		id=$(client_of "$me")
		cur=$(client_pane "$id")
		# On a floating pane (this one, or another weaver press's): hide them.
		case $floats in *" $cur "*)
			zellij action hide-floating-panes >/dev/null 2>&1
			cur=$(client_pane "$id")
			;;
		esac
		case $cur in '' | *[!0-9]*) ;; *)
			case $floats in *" $cur "*) ;; *)
				FOCUSED=$cur
				return 0
				;;
			esac
			;;
		esac
	fi
	FOCUSED=$(printf '%s' "$PANES" | jq -r --arg me "$me" '
		map(select(.is_plugin | not)) as $t
		| ($t | map(select((.id | tostring) == $me)) | .[0].tab_id) as $tab
		| $t | map(select(.tab_id == $tab and .is_focused and (.is_floating | not)
			and (.id | tostring) != $me)) | .[0].id // empty')
}

# The client on pane $1 (empty: none), and the pane client $1 is on (empty:
# the first client's).
client_of() {
	zellij action list-clients 2>/dev/null | awk -v p="terminal_$1" 'NR > 1 && $2 == p { print $1; exit }'
}
client_pane() {
	zellij action list-clients 2>/dev/null |
		awk -v id="$1" 'NR > 1 && (id == "" || $1 == id) { sub("terminal_", "", $2); print $2; exit }'
}

# Move your focus to pane PANE (in tab TAB, if given). zellij 0.45's
# `focus-pane-id` from the command line does not move a client between panes of
# a tab, but going to a tab, hiding the floating panes and `focus-next-pane`
# do: so step until the client this runs for (the one on our own floating
# pane, else the first) is on PANE. A few zellij calls per pane in the tab.
focus_pane() {
	local pane=$1 tab=${2:-} me=${MY_PANE:-} id cur i n=8 floats=""
	if [ "$MUX" = tmux ]; then
		tm select-window -t "%$pane" \; select-pane -t "%$pane" >/dev/null 2>&1
		return
	fi
	id=$(client_of "$me")
	[ -n "$tab" ] && zellij action go-to-tab-by-id "$tab" >/dev/null 2>&1
	if list_panes; then
		n=$(printf '%s' "$PANES" | jq -r --arg p "$pane" '
			(map(select((.is_plugin | not) and (.id | tostring) == $p)) | .[0].tab_id) as $t
			| [.[] | select((.is_plugin | not) and .tab_id == $t)] | length + 2')
		floats=" $(printf '%s' "$PANES" | jq -r '[.[] | select((.is_plugin | not) and .is_floating) | .id] | join(" ")') "
	fi
	for ((i = 0; i < n; i++)); do
		cur=$(client_pane "$id")
		[ "$cur" = "$pane" ] && return 0
		case $floats in
		*" $cur "*) zellij action hide-floating-panes >/dev/null 2>&1 ;;
		*) zellij action focus-next-pane >/dev/null 2>&1 ;;
		esac
	done
	return 1
}

# The tab pane $1 is in, its size (zellij's viewport: without the status
# bars) and whether the pane floats, into VIEW_COLS, VIEW_ROWS and VIEW_FLOAT
# (1, or empty). From $PANES when it is set (else list-panes) and list-tabs;
# WEAVER_VIEW ("COLS ROWS FLOAT") stands in for both, for a process that
# already asked. Returns 1 when zellij does not say.
pane_view() {
	local p=${1#terminal_} info tab="" fl=""
	VIEW_COLS="" VIEW_ROWS="" VIEW_FLOAT=""
	if [ -n "${WEAVER_VIEW:-}" ]; then
		read -r VIEW_COLS VIEW_ROWS VIEW_FLOAT <<<"$WEAVER_VIEW"
	elif [ "$MUX" = tmux ]; then
		# Our own pane or popup, whose size is the terminal's.
		info=$({ stty size </dev/tty; } 2>/dev/null)
		VIEW_ROWS=${info% *} VIEW_COLS=${info#* }
	else
		[ -n "$p" ] || return 1
		[ -n "${PANES:-}" ] || list_panes || return 1
		info=$(printf '%s' "$PANES" | jq -r --arg p "$p" \
			'map(select((.is_plugin | not) and (.id | tostring) == $p)) | .[0] // empty | "\(.tab_id) \(.is_floating)"' 2>/dev/null)
		read -r tab fl <<<"$info"
		case $tab in '' | *[!0-9]*) return 1 ;; esac
		[ "$fl" = true ] && VIEW_FLOAT=1
		info=$(zellij action list-tabs -j 2>/dev/null | jq -r --argjson t "$tab" \
			'.[] | select(.tab_id == $t) | "\(.viewport_columns) \(.viewport_rows)"' 2>/dev/null)
		read -r VIEW_COLS VIEW_ROWS <<<"$info"
	fi
	case $VIEW_COLS$VIEW_ROWS in '' | *[!0-9]*)
		VIEW_COLS="" VIEW_ROWS=""
		return 1
		;;
	esac
	return 0
}

# Fit the floating pane this runs in ($MY_PANE) to ROWS x COLS cells:
# at most 85% of the tab's rows and 90% of its columns (at least 3 x 20),
# centred, borderless (whatever draws in it draws its own border). Into
# FIT_ROWS and FIT_COLS, the size it took. Does nothing in a pane that does
# not float, or when zellij does not answer.
float_fit() {
	local rows=$1 cols=$2 p=${MY_PANE:-} max
	FIT_ROWS="" FIT_COLS=""
	case $rows$cols in '' | *[!0-9]*) return 0 ;; esac
	[ -n "$p" ] && pane_view "$p" && [ -n "$VIEW_FLOAT" ] || return 0
	max=$((VIEW_ROWS * 85 / 100))
	[ "$rows" -gt "$max" ] && rows=$max
	[ "$rows" -lt 3 ] && rows=3
	max=$((VIEW_COLS * 90 / 100))
	[ "$cols" -gt "$max" ] && cols=$max
	[ "$cols" -lt 20 ] && cols=20
	zellij action change-floating-pane-coordinates -p "terminal_$p" -b true \
		-x $(((VIEW_COLS - cols) / 2)) -y $(((VIEW_ROWS - rows) / 2)) --width "$cols" --height "$rows" \
		</dev/null >/dev/null 2>&1 || return 0
	FIT_ROWS=$rows FIT_COLS=$cols
	return 0
}

# Set or clear a Worktrunk branch marker in DIR, in the background.
wt_marker() {
	command -v wt >/dev/null 2>&1 || return 0
	if [ -n "$2" ]; then
		wt -C "$1" config state marker set "$2" </dev/null >/dev/null 2>&1
	else
		wt -C "$1" config state marker clear </dev/null >/dev/null 2>&1
	fi
}

# Everything the hook does besides writing the state, in a background fork so
# the agent never waits on nvim, zellij, git or Worktrunk.
hook_bg() {
	local out
	# nvim first: following is what you see.
	if [ -n "$NV" ]; then
		if [ -n "$ev_file" ]; then
			nvim_edit_event edit "$root" "$ev_file" "$tool"
		elif [ "$root" != "$o_root" ]; then
			json_str "$root" && nvim_event root ",\"root\":$J" "$root" ""
		fi
		# The bar shows the state, turn, prompt and title: any change to them.
		if [ "$state" != "$o_state" ] || [ "$turn" != "${o_turn:-0}" ] || [ "$prompt" != "$o_prompt" ] ||
			[ "$title" != "$o_title" ]; then
			nvim_state_event
		fi
	fi
	# tmux: the window of an agent that has just finished is flagged, for
	# config/tmux.conf's pane-focus-in hook to mark it seen when you look.
	if [ "$MUX" = tmux ] && [ "$state" != "$o_state" ]; then
		if [ "$state" = done ]; then
			tm set-option -w -t "%$pane" @weaver-unseen 1 >/dev/null 2>&1
		elif [ "$o_state" = done ]; then
			tm set-option -w -u -t "%$pane" @weaver-unseen >/dev/null 2>&1
		fi
	fi
	if [ "$state" != "$o_state" ] || [ "$event" = UserPromptSubmit ] || [ "$event" = SessionStart ] ||
		[ "$title" != "$o_title" ] || [ "$root" != "$o_root" ]; then
		# A thread's label is its title (else its task or prompt) and branch.
		if [ "$event" = UserPromptSubmit ] || [ "$event" = SessionStart ] || [ "$title" != "$o_title" ] ||
			[ "$root" != "$o_root" ]; then
			push_status labels
		else
			push_status
		fi
	fi
	if [ -n "$NV" ] && [ "$root" != "$o_root" ] && same_root; then
		bounded /dev/null mux_rename_pane "$NV" "nvim: ${root##*/}"
	fi
	if [ "$mark_dir" != "$o_marked" ] || { [ -n "$mark_dir" ] && [ "$marker" != "$o_marker" ]; }; then
		[ -n "$o_marked" ] && [ "$o_marked" != "$mark_dir" ] && wt_marker "$o_marked" ""
		[ -n "$mark_dir" ] && wt_marker "$mark_dir" "$marker"
	fi
	[ "$event" = SessionStart ] && gc_states quiet
	hook_snapshots
}

# Is $root still the agent's root? A later hook may have moved it on while
# this one waited in the background.
same_root() {
	local line="" re='"root":"([^"]*)"'
	{ IFS= read -r line <"$STATE_DIR/${SKEY}_$pane.json"; } 2>/dev/null
	[[ $line =~ $re ]] || return 0
	[ "${BASH_REMATCH[1]}" = "$root" ]
}

# Mark an agent seen (you looked at it), so a "done" no longer stands out.
mark_seen() {
	state_file "$1"
	[ -f "$SF" ] || return 0
	lock
	if jq -c '.seen = true' "$SF" >|"$LOCK" 2>/dev/null; then commit_lock; else drop_lock; fi
}

# nvim_event EV MEMBERS [ROOT FILE] sends event EV (see docs/design.md) to the
# agent's nvim: WeaverEvent, or AgentFollow / AgentChecktime on a weaver.lua
# that predates it. Returns 0 on success, 128+ when nvim did not answer in time
# (stuck at a prompt, or busy), and anything else when nothing is listening.
#
# With NOW set (the hook), a timeout is remembered: calls are skipped for 15s
# so a stuck nvim costs one 2s wait per 15s, not one on every event.
nvim_event() {
	local ev=$1 extra=$2 r=${3:-} f=${4:-} stalled t=0 json compat rc jp js
	sock_path "$pane"
	[ -S "$SOCK" ] || return 1
	stalled="$SOCK.stalled"
	if [ -n "${NOW:-}" ] && [ -f "$stalled" ]; then
		read -r t <"$stalled"
		case $t in '' | *[!0-9]*) t=0 ;; esac
		[ $((NOW - t)) -lt 15 ] && return 128
	fi
	json_str "$pane" && jp=$J
	json_str "${sid:-}" && js=$J
	json="{\"ev\":\"$ev\",\"seq\":${seq:-0},\"pane\":$jp,\"agent\":\"${agent_kind:-claude}\",\"sid\":$js"
	json="$json,\"turn\":${turn:-0},\"state\":\"${state:-}\"$extra}"
	case $ev in
	edit | root | focus) compat="v:lua.AgentFollow('${r//\'/\'\'}','${f//\'/\'\'}')" ;;
	checktime) compat="v:lua.AgentChecktime()" ;;
	*) compat=0 ;;
	esac
	# The arguments are Vimscript expressions: in a single-quoted Vim string a
	# quote is doubled and a backslash is literal.
	bounded /dev/null nvim --server "$SOCK" --remote-expr \
		"luaeval('_G.WeaverEvent ~= nil') ? v:lua.WeaverEvent('${json//\'/\'\'}') : $compat"
	rc=$?
	if [ $rc -ge 128 ]; then
		[ -n "${NOW:-}" ] && printf '%s\n' "$NOW" >"$stalled"
	elif [ -f "$stalled" ]; then
		rm -f "$stalled"
	fi
	return $rc
}

# nvim_edit_event EV ROOT FILE TOOL: an edit (or, from `weaver edit`, a focus)
# at FILE in ROOT.
nvim_edit_event() {
	local ev=$1 r=$2 f=$3 x
	json_str "$r" && x=",\"root\":$J"
	json_str "$f" && x="$x,\"file\":$J"
	json_str "${4:-}" && x="$x,\"tool\":$J"
	[ -n "${aid:-}" ] && json_str "$aid" && x="$x,\"agent_id\":$J"
	nvim_event "$ev" "$x" "$r" "$f"
}

nvim_state_event() {
	local x=""
	json_str "${prompt:-}" && x=",\"prompt\":$J"
	json_str "${waiting:-}" && x="$x,\"waiting\":$J"
	json_str "${title:-}" && x="$x,\"title\":$J"
	nvim_event state "$x"
}

# A Bash command or MCP tool that changed files (sed -i, a heredoc, a
# formatter, an MCP write) counts as an edit: in the repos the command names,
# the one it ran in and the agent's root, find the files git sees as changed
# since the previous such call, and follow the newest. Returns 1 when nothing
# changed. GIT_OPTIONAL_LOCKS=0 keeps git status off the index lock, so the
# agent's own git commands never collide.
follow_bash_edits() {
	local stamp="$STATE_DIR/${SKEY}_$pane.bash" new p d r e roots="" n=0 newest="" IFS x
	local -a changed
	new="$stamp.$$"
	: >"$new" || return 1
	if [ ! -f "$stamp" ]; then
		mv -f "$new" "$stamp"
		return 1
	fi
	IFS=$RS
	set -f
	for p in "$cwd" "$root" $paths; do
		case $p in /*) ;; *) continue ;; esac
		d=$p
		while [ -n "$d" ] && [ ! -d "$d" ]; do d=${d%/*}; done
		[ -n "$d" ] || continue
		find_top "$d" || continue
		r=$TOP
		case "$NL$roots" in *"$NL$r$NL"*) continue ;; esac
		roots="$roots$r$NL"
		n=$((n + 1))
		[ $n -ge 4 ] && break
	done
	IFS=$NL
	for r in $roots; do
		while IFS= read -r -d '' e; do
			# A rename is followed by its original path.
			case ${e:0:2} in *R* | *C*) IFS= read -r -d '' _ ;; esac
			case ${e:0:2} in *D*) continue ;; esac
			changed[${#changed[@]}]="$r/${e:3}"
		done < <(GIT_OPTIONAL_LOCKS=0 git -C "$r" status --porcelain -z -uall 2>/dev/null)
	done
	set +f
	IFS=$' \t\n'
	if [ ${#changed[@]} -gt 0 ]; then
		newest=$(find "${changed[@]}" -prune -type f -newer "$stamp" -exec ls -1t {} + 2>/dev/null | head -n 1)
	fi
	mv -f "$new" "$stamp"
	[ -n "$newest" ] && file_top "$newest" || return 1
	r=$TOP

	state_file "$pane"
	if [ -f "$SF" ]; then
		lock
		if jq -c --arg r "$r" --arg f "$newest" --argjson t "${turn:-0}" \
			'.root = $r | .file = $f | .files = (((.files // []) - [$f]) + [$f] | .[-200:])
			| if $t > 0 and ((.turn_roots // []) | index([$r]) | not) then .turn_roots += [$r] else . end' \
			"$SF" >|"$LOCK"; then
			commit_lock
		else
			drop_lock
		fi
	fi
	# A root first touched this turn starts its chain from HEAD.
	case "$RS$turn_roots$RS" in
	*"$RS$r$RS"*) ;;
	*) [ "${turn:-0}" -gt 0 ] && [ -n "$sid" ] && (
		SNAP_SID=$sid SNAP_PANE=$pane SNAP_PROMPT="" SNAP_PROMPT_ID=$prompt_id SNAP_TRANSCRIPT=$transcript
		snap_roots base "$turn" "$r"
	) ;;
	esac
	json_str "$newest" && x=",\"file\":$J"
	if [ "$tool" = Bash ]; then
		json_str "$cmd" && log_line bash ",\"cmd\":$J$x"
	else
		json_str "$tool" && x="$x,\"tool\":$J"
		json_str "$r" && log_line edit "$x,\"root\":$J"
	fi
	[ -n "$NV" ] || return 0
	nvim_edit_event edit "$r" "$newest" "$tool"
	if [ "$r" != "$o_root" ]; then
		bounded /dev/null mux_rename_pane "$NV" "nvim: ${r##*/}"
	fi
	return 0
}

# ---------------------------------------------------------------- snapshots

# snapshot DIR REF POINT TURN KEY commits the worktree holding DIR onto REF
# with CodeCompanion's recipe (docs/design.md): a private index (named by KEY)
# so your staging area is never touched, a tree, a commit on the tip, and a
# compare-and-swap update of REF. Point "base" commits HEAD's tree as the
# start of a chain instead of reading the worktree. An "end" on top of an end
# of the same turn replaces it (a turn that resumes after background work
# ends once). Sets SNAP_COMMIT, and SNAP_NEW=1 when it made a commit; returns
# 1 when DIR is not in a repo. Message fields come from SNAP_SID, SNAP_PANE,
# SNAP_PROMPT, SNAP_PROMPT_ID and SNAP_TRANSCRIPT.
snapshot() {
	local dir=$1 ref=$2 point=$3 n=$4 key=$5 top gd idx real tree tip="" parent="" body="" subject
	local lockd i=0 owner max big p msg label=$3
	local -a excl
	SNAP_COMMIT="" SNAP_NEW=""
	top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || return 1
	gd=$(git -C "$top" rev-parse --path-format=absolute --git-path weaver 2>/dev/null) || return 1
	mkdir -p "$gd" || return 1
	idx="$gd/index-$key"
	# One snapshot of a chain at a time; a lock whose owner died is removed.
	lockd="$idx.lock.d"
	until mkdir "$lockd" 2>/dev/null; do
		owner=""
		{ read -r owner <"$lockd/pid"; } 2>/dev/null
		if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
			rm -rf "$lockd"
			continue
		fi
		i=$((i + 1))
		[ $i -ge 600 ] && return 1
		sleep 0.1
	done
	printf '%s\n' "$$" >"$lockd/pid"

	tip=$(git -C "$top" rev-parse -q --verify "$ref^{commit}" 2>/dev/null)
	if [ "$point" = base ]; then
		label=start
		# Only a chain that does not exist yet gets a base.
		if [ -n "$tip" ] || ! tree=$(git -C "$top" rev-parse -q --verify 'HEAD^{tree}' 2>/dev/null); then
			SNAP_COMMIT=$tip
			rm -rf "$lockd"
			return 0
		fi
	else
		if [ ! -f "$idx" ]; then
			real=$(git -C "$top" rev-parse --path-format=absolute --git-path index 2>/dev/null)
			[ -f "$real" ] && cp "$real" "$idx" 2>/dev/null
		fi
		# Untracked files over WEAVER_SNAPSHOT_MAX_KB (5 MB) stay out: a
		# download or a build artefact must not bloat the object store.
		max=${WEAVER_SNAPSHOT_MAX_KB:-5120}
		big=$(cd "$top" && git ls-files -z -o --exclude-standard 2>/dev/null |
			xargs -0 sh -c 'find "$@" -prune -type f -size +'"$max"'k' sh 2>/dev/null)
		excl=()
		if [ -n "$big" ]; then
			while IFS= read -r p; do
				[ -n "$p" ] && excl[${#excl[@]}]=":(exclude,literal)${p#./}"
			done <<<"$big"
			# One that was small when an earlier snapshot took it: out of this one.
			printf '%s\n' "$big" | sed 's|^\./||' |
				GIT_INDEX_FILE=$idx git -C "$top" rm --cached -f -q --ignore-unmatch --pathspec-from-file=- >/dev/null 2>&1
		fi
		GIT_INDEX_FILE=$idx git -C "$top" add --all -- . ${excl[@]+"${excl[@]}"} >/dev/null 2>&1
		tree=$(GIT_INDEX_FILE=$idx git -C "$top" write-tree 2>/dev/null) || {
			rm -rf "$lockd"
			return 1
		}
	fi
	parent=$tip
	if [ -n "$tip" ] && [ "$point" = end ] &&
		git -C "$top" cat-file commit "$tip" 2>/dev/null | grep -qx "Weaver-Turn: $n" &&
		git -C "$top" cat-file commit "$tip" 2>/dev/null | grep -qx 'Weaver-Point: end'; then
		parent=$(git -C "$top" rev-parse -q --verify "$tip^" 2>/dev/null)
	fi
	if [ -n "$tip" ] && [ "$tree" = "$(git -C "$top" rev-parse "$tip^{tree}" 2>/dev/null)" ]; then
		SNAP_COMMIT=$tip
		rm -rf "$lockd"
		return 0
	fi

	subject="weaver: turn $n $label"
	[ "$point" = reviewed ] && subject="weaver: reviewed"
	if [ -n "${SNAP_PROMPT:-}" ] && [ "$point" != reviewed ]; then
		p=${SNAP_PROMPT:0:72}
		[ ${#SNAP_PROMPT} -gt 72 ] && p="${SNAP_PROMPT:0:71}…"
		subject="$subject: $p"
		body="${SNAP_PROMPT:0:2000}$NL$NL"
	fi
	msg="$subject$NL$NL$body"
	[ -n "${SNAP_SID:-}" ] && msg="${msg}Weaver-Session: $SNAP_SID$NL"
	[ "$point" = reviewed ] || msg="${msg}Weaver-Turn: $n$NL"
	msg="${msg}Weaver-Point: $label$NL"
	[ -n "${SNAP_PANE:-}" ] && msg="${msg}Weaver-Pane: $SNAP_PANE$NL"
	[ -n "${SNAP_PROMPT_ID:-}" ] && msg="${msg}Prompt-Id: $SNAP_PROMPT_ID$NL"
	[ -n "${SNAP_TRANSCRIPT:-}" ] && msg="${msg}Transcript: $SNAP_TRANSCRIPT$NL"
	SNAP_COMMIT=$(printf '%s' "$msg" | GIT_AUTHOR_NAME=weaver GIT_AUTHOR_EMAIL=weaver@localhost \
		GIT_COMMITTER_NAME=weaver GIT_COMMITTER_EMAIL=weaver@localhost \
		git -C "$top" commit-tree "$tree" ${parent:+-p "$parent"} 2>/dev/null) &&
		git -C "$top" update-ref -m "$subject" "$ref" "$SNAP_COMMIT" "$tip" 2>/dev/null &&
		SNAP_NEW=1
	[ -n "$SNAP_NEW" ] || SNAP_COMMIT=$tip
	rm -rf "$lockd"
	return 0
}

# snap_roots POINT TURN ROOTS: snapshot each root (RS-separated) onto the
# session's chain; log and tell nvim about each new commit.
snap_roots() {
	local point=$1 turn=$2 r x seen=$RS
	local -a roots
	local IFS=$RS
	set -f
	roots=($3)
	set +f
	IFS=$' \t\n'
	for r in ${roots[@]+"${roots[@]}"}; do
		[ -d "$r" ] || continue
		case $seen in *"$RS$r$RS"*) continue ;; esac
		seen="$seen$r$RS"
		snapshot "$r" "refs/worktree/weaver/sessions/$sid" "$point" "$turn" "$sid" || continue
		[ -n "$SNAP_NEW" ] || continue
		[ "$point" = base ] && point=start
		json_str "$r" && x=",\"root\":$J"
		x="$x,\"commit\":\"$SNAP_COMMIT\",\"point\":\"$point\""
		log_line snapshot "$x"
		[ -n "$NV" ] && nvim_event snapshot "$x,\"ref\":\"refs/worktree/weaver/sessions/$sid\""
	done
}

# The turn's snapshots, from the hook's background fork.
hook_snapshots() {
	[ "${WEAVER_SNAPSHOTS:-1}" != 0 ] && [ -n "$sid" ] || return 0
	local SNAP_SID=$sid SNAP_PANE=$pane SNAP_PROMPT SNAP_PROMPT_ID=$prompt_id SNAP_TRANSCRIPT=$transcript
	if [ -n "$snap_prev" ]; then
		SNAP_PROMPT=$prev_prompt SNAP_PROMPT_ID=$o_promptid
		snap_roots end "$snap_prev" "$o_turn_roots"
		SNAP_PROMPT_ID=$prompt_id
	fi
	if [ -n "$snap_start" ]; then
		# The agent's root, and the roots of its previous turn: changes made
		# there since are not this turn's.
		SNAP_PROMPT=$prompt_long
		snap_roots start "$turn" "$root$RS$o_turn_roots"
	fi
	if [ -n "$first_touch" ]; then
		SNAP_PROMPT=""
		snap_roots base "$turn" "$first_touch"
	fi
	if [ -n "$snap_end" ]; then
		SNAP_PROMPT=$turn_prompt
		snap_roots end "$turn" "$turn_roots${turn_roots:+$RS}$root"
	fi
	return 0
}

# weaver snapshot --reviewed [DIR]: mark the worktree holding DIR reviewed.
cmd_snapshot() {
	local dir=""
	while [ $# -gt 0 ]; do
		case $1 in
		--reviewed) ;;
		-*) die "usage: weaver snapshot --reviewed [dir]" ;;
		*) dir=$1 ;;
		esac
		shift
	done
	dir=${dir:-$PWD}
	git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1 || die "$dir is not in a git repository"
	snapshot "$dir" refs/worktree/weaver/reviewed reviewed 0 reviewed || die "cannot snapshot $dir"
	[ -n "$SNAP_COMMIT" ] || die "cannot snapshot $dir"
	printf '%s\n' "$SNAP_COMMIT"
}

# ---------------------------------------------------------------- nvim

cmd_nvim() {
	[ $# -ge 1 ] || die "usage: weaver nvim <agent-pane-id> [file]"
	local agent=${1#terminal_} file=${2:-} lua dir rc d i fresh=""
	need_session
	# The left pane of a new thread's tab: wait for the agent beside it to say
	# which pane it is in.
	if [ "$1" = --thread ]; then
		d="$THREADS_NEW/${SKEY}_${2:-}"
		agent="" file=""
		for ((i = 0; i < 100; i++)); do
			[ -f "$d/pane" ] && break
			sleep 0.1
		done
		{ read -r agent <"$d/pane"; } 2>/dev/null
		rm -rf "$d"
		case $agent in '' | *[!0-9]*)
			echo "weaver: the agent did not start; this nvim is not bound to it" >&2
			exec nvim
			;;
		esac
		# Its agent was just made: an nvim on its socket belongs to a
		# session of the same name that was closed (pane ids start again).
		fresh=1
	fi
	mkdir -p "$SOCK_DIR" || die "cannot create $SOCK_DIR"
	[ -O "$SOCK_DIR" ] || die "$SOCK_DIR is not owned by you"
	chmod 700 "$SOCK_DIR"
	sock_path "$agent"
	# Never take the socket of an nvim still serving this agent (answering, or
	# alive but busy): go to it instead, and let this pane close.
	if [ -z "$fresh" ] && [ -S "$SOCK" ]; then
		bounded /dev/null nvim --server "$SOCK" --remote-expr 1
		rc=$?
		if [ $rc = 0 ] || [ $rc -ge 128 ]; then
			read_nvim_pane "$agent"
			[ -n "$NV" ] && [ "$NV" != "${MY_PANE:-}" ] && focus_pane "$NV"
			exit 0
		fi
	fi
	rm -f "$SOCK" "$SOCK.stalled"

	state_file "$agent"
	nvim_file "$agent"
	if [ -n "${MY_PANE:-}" ]; then
		mkdir -p "$STATE_DIR"
		# exec keeps this pid for nvim.
		printf '%s\n%s\n' "$MY_PANE" "$$" >"$NVF.$$" && mv -f "$NVF.$$" "$NVF"
		if [ -f "$SF" ]; then
			lock
			if jq -c --arg nv "$MY_PANE" '.nvim_pane = ($nv | tonumber? // $nv)' "$SF" >|"$LOCK"; then
				commit_lock
			else
				drop_lock
			fi
		fi
	fi

	dir=$(script_dir)
	export WEAVER_PANE=$agent WEAVER_STATE=$SF WEAVER_BIN="$dir/weaver"
	lua="$dir/nvim/weaver.lua"
	# The ATTENTION dialog for a stale swap file would block this nvim and every
	# remote call: open the startup file read-only instead (weaver.lua reports
	# it and removes this autocmd).
	exec nvim --listen "$SOCK" \
		--cmd "augroup weaver_start | autocmd SwapExists * let v:swapchoice = 'o' | let g:weaver_swap = expand('<afile>') | augroup END" \
		-c "luafile ${lua// /\\ }" -- ${file:+"$file"}
}

# ---------------------------------------------------------------- edit

# Open a new pane running CMD... beside pane TARGET, then move it to the left.
# The new pane's id goes into NEWPANE.
open_left_of() {
	local target=$1 cwd=$2 name=$3
	shift 3
	# tmux splits the target's own window, whatever has the focus.
	if [ "$MUX" = tmux ]; then
		NEWPANE=$(tm split-window -h -b -l 80% -P -F '#{pane_id}' -t "%$target" -c "$cwd" "$@") ||
			die "tmux split-window failed"
		NEWPANE=${NEWPANE#%}
		mux_rename_pane "$NEWPANE" "$name"
		return 0
	fi
	# Its tab first: the new pane opens beside the focused one.
	focus_pane "$target" "$(printf '%s' "$PANES" | jq -r --arg p "$target" \
		'map(select((.is_plugin | not) and (.id | tostring) == $p)) | .[0].tab_id // empty')"
	NEWPANE=$(zellij action new-pane --direction right --close-on-exit --cwd "$cwd" --name "$name" -- "$@") ||
		die "zellij action new-pane failed"
	zellij action move-pane ${NEWPANE:+--pane-id "$NEWPANE"} left || true
	NEWPANE=${NEWPANE#terminal_}
}

# One `weaver edit` or `weaver next` per session at a time: each hides the
# floating panes to see where you are, and two at once would undo each
# other. A second Alt v waits, then finds the nvim the first opened; with
# "nowait" (Alt 1) a second press while the first is at work is dropped. A
# lock older than 10s was left by a killed process.
ui_lock() {
	local d="$STATE_DIR/$SKEY.ui" i=0 t now
	mkdir -p "$STATE_DIR"
	until mkdir "$d" 2>/dev/null; do
		t=0
		{ read -r t <"$d/at"; } 2>/dev/null
		now=$(date +%s)
		case $t in '' | *[!0-9]*) t=$now ;; esac
		if [ $((now - t)) -gt 10 ]; then
			rm -rf "$d"
			continue
		fi
		[ "${1:-}" = nowait ] && return 1
		i=$((i + 1))
		[ $i -ge 100 ] && break
		sleep 0.1
	done
	date +%s >"$d/at" 2>/dev/null
	UI_LOCK=$d
	trap 'rm -rf "$UI_LOCK"' EXIT
}

# One `weaver edit` per agent at a time, so pressing Alt v twice finds the
# nvim the first press is opening rather than open a second. A lock older
# than 5s was left by a killed process.
edit_lock() {
	local d="$STATE_DIR/${SKEY}_$1.opening" i=0 t now
	mkdir -p "$STATE_DIR"
	EDIT_LOCK=$d
	until mkdir "$d" 2>/dev/null; do
		t=0
		{ read -r t <"$d/at"; } 2>/dev/null
		now=$(date +%s)
		case $t in '' | *[!0-9]*) t=$now ;; esac
		if [ $((now - t)) -gt 5 ]; then
			rm -rf "$d"
			continue
		fi
		i=$((i + 1))
		[ $i -ge 60 ] && break
		sleep 0.1
	done
	date +%s >"$d/at" 2>/dev/null
}
edit_unlock() { rm -rf "$EDIT_LOCK"; }

cmd_edit() {
	local full=0 target="" agent="" info root file nv cwd f p d sid turn state kind i
	while [ $# -gt 0 ]; do
		case $1 in
		--full) full=1 ;;
		-*) die "usage: weaver edit [--full] [pane-id]" ;;
		*) target=${1#terminal_} target=${target#%} ;;
		esac
		shift
	done
	need_session
	ui_lock
	list_panes || die "$MUX would not list the panes"

	if [ -z "$target" ]; then
		focused_pane
		target=$FOCUSED
		[ -n "$target" ] || die "cannot find the focused pane"
	fi

	# The agent, or the agent whose nvim this is (a new thread's agent has an
	# nvim and a thread record before its first hook).
	agent_of_pane "$target" && agent=$AGENT

	if [ -z "$agent" ]; then
		cwd=$(printf '%s' "$PANES" | jq -r --arg p "$target" \
			'map(select((.is_plugin | not) and (.id | tostring) == $p)) | .[0].pane_cwd // empty')
		[ -d "$cwd" ] || cwd=$PWD
		open_left_of "$target" "$cwd" "nvim: ${cwd##*/}" nvim
	else
		mark_seen "$agent"
		state_file "$agent"
		if [ -f "$SF" ]; then
			info=$(jq -r '[.root // .cwd // "", .file // "", .session_id // "", .turn // 0, .state // "", .agent // "claude"]
				| map(tostring) | join("\u001f")' "$SF") || die "cannot read $SF"
		else
			info=$(jq -r '[.worktree // "", "", "", 0, "", .agent // "claude"] | map(tostring) | join("\u001f")' \
				"$STATE_DIR/${SKEY}_$agent.thread" 2>/dev/null)
		fi
		IFS=$US read -r root file sid turn state kind <<<"$info"
		[ -d "$root" ] || root=$PWD
		# git gives the root as a real path; the agent may have used a symlinked
		# one (/tmp vs /private/tmp on macOS), so compare real paths.
		if [ -n "$file" ] && [ -e "$file" ] && d=$(cd -P "${file%/*}" 2>/dev/null && pwd); then
			file="$d/${file##*/}"
		fi
		case $file in "$root"/*) [ -e "$file" ] || file="" ;; *) file="" ;; esac

		edit_lock "$agent"
		# Fresh, now that no other press is opening an nvim for this agent.
		[ "$EDIT_LOCK" ] && list_panes
		read_nvim_pane "$agent"
		nv=$NV
		# Reuse the agent's nvim while its pane is alive, even when nvim does
		# not answer (still starting, or stuck at a prompt): never a second one.
		if [ -n "$nv" ] &&
			printf '%s' "$PANES" | jq -e --arg p "$nv" \
				'any(.[]; (.is_plugin | not) and (.id | tostring) == $p and (.exited | not))' >/dev/null; then
			edit_unlock
			pane=$agent aid="" seq=$(jq -n 'now * 1000 | floor') agent_kind=${kind:-claude}
			nvim_edit_event focus "$root" "$file" ""
			focus_pane "$nv" "$(printf '%s' "$PANES" | jq -r --arg p "$nv" \
				'map(select((.is_plugin | not) and (.id | tostring) == $p)) | .[0].tab_id // empty')"
		else
			open_left_of "$agent" "$root" "nvim: ${root##*/}" "$SELF" nvim "$agent" ${file:+"$file"}
			# A thread's tab gets its split back.
			[ -f "$STATE_DIR/${SKEY}_$agent.thread" ] && [ -n "$NEWPANE" ] && thread_width "$agent" "$NEWPANE"
			# The new nvim records itself (pane and pid) as it starts; give it
			# a moment, still holding the lock, so a second press finds it.
			# Only if it is slow, record its pane ourselves, without the pid
			# (never over its own record: that would lose the pid).
			for ((i = 0; i < 15; i++)); do
				read_nvim_pane "$agent"
				[ -z "$NEWPANE" ] || [ "$NV" = "$NEWPANE" ] && break
				sleep 0.1
			done
			if [ -n "$NEWPANE" ] && [ "$NV" != "$NEWPANE" ]; then
				nvim_file "$agent"
				printf '%s\n\n' "$NEWPANE" >"$NVF.$$" && (set -C && cat "$NVF.$$" >"$NVF") 2>/dev/null
				rm -f "$NVF.$$"
			fi
			edit_unlock
		fi
	fi
	if [ $full = 1 ]; then
		if [ "$MUX" = tmux ]; then
			read_nvim_pane "${agent:-x}"
			tm resize-pane -Z -t "%${NV:-${NEWPANE:-$target}}" >/dev/null 2>&1
		else
			zellij action toggle-fullscreen
		fi
	fi
	return 0
}

# ---------------------------------------------------------------- agents

# The Claude Code sessions running on this machine, from their
# ~/.claude/sessions/<pid>.json files (read without a spawn each), as a JSON
# array in CLAUDE_LIVE. Undocumented, so used only to refine the hooks' state;
# a missing or unreadable directory just means no refinement.
claude_live() {
	local f line lines=""
	CLAUDE_LIVE="[]"
	for f in "$CLAUDE_DIR"/sessions/*.json; do
		[ -f "$f" ] || continue
		line=""
		{ IFS= read -r line <"$f"; } 2>/dev/null
		lines="$lines$line$NL"
	done
	[ -n "$lines" ] || return 0
	CLAUDE_LIVE=$(printf '%s' "$lines" | jq -cRn '[inputs | try fromjson catch empty | objects
		| {pid, sessionId, status, statusUpdatedAt, waitingFor, procStart}]' 2>/dev/null) || CLAUDE_LIVE="[]"
	[ -n "$CLAUDE_LIVE" ] || CLAUDE_LIVE="[]"
}

# Every state file in this session, as US-separated rows: pane, tab, state,
# root, since, seen, prompt, waiting, background, title, subagents, pid,
# proc_start, state file, then for the dashboard: turn, last message, tasks
# done, tasks, last file (base name), session id, tab name, agent, background
# tasks, the thread's task, name and stable number (from its .thread file),
# and the turn's roots (RS-separated). A thread whose agent has not reported yet (a .thread
# without a state) is a row in state "starting". A state is refined by the agent's Claude Code session
# file when that is newer: a dialog you already answered (a long tool you
# approved) shows as working, a dialog the hooks missed as needs-you, and an
# agent stopped with Esc (which fires no hook) as interrupted. Rows "gone"
# (pane no longer listed) and "corrupt" (unreadable) carry the file instead.
JQ_ROWS='
($panes | map(select(.is_plugin | not))) as $all
| ($all | map({key: (.id | tostring), value: .}) | from_entries) as $byid
| ($claude | map({key: (.pid | tostring), value: .}) | from_entries) as $live
| (reduce inputs as $l ({}; .[input_filename] += $l + "\n")) as $in
| ( ($in | to_entries[] | select(.key | endswith(".json"))
| .key as $f
| (try (.value | fromjson) catch null) as $s
| (try ($in[($f | rtrimstr(".json")) + ".thread"] // "" | fromjson) catch null) as $t
| if ($s | type) != "object" then ["corrupt", $f]
  else ($byid[$s.pane | tostring]) as $p
  | if $p == null then ["gone", $f, ($s.pid // ""), ($s.proc_start // ""), ($s.state // "")]
    elif $p.exited or $s.state == "ended" then empty
    else
      ($live[($s.pid // "") | tostring]) as $c0
      | (if $c0 != null and ($c0.sessionId // "") == ($s.session_id // "") then $c0 else null end) as $c
      | ((($c.statusUpdatedAt // 0) / 1000) | floor) as $cu
      | ($s.state // "idle") as $st0
      | (if $c == null then $st0
         elif $st0 == "needs-you" and $c.status == "busy" and $cu > ($s.since // 0) then "working"
         elif ($st0 != "needs-you") and $c.status == "waiting" and $cu >= ($s.ts // 0) then "needs-you"
         elif $st0 == "working" and $c.status == "idle" and (($s.background // 0) == 0)
              and $cu > ($s.ts // 0) and ($now - $cu) > 3 then "interrupted"
         else $st0 end) as $st
      | [$s.pane, $p.tab_id, $st, ($s.root // $s.cwd // ""),
         (if $st == $st0 then ($s.since // $s.ts // 0) else $cu end),
         ($s.seen // false), ($s.prompt // ""),
         (if $st == "needs-you" and $st0 != "needs-you" then ($c.waitingFor // "input") else ($s.waiting // "") end),
         ($s.background // 0), ($s.title // ""), (($s.subagents // []) | length),
         ($s.pid // ""), ($s.proc_start // ""), $f,
         ($s.turn // 0), ($s.last_message // ""),
         ([($s.tasks // []) | arrays | .[] | objects | select(.done == true)] | length),
         (($s.tasks // []) | arrays | length),
         (($s.file // "") | tostring | split("/") | last // ""), ($s.session_id // ""),
         ($p.tab_name // ""), ($s.agent // ""), ($s.background_tasks // ""),
         (($t | objects | .task) // ""), (($t | objects | .name) // ""), (($t | objects | .num) // ""),
         [($s.turn_roots // []) | arrays | .[] | tostring]]
    end
  end),
  # A thread whose agent has not reported yet (its pane still open).
  ($in | to_entries[] | select(.key | endswith(".thread"))
   | select($in[(.key | rtrimstr(".thread")) + ".json"] == null)
   | .key as $f
   | (try (.value | fromjson) catch null) as $t
   | select(($t | type) == "object")
   | ($byid[($t.pane // "") | tostring]) as $p
   | select($p != null and ($p.exited | not))
   | [$t.pane, $p.tab_id, "starting", ($t.worktree // ""), ($t.created // $now), false, ($t.task // ""), "",
      0, "", 0, "", "", $f, 0, "", 0, 0, "", "", ($p.tab_name // ""), ($t.agent // ""), "",
      ($t.task // ""), ($t.name // ""), ($t.num // ""), []]))
| (if (.[-1] | type) == "array" then .[-1] else [] end) as $roots
| (if (.[-1] | type) == "array" then .[:-1] else . end)
| map(tostring | gsub("[\u0000-\u001f]+"; " "))
  + (if ($roots | length) > 0 then [$roots | map(gsub("[\u0000-\u001f]+"; " ")) | join("\u001e")] else [] end)
| join("\u001f")'

# Is our list of panes the whole truth? Only when it includes the pane we run
# in (or we run outside a pane): never garbage-collect on a partial answer.
panes_trusted() {
	[ -n "$PANES" ] || return 1
	[ -n "${MY_PANE:-}" ] || return 0
	# tmux's list is jq's, each pane opening with its id.
	if [ "$MUX" = tmux ]; then
		case $PANES in *"{\"id\":$MY_PANE,"*) return 0 ;; esac
		return 1
	fi
	printf '%s' "$PANES" | jq -e --arg me "$MY_PANE" \
		'any(.[]; (.is_plugin | not) and (.id | tostring) == $me)' >/dev/null 2>&1
}

# Remove the files of the agent whose state file is $1 (its activity log stays).
# Only if its pid is still $2 (empty: none recorded) when we hold its lock: a
# hook may have just given the pane to a new agent.
forget() {
	local b=${1%.json} line="" re='"pid":([0-9]+)' now_pid="" SF=$1 LOCK
	[ -f "$1" ] || return 0
	lock
	{ IFS= read -r line <"$1"; } 2>/dev/null
	[[ $line =~ $re ]] && now_pid=${BASH_REMATCH[1]}
	if [ "$now_pid" != "${2:-}" ]; then
		drop_lock
		return 0
	fi
	rm -f "$1" "$b.nvim" "$b.bash" "$b.prompt" "$b.thread"
	rm -rf "$b.opening"
	drop_lock
}

# ---------------------------------------------------------------- lost threads
#
# A thread lasts until you close it (weaver close). When its agent dies with
# its zellij (a crash, or zellij quit) the thread is kept as lost, in
# $LOST_DIR/<skey>_<session id>.json, and `weaver resume` (or the weaver
# session, as it starts again) brings it back in a new tab that resumes its
# conversation. An agent ended on purpose (/exit), or whose pane you closed
# while its zellij ran on, is forgotten as before.

# A lost record's fields, read the same everywhere: where it resumes (where
# its agent started, else its thread's worktree, else where it last was; an
# empty field counts as none) and the session key it was lost from (older
# records call it "session").
JQ_LOST='
def present: select(. != null and . != "");
def lost_dir: ([.state.start_cwd, .thread.worktree, .state.root, .state.cwd] | map(present) | .[0]) // "";
def lost_skey: [.skey, .session] | map(present) | .[0] // "";
'
LOST_DIR="$STATE_DIR/lost"

# The running zellij servers, one "<session> <epoch it started>" per line, into
# SERVERS (asked once per process). A server is `zellij --server <socket
# dir>/<session>`; ps gives how long it has run, as [[dd-]hh:]mm:ss.
servers() {
	[ -n "${SERVERS+x}" ] && return 0
	local line et cmd now d h m s a b c
	SERVERS=""
	now=$(date +%s)
	while IFS= read -r line; do
		line=${line#"${line%%[! ]*}"}
		et=${line%% *} cmd=${line#* }
		case $cmd in *zellij*" --server "*) ;; *) continue ;; esac
		d=0 h=0 c=""
		case $et in *-*) d=${et%%-*} et=${et#*-} ;; esac
		IFS=: read -r a b c <<<"$et"
		if [ -n "$c" ]; then h=$a m=$b s=$c; else m=$a s=$b; fi
		case $d$h$m$s in '' | *[!0-9]*) continue ;; esac
		SERVERS="$SERVERS${cmd##*/} $((now - 10#$d * 86400 - 10#$h * 3600 - 10#$m * 60 - 10#$s))$NL"
	done <<EOF2
$(ps -A -ww -o etime=,command= 2>/dev/null)
EOF2
}

# Did the zellij of session $1 go since $2 (epoch s, an agent's last event):
# is no server running it, or one that started after?
server_lost() {
	local name start
	# A tmux session: lost when its server no longer has it, or has one of
	# its name made since (the server went, and weaver started it again).
	case $1 in tmux-*)
		while IFS=' ' read -r name start; do
			[ -n "$name" ] && [ "$name" = "$1" ] || continue
			[ "$start" -gt "$2" ]
			return
		done <<EOF2
$(tmux_sessions)
EOF2
		return 0
		;;
	esac
	servers
	# Inside zellij its own server runs: none means ps did not answer, and
	# without knowing, nothing is lost (forgotten, as before).
	[ -z "$SERVERS" ] && [ -n "$SESSION" ] && return 1
	while IFS=' ' read -r name start; do
		[ -n "$name" ] && [ "${name//\//_}" = "$1" ] || continue
		[ "$start" -gt "$2" ]
		return
	done <<EOF2
$SERVERS
EOF2
	return 0
}

# Is the dead agent of state file $1 a thread lost with its zellij? Only a
# thread (it has a record) with a session to resume, not ended on purpose,
# whose zellij has gone since its last event.
lost_check() {
	local b=${1%.json} base info sid ts why
	[ -f "$b.thread" ] && [ -f "$1" ] || return 1
	info=$(jq -r '[.session_id // "", .ts // 0, .end_reason // ""] | map(tostring) | join("\u001f")' "$1" 2>/dev/null) ||
		return 1
	IFS=$US read -r sid ts why <<<"$info"
	[ -n "$sid" ] || return 1
	case $why in prompt_input_exit | logout | clear) return 1 ;; esac
	base=${b##*/}
	server_lost "${base%_*}" "${ts:-0}"
}

# Keep the thread of the agent whose state file is $1 as lost, then remove
# its files. Only if its pid is still $2 when we hold its lock (as forget).
lose() {
	local b=${1%.json} line="" re='"pid":([0-9]+)' now_pid="" SF=$1 LOCK base sid lf
	[ -f "$1" ] || return 0
	lock
	{ IFS= read -r line <"$1"; } 2>/dev/null
	[[ $line =~ $re ]] && now_pid=${BASH_REMATCH[1]}
	if [ "$now_pid" != "${2:-}" ]; then
		drop_lock
		return 0
	fi
	base=${b##*/}
	sid=$(jq -r '.session_id // empty' "$1" 2>/dev/null)
	lf="$LOST_DIR/${base%_*}_$sid.json"
	mkdir -p "$LOST_DIR"
	if [ -n "$sid" ] && jq -nc --slurpfile s "$1" --slurpfile t "$b.thread" --arg skey "${base%_*}" \
		--argjson now "$(date +%s)" '{lost: $now, skey: $skey, state: $s[0], thread: $t[0]}' >"$lf.$$" 2>/dev/null &&
		mv -f "$lf.$$" "$lf"; then
		rm -f "$1" "$b.nvim" "$b.bash" "$b.prompt" "$b.thread"
		rm -rf "$b.opening"
		drop_lock
		return 0
	fi
	rm -f "$lf.$$"
	drop_lock
	return 1
}

# The agent of state file $1 (pid $2) is gone: its thread lost with its
# zellij is kept, anything else forgotten.
retire() {
	if lost_check "$1" && lose "$1" "${2:-}"; then return 0; fi
	forget "$1" "${2:-}"
}

# The live agents of this session as JQ_ROWS lines, into AGENT_ROWS; the files
# of agents that are gone (pane closed, or process dead) are removed.
agent_rows() {
	local rows line kind f pid start st trusted=0 now
	AGENT_ROWS=""
	local -a files
	# State files, and the records of threads whose agent may not have one yet.
	session_files json
	files=(${FOUND[@]+"${FOUND[@]}"})
	session_files thread
	files=(${files[@]+"${files[@]}"} ${FOUND[@]+"${FOUND[@]}"})
	[ ${#files[@]} -gt 0 ] || return 0
	list_panes || return 0
	panes_trusted && trusted=1
	claude_live
	now=$(date +%s)
	ROWS_NOW=$now
	# A file removed meanwhile (an agent cleaned up) makes jq fail at the end,
	# after it has printed the others: keep them.
	rows=$(jq -rRn --argjson panes "$PANES" --argjson claude "$CLAUDE_LIVE" --argjson now "$now" \
		"$JQ_ROWS" "${files[@]}" 2>/dev/null)
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		case $line in
		corrupt"$US"*) continue ;;
		gone"$US"*)
			IFS=$US read -r kind f pid start st <<<"$line"
			[ $trusted = 1 ] || continue
			agent_alive "$pid" "$start" && [ -n "$pid" ] && [ "$st" != ended ] && continue
			retire "$f" "$pid"
			;;
		*)
			IFS=$US read -r _ _ _ _ _ _ _ _ _ _ _ pid start f _ <<<"$line"
			if [ -n "$pid" ] && ! agent_alive "$pid" "$start"; then
				# Killed without a SessionEnd: it is not coming back (a thread
				# lost with its zellij is kept, to resume).
				retire "$f" "$pid"
				continue
			fi
			AGENT_ROWS="$AGENT_ROWS$line$NL"
			;;
		esac
	done <<EOF2
$rows
EOF2
}

# Across every session: remove the state of agents whose process is gone
# (keeping a thread lost with its zellij), ended agents after an hour,
# sessions that no longer exist (state from before pids were recorded), stale
# nvim files, and month-old activity logs and lost threads.
gc_states() {
	local f line pid start st ts sessions="" re_p='"pid":([0-9]+)' re_t='"proc_start":"([^"]*)"'
	local re_s='"state":"([a-z-]+)"' re_ts='"ts":([0-9]+)' now base skey
	now=$(date +%s)
	for f in "$STATE_DIR"/*_*.json; do
		[ -f "$f" ] || continue
		line="" pid="" start="" st="" ts=0
		{ IFS= read -r line <"$f"; } 2>/dev/null
		[[ $line =~ $re_p ]] && pid=${BASH_REMATCH[1]}
		[[ $line =~ $re_t ]] && start=${BASH_REMATCH[1]}
		[[ $line =~ $re_s ]] && st=${BASH_REMATCH[1]}
		[[ $line =~ $re_ts ]] && ts=${BASH_REMATCH[1]}
		if [ -n "$pid" ]; then
			agent_alive "$pid" "$start" || {
				retire "$f" "$pid"
				continue
			}
		else
			base=${f##*/}
			skey=${base%_*}
			if [ -z "$sessions" ]; then
				sessions=$NL$(mux_session_keys)$NL
			fi
			# Only an hour after its last event: zellij's list can miss a
			# session that is busy (seen under load in the tests).
			case $sessions in
			"$NL$NL") ;; # zellij did not answer: keep everything
			*"$NL$skey$NL"*) ;;
			*)
				if [ $((now - ts)) -gt 3600 ]; then
					forget "$f" ""
					continue
				fi
				;;
			esac
		fi
		[ "$st" = ended ] && [ $((now - ts)) -gt 3600 ] && forget "$f" "$pid"
	done
	for f in "$STATE_DIR"/*_*.nvim; do
		[ -f "$f" ] || continue
		[ -f "${f%.nvim}.json" ] && continue
		pid=""
		{ read -r _ && read -r pid; } <"$f" 2>/dev/null
		[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || rm -f "$f"
	done
	# A thread whose agent never reported (no state) goes with its session.
	for f in "$STATE_DIR"/*_*.thread; do
		[ -f "$f" ] || continue
		[ -f "${f%.thread}.json" ] && continue
		base=${f##*/}
		skey=${base%_*}
		if [ -z "$sessions" ]; then
			sessions=$NL$(mux_session_keys)$NL
		fi
		case $sessions in "$NL$NL" | *"$NL$skey$NL"*) ;; *) rm -f "$f" ;; esac
	done
	# Tabs that never finished opening leave their meeting place behind.
	[ -d "$THREADS_NEW" ] && find "$THREADS_NEW" -mindepth 1 -maxdepth 1 -mmin +1440 -exec rm -rf {} + 2>/dev/null
	find "$STATE_DIR" -maxdepth 1 -name 'form.*' -mmin +1440 -exec rm -f {} + 2>/dev/null
	[ -d "$STATE_DIR/fetch" ] && find "$STATE_DIR/fetch" -type f -mmin +1440 -exec rm -f {} + 2>/dev/null
	[ -f "$STATE_DIR/close.log" ] && [ "$(wc -c <"$STATE_DIR/close.log")" -gt 100000 ] && rm -f "$STATE_DIR/close.log"
	[ -d "$LOG_DIR" ] && find "$LOG_DIR" -name '*.jsonl' -mtime +30 -exec rm -f {} + 2>/dev/null
	[ -d "$LOST_DIR" ] && find "$LOST_DIR" -name '*.json' -mtime +30 -exec rm -f {} + 2>/dev/null
	[ -d "$STATE_DIR/turns" ] && find "$STATE_DIR/turns" -type f -mtime +30 -exec rm -f {} + 2>/dev/null
	[ "${1:-}" = quiet ] || echo "weaver: cleaned up"
	return 0
}

# ---------------------------------------------------------------- status

# Counts for the status line, into N_NEED (needs you), N_DONE (done, not yet
# seen) and N_WORK (working, or a thread starting): the board's rows
# (agent_rows), so a state is decided by one rule. With "mark", agents your
# clients are looking at count as seen (SEEN_NOW).
status_counts() {
	local pane st seen clients
	N_NEED=0 N_DONE=0 N_WORK=0 SEEN_NOW="" clients=" "
	if [ "${1:-}" = mark ]; then
		mux_clients
		clients=$MUX_CLIENT_PANES
	fi
	agent_rows
	while IFS=$US read -r pane _ st _ _ seen _; do
		[ -n "$pane" ] || continue
		case $st in
		needs-you) N_NEED=$((N_NEED + 1)) ;;
		working | starting) N_WORK=$((N_WORK + 1)) ;;
		done)
			[ "$seen" = true ] && continue
			case $clients in
			*" $pane "*) SEEN_NOW="$SEEN_NOW $pane" ;;
			*) N_DONE=$((N_DONE + 1)) ;;
			esac
			;;
		esac
	done <<EOF2
$AGENT_ROWS
EOF2
	return 0
}

# The status text, plain.
status_text() {
	STATUS=""
	[ $N_NEED -gt 0 ] && STATUS="$STATUS$G_NEED $N_NEED  "
	[ $N_DONE -gt 0 ] && STATUS="${STATUS}$G_DONE $N_DONE  "
	[ $N_WORK -gt 0 ] && STATUS="${STATUS}$G_WORK $N_WORK  "
	STATUS=${STATUS%  }
}

# Keep the counts the status line shows (weaver status --tmux, --zjstatus) and
# reload any open dashboard. Agents you are looking at count as seen. With
# "labels" (a title, prompt or branch changed, or the session started), the
# thread tabs' labels too.
push_status() {
	local labels=${1:-} p s q side="" old="" o1 o2 o3
	status_counts mark
	for p in $SEEN_NOW; do mark_seen "$p"; done
	[ -d "$STATE_DIR" ] || mkdir -p "$STATE_DIR"
	{ read -r o1 o2 o3 _ <"$STATE_DIR/$SKEY.status" && old="$o1 $o2 $o3"; } 2>/dev/null
	printf '%s %s %s\n' "$N_NEED" "$N_DONE" "$N_WORK" >"$STATE_DIR/$SKEY.status.$$" &&
		mv -f "$STATE_DIR/$SKEY.status.$$" "$STATE_DIR/$SKEY.status"
	# tmux's status line shows the session's @weaver-counts, and an option
	# set redraws every client: set them when they change (and as the
	# session starts, whose option is new).
	if [ "$MUX" = tmux ] && { [ "$labels" = labels ] || [ "$N_NEED $N_DONE $N_WORK" != "$old" ]; }; then
		counts_fmt "$N_NEED" "$N_DONE" "$N_WORK"
		tm set-option -t "=$SESSION:" @weaver-counts "$COUNTS_FMT" >/dev/null 2>&1
	fi
	printf -v q '%q' "$SELF"
	for s in "$SOCK_DIR/${SKEY}".fzf.*.sock; do
		[ -S "$s" ] || continue
		curl -s -m 1 --unix-socket "$s" -X POST -d "reload(COLOR=1 $q _rows)+refresh-preview" \
			http://localhost >/dev/null 2>&1 || rm -f "$s" "${s%.sock}".keys "${s%.sock}".view "${s%.sock}".title \
			"${s%.sock}".label "${s%.sock}".room "${s%.sock}".shown "${s%.sock}".tight "${s%.sock}".vp
	done
	# The sidebars: the session's rows once, for all of them. tmux's weaver
	# session labels its thread windows either way: its status line shows them.
	for s in "$SOCK_DIR/${SKEY}".side.*.sock; do [ -S "$s" ] && side=1 && break; done
	if [ -z "$side" ]; then
		[ "$labels" = labels ] && [ "$MUX" = tmux ] && weaver_session && thread_tab_labels
		return 0
	fi
	side_cache_write
	thread_tab_labels
	for s in "$SOCK_DIR/${SKEY}".side.*.sock; do
		[ -S "$s" ] || continue
		curl -s -m 1 --unix-socket "$s" -X POST -d "reload($q _side --cached)" http://localhost >/dev/null 2>&1 ||
			rm -f "$s" "${s%.sock}".keys "${s%.sock}".cur
	done
	return 0
}

cmd_status() {
	need_session
	case ${1:-} in
	--push) push_status ;;
	*)
		status_counts
		status_text
		printf '%s\n' "$STATUS"
		;;
	esac
}

# ---------------------------------------------------------------- ls

# The dashboard: every agent of the session under a heading per group, best
# first. The groups match the status bar's counts, and each state has a glyph
# that reads without colour (G_*, at the top; the nvim bar uses the same):
#
#   NEEDS YOU  needs you, longest waiting first      (red)
#   DONE       done and not yet seen, oldest first   (green)
#   WORKING    working, longest working first        (grey)
#   IDLE       done and seen, idle, interrupted; most recent first (faint)
#
# Titles are in ink only where a thread needs you (needs you, done); the rest
# are grey.

# paint CELL COLOUR [DIM OFF]: the cell's brackets in DIM (C_DIM), its mark in
# COLOUR, each closed by OFF (C_OFF), into PAINT. Without colours, the cell.
paint() {
	PAINT="${3-$C_DIM}${1:0:1}${4-$C_OFF}$2${1:1:1}${4-$C_OFF}${3-$C_DIM}${1:2:1}${4-$C_OFF}"
}

# Character counts and cuts need a UTF-8 locale: keep the one in place when it
# counts 'é' as one character, else try en_US.UTF-8, then C.UTF-8 (quietly:
# bash warns when a locale is missing).
ls_utf8() {
	local t='é'
	[ ${#t} = 1 ] && return 0
	{ LC_ALL=en_US.UTF-8; } 2>/dev/null
	t='é'
	[ ${#t} = 1 ] && return 0
	{ LC_ALL=C.UTF-8; } 2>/dev/null
	return 0
}

# TEXT cut to N characters (… at the cut) and padded to N, into FIT.
fit() {
	local s=$1 n=$2
	if [ "$n" -le 0 ]; then
		FIT=""
		return
	fi
	[ ${#s} -gt "$n" ] && s="${s:0:$((n - 1))}…"
	printf -v FIT '%s%*s' "$s" $((n - ${#s})) ''
}

# 75s -> 1m, 2h ...
age() {
	if [ "$1" -lt 60 ]; then
		AGE="${1}s"
	elif [ "$1" -lt 3600 ]; then
		AGE="$(($1 / 60))m"
	elif [ "$1" -lt 172800 ]; then
		AGE="$(($1 / 3600))h"
	else
		AGE="$(($1 / 86400))d"
	fi
}

# The repository and branch checked out at ROOT, read from its .git files
# without running git: W_REPO (the main checkout's directory name, so
# worktrees group under their repo), W_BRANCH (a short commit when detached;
# empty outside a repository) and W_GITDIR (the checkout's own git dir).
where_of() {
	local root=$1 gd common line up=0
	W_REPO=${root##*/} W_BRANCH="" W_GITDIR=""
	if [ -d "$root/.git" ]; then
		gd=$root/.git
		common=$gd
	elif [ -f "$root/.git" ]; then
		line=""
		{ IFS= read -r line <"$root/.git"; } 2>/dev/null
		gd=${line#gitdir: }
		case $gd in /*) ;; *) gd=$root/$gd ;; esac
		common=$gd
		if [ -f "$gd/commondir" ]; then
			line=""
			{ IFS= read -r line <"$gd/commondir"; } 2>/dev/null
			case $line in /*) common=$line ;; ?*) common=$gd/$line ;; esac
		fi
	else
		return 0
	fi
	while :; do
		case $common in
		*/..) common=${common%/..} up=$((up + 1)) ;;
		*/. | */) common=${common%.} common=${common%/} ;;
		*) break ;;
		esac
	done
	while [ $up -gt 0 ]; do common=${common%/*} up=$((up - 1)); done
	case ${common##*/} in
	.git | .bare) W_REPO=${common%/*} W_REPO=${W_REPO##*/} ;;
	*.git) W_REPO=${common##*/} W_REPO=${W_REPO%.git} ;;
	esac
	W_GITDIR=$gd
	line=""
	{ IFS= read -r line <"$gd/HEAD"; } 2>/dev/null
	case $line in
	"ref: refs/heads/"*) W_BRANCH=${line#ref: refs/heads/} ;;
	"") ;;
	*) W_BRANCH=${line:0:7} ;;
	esac
}

# How many files the agent's last turn changed, from the end snapshots of
# turn TURN of session SID in ROOTS (RS-separated), into TURN_FILES (empty
# when there is none). Each snapshot commit is asked about once; the answer
# is kept under $STATE_DIR/turns/<commit>.
turn_files() {
	local sid=$1 turn=$2 r sha line t c total="" IFS=$RS
	TURN_FILES=""
	[ -n "$sid" ] && [ "$turn" != 0 ] || return 0
	for r in $3; do
		[ -n "$r" ] || continue
		where_of "$r"
		[ -n "$W_GITDIR" ] || continue
		sha=""
		{ IFS= read -r sha <"$W_GITDIR/refs/worktree/weaver/sessions/$sid"; } 2>/dev/null
		case $sha in '' | *[!0-9a-f]*) continue ;; esac
		line=""
		{ IFS= read -r line <"$STATE_DIR/turns/$sha"; } 2>/dev/null
		if [ -z "$line" ]; then
			# The commit's turn and point (trailers), then its files.
			line=$(git -C "$r" show --no-renames --name-only \
				--format='%(trailers:key=Weaver-Turn,valueonly,separator=) %(trailers:key=Weaver-Point,valueonly,separator=)' \
				"$sha" -- 2>/dev/null | awk 'NR == 1 { h = $1 " " $2; next } NF { n++ } END { print h, n + 0 }')
			case $line in [0-9]*" "[a-z]*" "[0-9]*) ;; *) continue ;; esac
			mkdir -p "$STATE_DIR/turns" &&
				printf '%s\n' "$line" >"$STATE_DIR/turns/$sha.$$" && mv -f "$STATE_DIR/turns/$sha.$$" "$STATE_DIR/turns/$sha"
		fi
		IFS=' ' read -r t _ c <<<"$line"
		[ "$t" = "$turn" ] || continue
		case $line in *" end "*) ;; *) continue ;; esac
		total=$((${total:-0} + c))
	done
	TURN_FILES=$total
}

# The dashboard's size, into LS_COLS and LS_LINES: fzf's (FZF_COLUMNS and
# FZF_LINES are 0 before it has drawn), else the terminal's. With "border",
# fzf's border is counted in.
ls_size() {
	local size
	LS_COLS=${FZF_COLUMNS:-0} LS_LINES=${FZF_LINES:-0}
	case $LS_COLS$LS_LINES in *[!0-9]*) LS_COLS=0 LS_LINES=0 ;; esac
	# Inside fzf's border (the dashboard's), fzf counts without it and the
	# padding next to it: the pane is 4 columns and 2 lines more.
	if [ "${1:-}" = border ] && [ "$LS_COLS" -gt 0 ] && [ "$LS_LINES" -gt 0 ]; then
		LS_COLS=$((LS_COLS + 4)) LS_LINES=$((LS_LINES + 2))
	fi
	if [ "$LS_COLS" -eq 0 ] || [ "$LS_LINES" -eq 0 ]; then
		size=$({ stty size </dev/tty; } 2>/dev/null)
		LS_LINES=${size%% *} LS_COLS=${size#* }
		case $LS_COLS in '' | *[!0-9]*) LS_COLS=${COLUMNS:-100} ;; esac
		case $LS_LINES in '' | *[!0-9]*) LS_LINES=${LINES:-40} ;; esac
		case $LS_COLS$LS_LINES in *[!0-9]*) LS_COLS=100 LS_LINES=40 ;; esac
	fi
}

# The card: beside the list in a dashboard 150 columns wide or more (74 of
# them, its border included), else below it, in about 12 lines.
LS_CARD_W=74 LS_CARD_H=12
ls_card_right() { [ "$1" -ge 150 ]; }

# The width of the dashboard's list, into LS_WIDTH: LS_COLS, less the card
# when that is beside it.
ls_width() {
	LS_WIDTH=$LS_COLS
	ls_card_right "$LS_COLS" && LS_WIDTH=$((LS_COLS - LS_CARD_W - 2))
	return 0
}

# Where the card goes in a dashboard of LS_COLS x LS_LINES with a list of
# ITEMS lines, into LS_PW (fzf's --preview-window) and LS_PHIDE (1 when it is
# hidden for want of room); kept next to the socket (.room, .tight) for
# `weaver _chrome` and `weaver _view`. The list comes first: below it, the
# card gets what the border, the header line, the list and the footer leave,
# and is hidden when that is under 6 lines; s, tab and ? still show it, over
# the list.
ls_card_room() {
	local items=$1 p base=${FZF_SOCK:-}
	base=${base%.sock}
	LS_PHIDE=""
	if [ "$items" = 0 ]; then
		LS_PW="down,50%,border-top,wrap,hidden"
	elif ls_card_right "$LS_COLS"; then
		LS_PW="right,$LS_CARD_W,border-left,wrap"
	else
		p=$((LS_LINES - items - 5))
		if [ $p -lt 6 ]; then
			LS_PHIDE=1 LS_PW="down,50%,border-top,wrap,hidden"
		else
			LS_PW="down,$p,border-top,wrap"
		fi
	fi
	[ -n "$base" ] || return 0
	printf '%s\n' "$LS_PW" >"$base.room"
	if [ -n "$LS_PHIDE" ]; then : >"$base.tight"; else rm -f "$base.tight"; fi
}

# The tab's size and whether the dashboard's pane floats (pane_view), kept
# next to the socket (.vp) so that reloads don't ask zellij again; asked
# again with LS_REMEASURE=1 (fzf's resize).
ls_view() {
	local base=${FZF_SOCK:-}
	base=${base%.sock}
	if [ -n "$base" ] && [ -z "${LS_REMEASURE:-}" ] && [ -f "$base.vp" ]; then
		WEAVER_VIEW=$(cat "$base.vp" 2>/dev/null) pane_view "${MY_PANE:-}"
		return
	fi
	pane_view "${MY_PANE:-}" || return 1
	[ -n "$base" ] && printf '%s %s %s\n' "$VIEW_COLS" "$VIEW_ROWS" "$VIEW_FLOAT" >"$base.vp"
	return 0
}

# The dashboard's layout, for ls_rows (whose variables it shares: n, groups,
# wn, wf and ww in; width, cw and gaps out). A floating dashboard first fits
# its pane (float_fit) to the list, its header and footer, fzf's border and
# the card: the card beside the list when the pane can be 150 columns wide,
# else below it, given 6 lines at least. Then: the rows' width, repo/branch
# when there is room, the gaps between groups when they fit, and the card's
# room (ls_card_room).
ls_plan() {
	local items=0 nn nf=0 nw=0 lt cols rows vmc vmr
	nn=$((wn + 2 > 42 ? 42 : wn + 2))
	[ $wf -gt 0 ] && nf=$((wf + 2 > 58 ? 58 : wf + 2))
	[ $ww -gt 0 ] && nw=$((ww + 2 > 30 ? 30 : ww + 2))
	[ $n -gt 0 ] && items=$((n + groups * 2 - 1))
	ls_size border
	if ls_view && [ -n "$VIEW_FLOAT" ]; then
		vmc=$((VIEW_COLS * 90 / 100)) vmr=$((VIEW_ROWS * 85 / 100))
		# The rows, and fzf's border, padding and pointer around them.
		lt=$((pre + nn + nf + nw + age_w + 7))
		if [ $n = 0 ]; then
			cols=72 rows=7
		elif [ $vmc -ge 150 ]; then
			cols=$((lt + LS_CARD_W))
			[ $cols -lt 150 ] && cols=150
			rows=$((items + 2))
			[ $rows -lt $LS_CARD_H ] && rows=$LS_CARD_H
			rows=$((rows + 2))
		else
			cols=$lt
			[ $cols -lt 72 ] && cols=72
			rows=$((items + 4 + 1 + LS_CARD_H))
			[ $rows -gt $vmr ] && [ $((vmr - items - 5)) -lt 6 ] && rows=$((items + 4))
		fi
		[ $cols -gt $vmc ] && cols=$vmc
		[ $rows -gt $vmr ] && rows=$vmr
		if [ "$rows $cols" != "$LS_LINES $LS_COLS" ]; then
			float_fit "$rows" "$cols"
			[ -n "$FIT_ROWS" ] && LS_LINES=$FIT_ROWS LS_COLS=$FIT_COLS
		fi
	fi
	gaps=1
	if [ $n -gt 0 ] && [ $((items + 4)) -gt "$LS_LINES" ]; then
		gaps=0 items=$((n + groups))
	fi
	# fzf's border and its padding, the pointer's columns, a spare one.
	ls_width
	width=$((LS_WIDTH - 7))
	cw=0
	# Repo/branch only when the name and the fact keep 24 and 20 columns.
	[ $nw -gt 0 ] && [ $((width - nw)) -ge $((pre + (nn < 24 ? nn : 24) + (nf < 20 ? nf : 20) + age_w)) ] && cw=$nw
	ls_card_room "$items"
}

# The dashboard's lines. LS_MODE=fzf (the default for `weaver _rows`): one
# TAB-separated item per line:
#   id  pane  tab  prev  next  label  display
# id is a<pane> for an agent, h<group> for a heading, g<group> for the gap
# above one; prev and next are the list positions of the agents around a
# heading or gap, for the cursor to skip it; label is the resume card's
# title. The display has a TAB after the glyph: fzf searches only what
# follows (--nth 2), which headings and gaps leave empty. When the list would
# not fit the dashboard, the gaps go. The title (and, with no agents, what to
# do) goes to $FZF_SOCK's .title file, for fzf's header (`weaver _title`);
# the first nine agents are numbered, and the .keys file holds the fzf
# actions that pick them (one per line, for the 1-9 keys). Width: fzf's list
# (ls_width). LS_MODE=plain: the board as text, $COLUMNS wide (100 when
# unset). Micrographics colours for fzf, else only with COLOR=1.
ls_rows() {
	local mode=${LS_MODE:-fzf} width now i j k n=0 g c sep="  "
	local pane tab state root since seen prompt waiting bg title nsub turn last tdone ttotal file sid
	local tabname agent bgtasks ttask tname tnum troots name fact glyph key where lf lsid live
	local red="" green="" grey="" dim="" bold="" off=""
	local wn=0 wf=0 ww=0 cn cf cw pre lead age_w=3 out="" keys="" title_l title_r gap
	local -a r_group r_key r_pane r_tab r_glyph r_name r_fact r_where r_age r_label r_root r_num r_lost order
	local nums="" numw=2 jump=${LS_JUMP:-print(jump)+accept} shown tl tc tk
	local -a keyl=("" "" "" "" "" "" "" "" "" "")
	local -a counts=(0 0 0 0 0) heads=("NEEDS YOU" "DONE" "WORKING" "IDLE" "LOST")
	local gaps=1 groups=0
	ls_utf8
	# Colours for fzf, and on request (COLOR=1).
	[ "${COLOR:-$([ "$mode" = fzf ] && echo 1)}" = 1 ] &&
		red=$C_RED green=$C_GREEN grey=$C_GREY dim=$C_DIM bold=$C_BOLD off=$C_OFF
	width=${COLUMNS:-100}
	case $width in '' | *[!0-9]*) width=100 ;; esac
	[ $width -lt 40 ] && width=40
	ROWS_NOW=""
	agent_rows
	now=${ROWS_NOW:-$(date +%s)}
	while IFS=$US read -r pane tab state root since seen prompt waiting bg title nsub _ _ _ \
		turn last tdone ttotal file sid tabname agent bgtasks ttask tname tnum troots; do
		[ -n "$pane" ] || continue
		case $bg in '' | *[!0-9]*) bg=0 ;; esac
		case $nsub in '' | *[!0-9]*) nsub=0 ;; esac
		case $since in '' | *[!0-9]*) since=$now ;; esac
		name=${title:-${ttask:-$prompt}}
		[ -n "$name" ] || name="new ${agent:-claude} session"
		fact=""
		case $state in
		needs-you)
			g=0 fact="${waiting:-input}"
			paint "$G_NEED" "$red" "$dim" "$off"
			glyph=$PAINT
			;;
		working)
			g=2
			paint "$G_WORK" "$grey" "$dim" "$off"
			glyph=$PAINT
			if [ "$bg" != 0 ]; then
				fact="$bg in background"
			elif [ "$nsub" != 0 ]; then
				fact="$nsub subagent$([ "$nsub" = 1 ] || echo s)"
			elif [ "${ttotal:-0}" != 0 ]; then
				fact="$tdone/$ttotal tasks"
			elif [ -n "$file" ]; then
				fact="editing $file"
			fi
			;;
		done)
			if [ "$seen" = true ]; then
				g=3
				paint "$G_SEEN" "$dim" "$dim" "$off"
			else
				g=1
				paint "$G_DONE" "$green" "$dim" "$off"
			fi
			glyph=$PAINT
			turn_files "$sid" "$turn" "${troots:-$root}"
			case $TURN_FILES in
			'' | 0) fact=$last ;;
			1) fact="1 file${last:+ · $last}" ;;
			*) fact="$TURN_FILES files${last:+ · $last}" ;;
			esac
			;;
		interrupted)
			g=3 fact=interrupted
			paint "$G_INT" "$grey" "$dim" "$off"
			glyph=$PAINT
			;;
		starting)
			# Its agent reports within seconds, unless its hooks are not in
			# place (Codex runs them only once trusted in /hooks).
			if [ $((now - since)) -lt 120 ]; then
				g=2 fact=starting
				paint "$G_WORK" "$grey" "$dim" "$off"
			else
				g=3 fact="not reporting"
				paint "$G_IDLE" "$dim" "$dim" "$off"
				[ "$agent" = codex ] && fact="no hooks: trust them in codex /hooks"
			fi
			glyph=$PAINT
			;;
		*)
			g=3
			paint "$G_IDLE" "$dim" "$dim" "$off"
			glyph=$PAINT
			[ "${turn:-0}" = 0 ] && fact="no prompt yet"
			;;
		esac
		where_of "$root"
		where=$W_REPO${W_BRANCH:+/$W_BRANCH}
		age $((now - since))
		# Needs you, done and working: longest first; idle: latest first.
		if [ $g = 3 ]; then key=$((10000000000 - since)); else key=$since; fi
		printf -v key '%d%011d%08d' "$g" "$key" "$pane"
		r_group[n]=$g r_key[n]=$key r_pane[n]=$pane r_tab[n]=$tab r_glyph[n]=$glyph
		r_name[n]=$name r_fact[n]=$fact r_where[n]=$where r_age[n]=$AGE r_root[n]=$root
		r_label[n]="$name · $where${turn:+ · turn $turn}"
		case $tnum in '' | *[!0-9]*) tnum="" ;; esac
		r_num[n]=$tnum
		[ -n "$tnum" ] && nums=1 && [ ${#tnum} -gt $numw ] && numw=${#tnum}
		counts[g]=$((counts[g] + 1))
		[ ${#name} -gt $wn ] && wn=${#name}
		[ ${#fact} -gt $wf ] && wf=${#fact}
		n=$((n + 1))
	done <<EOF2
$AGENT_ROWS
EOF2
	live=$n
	# Threads lost with their zellij (a crash, or zellij quit), last: enter
	# resumes one in a new tab (weaver resume).
	lost_rows
	while IFS=$US read -r lf lsid tname tnum root since _ ttask title; do
		[ -n "$lf" ] || continue
		case $since in '' | *[!0-9]*) since=$now ;; esac
		name=${tname:-${title:-$ttask}}
		fact="its session went · ⏎ resumes"
		paint "$G_END" "$grey" "$dim" "$off"
		glyph=$PAINT
		where_of "$root"
		where=$W_REPO${W_BRANCH:+/$W_BRANCH}
		age $((now - since))
		printf -v key '%d%011d%08d' 4 $((10000000000 - since)) "$n"
		r_group[n]=4 r_key[n]=$key r_pane[n]=$lsid r_tab[n]="" r_glyph[n]=$glyph r_lost[n]=1
		r_name[n]=$name r_fact[n]=$fact r_where[n]=$where r_age[n]=$AGE r_root[n]=$root
		r_label[n]="$name · $where · lost" r_num[n]=""
		counts[4]=$((counts[4] + 1))
		[ ${#name} -gt $wn ] && wn=${#name}
		[ ${#fact} -gt $wf ] && wf=${#fact}
		n=$((n + 1))
	done <<EOF2
$LOST_ROWS
EOF2
	# Best first: an insertion sort (a handful of rows).
	i=0
	while [ $i -lt $n ]; do
		j=${#order[@]}
		while [ $j -gt 0 ] && [[ ${r_key[order[j - 1]]} > ${r_key[i]} ]]; do
			order[j]=${order[j - 1]}
			j=$((j - 1))
		done
		order[j]=$i
		i=$((i + 1))
	done
	# Two agents in one worktree mix their per-turn diffs: say so (×2).
	i=0
	while [ $i -lt $n ]; do
		c=0 j=0
		while [ $j -lt $live ] && [ $i -lt $live ]; do
			[ "${r_root[j]}" = "${r_root[i]}" ] && c=$((c + 1))
			j=$((j + 1))
		done
		[ $c -gt 1 ] && r_where[i]="${r_where[i]} ×$c"
		[ ${#r_where[i]} -gt $ww ] && ww=${#r_where[i]}
		i=$((i + 1))
	done

	# Columns: key and glyph, name, fact, where (when there is room), age.
	# fzf searches only what follows the TAB after the glyph (--nth 2,
	# --tabstop 1): headings and gaps have nothing there, so a search shows
	# the agents alone.
	if [ "$mode" = fzf ]; then
		pre=$((numw + 6)) sep=" $TAB"
		for g in 0 1 2 3 4; do [ ${counts[g]} -gt 0 ] && groups=$((groups + 1)); done
		ls_plan
	else
		pre=5 cw=0
		[ $width -ge 96 ] && [ $ww -gt 0 ] && cw=$((ww + 2 > 30 ? 30 : ww + 2))
	fi
	k=$((width - pre - age_w - cw))
	# The name comes first: at least 24 columns (less only if no name needs
	# them), 45% of the room once there is plenty, but never past 40 characters.
	cn=$((k * 45 / 100))
	[ $cn -lt 24 ] && cn=24
	[ $cn -gt 42 ] && cn=42
	[ $wn -gt 0 ] && [ $((wn + 2)) -lt $cn ] && cn=$((wn + 2))
	cf=$((k - cn))
	if [ $cf -lt 10 ]; then
		cn=$k cf=0
	fi
	# No wider than the facts need: repo/branch and age stay close by.
	[ $cf -gt $((wf + 2)) ] && cf=$((wf + 2))
	[ $wf = 0 ] && cf=0
	width=$((pre + cn + cf + cw + age_w))

	# The title: the thread count, and the status bar's counts at the right.
	# [ WEAVER :: THREADS ] 5, like the vault's [ MAP :: LOCAL ] 4 LINKS; tl in
	# colour (WEAVER in ink on fzf's grey border), title_l to measure.
	title_l="[ WEAVER :: THREADS ]"
	[ $live = 0 ] || title_l="$title_l $live"
	tk=$bold
	[ "$mode" = fzf ] && [ -n "$bold" ] && tk="$C_BOLD$C_INK"
	tl="$dim[$off ${tk}WEAVER$off $dim::$off ${grey}THREADS$off $dim]$off"
	[ $live = 0 ] || tl="$tl $grey$live$off"
	# The status bar's counts, their cells in its colours; tc in colour.
	title_r="" tc=""
	for g in 0 1 2; do
		[ ${counts[g]} -gt 0 ] || continue
		case $g in 0) shown=$G_NEED tk=$red ;; 1) shown=$G_DONE tk=$green ;; *) shown=$G_WORK tk=$grey ;; esac
		paint "$shown" "$tk" "$dim" "$off"
		title_r="$title_r$shown ${counts[g]}  " tc="$tc$PAINT $grey${counts[g]}$off  "
	done
	title_r=${title_r%  } tc=${tc%  }
	# Home is in the weaver session, whose status line shows the counts.
	[ -n "${LS_HOME:-}" ] && title_r="" tc=""
	if [ "$mode" = fzf ]; then
		# On fzf's top border: ┌─ [ WEAVER :: THREADS ] 5 ──── [!] 2  [x] 1  [/] 1 ─┐
		k=$((LS_COLS - 4 - ${#title_l} - ${#title_r} - 4))
		[ $k -lt 1 ] && k=1
		gap=""
		while [ ${#gap} -lt $k ]; do gap="${gap}─"; done
		gap=" $dim$gap$off "
		[ -n "$title_r" ] || gap=""
	else
		k=$((width - ${#title_l} - ${#title_r}))
		[ $k -lt 2 ] && k=2
		printf -v gap '%*s' $k ''
	fi
	if [ "$mode" = fzf ]; then
		# The border's label, and (no agents) what to do, for the header.
		if [ -n "${FZF_SOCK:-}" ]; then
			printf '%s\n' " $tl$gap$tc " >"${FZF_SOCK%.sock}.label.$$" &&
				mv -f "${FZF_SOCK%.sock}.label.$$" "${FZF_SOCK%.sock}.label"
			out=""
			[ $n = 0 ] && out="${grey}No threads yet.$off ${C_OFF}n$grey starts one here, ${C_OFF}Alt N$grey from anywhere;$off$NL${grey}or start claude or codex in any pane.$off"
			printf '%s\n' "$out" >"${FZF_SOCK%.sock}.title.$$" && mv -f "${FZF_SOCK%.sock}.title.$$" "${FZF_SOCK%.sock}.title"
			[ $n = 0 ] && : >"${FZF_SOCK%.sock}.keys"
		fi
		[ $n = 0 ] && return 0
	else
		printf '%s\n\n' "$tl$gap$tc"
		if [ $n = 0 ]; then
			printf '%s\n' "No agents in session $SESSION."
			return 0
		fi
	fi

	# Positions first (headings and gaps take one each), so each heading and
	# gap knows the agents around it.
	local -a l_id l_pane l_tab l_text l_label l_isagent
	local m=0 last_g=-1 a=0 prevp nextp
	for i in "${order[@]}"; do
		g=${r_group[i]}
		if [ "$g" != "$last_g" ]; then
			if [ $last_g != -1 ] && [ $gaps = 1 ]; then
				l_id[m]="g$g" l_text[m]="" l_isagent[m]=0
				m=$((m + 1))
			fi
			l_id[m]="h$g" l_text[m]="$grey${heads[g]}$off$dim · $off$grey${counts[g]}$off" l_isagent[m]=0
			[ "$mode" = fzf ] || l_text[m]="${heads[g]} · ${counts[g]}"
			m=$((m + 1))
			last_g=$g
		fi
		lead=""
		if [ -n "${r_lost[i]:-}" ]; then
			# A lost thread: no number, no 1-9 key.
			[ "$mode" = fzf ] && printf -v lead "%${numw}s " ""
		elif [ "$mode" = fzf ]; then
			a=$((a + 1))
			# Threads' stable numbers when they have them (the same in the
			# sidebar and on the home tab), else the rows' order.
			# Two digits, like the vault's numbered sections (01).
			if [ -n "$nums" ]; then
				c=${r_num[i]} shown=${r_num[i]}
			else
				c=$a shown=""
				[ $a -le 9 ] && shown=$a
			fi
			[ -n "$shown" ] && printf -v shown '%02d' "$shown"
			printf -v lead "%s%${numw}s%s " "$dim" "$shown" "$off"
			case $c in [1-9]) keyl[c]="pos($((m + 1)))+$jump" ;; esac
		fi
		fit "${r_name[i]}" $((cn - 2))
		[ "${r_group[i]}" -ge 2 ] && FIT="$grey$FIT$off"
		out="$lead${r_glyph[i]}$sep$FIT  "
		if [ $cf -gt 0 ]; then
			fit "${r_fact[i]}" $((cf - 2))
			out="$out$grey$FIT$off  "
		fi
		if [ $cw -gt 0 ]; then
			fit "${r_where[i]}" $((cw - 2))
			out="$out$dim$FIT$off  "
		fi
		printf -v FIT '%*s' $age_w "${r_age[i]}"
		out="$out$dim$FIT$off"
		l_id[m]="a${r_pane[i]}" l_pane[m]=${r_pane[i]} l_tab[m]=${r_tab[i]} l_text[m]=$out
		[ -n "${r_lost[i]:-}" ] && l_id[m]="l${r_pane[i]}"
		l_label[m]=${r_label[i]} l_isagent[m]=1
		m=$((m + 1))
	done
	if [ "$mode" != fzf ]; then
		i=0
		while [ $i -lt $m ]; do
			case ${l_id[i]} in g*) printf '\n' ;; *) printf '%s\n' "${l_text[i]}" ;; esac
			i=$((i + 1))
		done
		return 0
	fi
	# 1-9: fzf actions that pick those agents.
	for c in 1 2 3 4 5 6 7 8 9; do keys="$keys${keyl[c]}$NL"; done
	[ -n "${FZF_SOCK:-}" ] &&
		printf '%s' "$keys" >"${FZF_SOCK%.sock}.keys.$$" && mv -f "${FZF_SOCK%.sock}.keys.$$" "${FZF_SOCK%.sock}.keys"
	i=0
	while [ $i -lt $m ]; do
		if [ "${l_isagent[i]}" = 1 ]; then
			printf '%s\t%s\t%s\t\t\t%s\t%s\n' "${l_id[i]}" "${l_pane[i]}" "${l_tab[i]}" "${l_label[i]}" "${l_text[i]}"
		else
			prevp="" nextp=""
			j=$((i - 1))
			while [ $j -ge 0 ]; do [ "${l_isagent[j]}" = 1 ] && prevp=$((j + 1)) && break; j=$((j - 1)); done
			j=$((i + 1))
			while [ $j -lt $m ]; do [ "${l_isagent[j]}" = 1 ] && nextp=$((j + 1)) && break; j=$((j + 1)); done
			printf '%s\t\t\t%s\t%s\t\t%s\t\n' "${l_id[i]}" "$prevp" "$nextp" "${l_text[i]}"
		fi
		i=$((i + 1))
	done
}

# The resume card's jq: age, word wrapping, and a field (its label, then the
# value wrapped under itself, at most $lines lines) in $w columns.
JQ_CARD='
def age: if . < 60 then "\(.)s" elif . < 3600 then "\(. / 60 | floor)m"
	elif . < 172800 then "\(. / 3600 | floor)h" else "\(. / 86400 | floor)d" end;
def base: tostring | split("/") | last;
def one: tostring | gsub("[\\t\\n\\r]+"; " ");
# Words into lines of at most $n characters (a longer word is cut).
def wrap($n): reduce (split(" ")[] | select(. != "")) as $x ([];
	if length == 0 then [$x[0:$n]]
	elif (.[-1] | length) + 1 + ($x | length) <= $n then .[-1] += " " + $x
	else . + [$x[0:$n]] end);
def field($label; $text; $color; $lines):
	($text | one) as $t
	| if $t == "" then empty else
		($t | wrap([$w - 11, 20] | max)) as $ls
		| ($ls[0:$lines] | to_entries[]
			| (if .key == 0 then $dim + ($label + "           ")[0:11] + $off else "           " end)
			  + $color + .value + $off
			  + (if .key == $lines - 1 and ($ls | length) > $lines then $dim + " …" + $off else "" end))
	  end;
'

# The card of the lost thread whose session id is $1, under TITLE $2: what it
# was asked and last said, where, and the keys that act on it.
lost_card() {
	local f="" g
	for g in "$LOST_DIR"/*_"$1".json; do [ -f "$g" ] && f=$g && break; done
	[ -n "$f" ] || return 0
	[ -n "${2:-}" ] &&
		printf '%s%s%s%s%s%s\n' "$C_BOLD" "${2%% · *}" "$C_OFF" "$C_DIM" "${2#"${2%% · *}"}" "$C_OFF"
	jq -r --argjson now "$(date +%s)" --argjson w "${FZF_PREVIEW_COLUMNS:-80}" --arg home "$HOME" \
		--arg grey "$C_GREY" --arg dim "$C_DIM" --arg off "$C_OFF" "$JQ_CARD$JQ_LOST"'
		def tilde: if . == $home then "~" elif startswith($home + "/") then "~" + .[($home | length):] else . end;
		def tail($n): if length > $n then "…" + .[(length - $n + 1):] else . end;
		[ "lost" + $dim + " · " + $off + (($now - (.lost // $now)) | age) + $dim + " · its session went" + $off,
		  "",
		  field("asked"; .thread.task // .state.prompt // ""; ""; 4),
		  (if (.state.last_message // "") != "" then field("said"; .state.last_message; $grey; 6) else empty end),
		  field("in"; lost_dir | tilde | tail([$w - 11, 20] | max); $grey; 1),
		  field("session"; (lost_skey | sub("^tmux-"; "")) + " · " + (.state.session_id // ""); $dim; 2),
		  "",
		  $dim + "⏎ resume it in a new tab   x forget it" + $off
		] | .[]' "$f" 2>/dev/null
}

# The dashboard's preview for agent PANE: its resume card under TITLE (name ·
# repo/branch · turn), or (s, tab) its screen, or (?) the keys; for a lost
# thread (PANE is its session id), its card. The view is kept next to the
# dashboard's socket.
cmd_preview() {
	local pane=${1#terminal_} title=${2:-} id=${3:-} view=card f line root re_r='"root":"([^"]*)"' n=0
	local head="" ab="" changed=0 new=0 lines=${FZF_PREVIEW_LINES:-40}
	[ -n "${FZF_SOCK:-}" ] && { IFS= read -r view <"${FZF_SOCK%.sock}.view"; } 2>/dev/null
	# A lost thread (its item's id l…, or without one, its session id).
	case $id:$pane in
	l*:* | :*[!0-9]*)
		if [ "$view" = help ]; then ls_help; else lost_card "$pane" "$title"; fi
		return 0
		;;
	esac
	case $view in
	help)
		ls_help
		return 0
		;;
	screen)
		[ -n "$pane" ] || return 0
		# Whose screen it is, then as much of its end as fits.
		printf '%sscreen · %s%s%s%s%s\n' "$C_DIM" "$C_OFF$C_BOLD" "${title%% · *}" "$C_OFF" "$C_DIM${title#"${title%% · *}"}" "$C_OFF"
		mux_screen "$pane" |
			awk 'NF { last = NR } { l[NR] = $0 } END { s = last - '"$((lines - 1))"' + 1; if (s < 1) s = 1; for (i = s; i <= last; i++) print l[i] }'
		return 0
		;;
	esac
	if [ -z "$pane" ]; then
		ls_intro
		return 0
	fi
	state_file "$pane"
	if [ ! -f "$SF" ]; then
		# A thread whose agent has not reported yet: its record.
		SF="$STATE_DIR/${SKEY}_$pane.thread" re_r='"worktree":"([^"]*)"'
		[ -f "$SF" ] || return 0
	fi
	[ -n "$title" ] &&
		printf '%s%s%s%s%s%s\n' "$C_BOLD" "${title%% · *}" "$C_OFF" "$C_DIM" "${title#"${title%% · *}"}" "$C_OFF"
	line=""
	{ IFS= read -r line <"$SF"; } 2>/dev/null
	[[ $line =~ $re_r ]] && root=${BASH_REMATCH[1]}
	# Other agents in the same worktree: their turn diffs mix.
	session_files json
	for f in ${FOUND[@]+"${FOUND[@]}"}; do
		[ "$f" = "$SF" ] && continue
		line=""
		{ IFS= read -r line <"$f"; } 2>/dev/null
		[[ $line =~ $re_r ]] && [ "${BASH_REMATCH[1]}" = "$root" ] && n=$((n + 1))
	done
	# The worktree in one line: branch, ahead/behind, changes.
	if [ -n "${root:-}" ] && [ -d "$root" ]; then
		while IFS= read -r line; do
			case $line in
			"# branch.head "*) head=${line#\# branch.head } ;;
			"# branch.ab "*)
				line=${line#\# branch.ab }
				case $line in "+0 -0") ;; *) ab=$line ;; esac
				;;
			"? "*) new=$((new + 1)) ;;
			[12u]" "*) changed=$((changed + 1)) ;;
			esac
		done <<EOF2
$(GIT_OPTIONAL_LOCKS=0 git -C "$root" status --porcelain=v2 --branch 2>/dev/null)
EOF2
	fi
	jq -r --argjson now "$(date +%s)" --argjson w "${FZF_PREVIEW_COLUMNS:-80}" \
		--arg head "$head" --arg ab "$ab" --argjson changed "$changed" --argjson new "$new" --argjson shared "$n" \
		--arg red "$C_RED" --arg green "$C_GREEN" --arg grey "$C_GREY" --arg dim "$C_DIM" --arg off "$C_OFF" \
		--arg gseen "$G_SEEN" --arg gidle "$G_IDLE" "$JQ_CARD"'
		(if has("state") | not then {state: "starting", since: .created, prompt: .task, agent: .agent} else . end)
		| (.state // "idle") as $st
		| (.seen // false) as $seen
		| ($now - (.since // .ts // $now)) as $for
		| ($st | if . == "needs-you" then $red + "needs you" + $off
			elif . == "done" then (if $seen then "done" else $green + "done" + $off end)
			else . end) as $word
		| [ $word + $dim + " · " + $off + ($for | age)
			+ (if (.agent // "claude") != "claude" then $dim + " · " + $off + .agent else "" end),
		    "",
		    field("asked"; .prompt // ""; ""; 4),
		    (if $st == "needs-you" then field("waits"; .waiting // "you"; ""; 3) else empty end),
		    (if (.background // 0) > 0 then field("background"; .background_tasks // ""; ""; 2) else empty end),
		    (if (.last_message // "") != "" and $st != "working" then field("said"; .last_message; $grey; 6) else empty end),
		    (if ((.tasks // []) | length) > 0 then
		       field("tasks"; (.tasks[-12:] | map((if .done then $gseen + " " else $gidle + " " end) + .subject | one | gsub(" "; "\u00a0")) | join("\u00a0 ")); ""; 3)
		     else empty end),
		    (if ((.subagents // []) | length) > 0 then
		       field("subagents"; ((.subagents // []) | map(.type + " " + (($now - (.since // $now)) | age)) | join(" · ")); ""; 2)
		     else empty end),
		    (if ((.files // []) | length) > 0 then
		       field("files"; ((.files // [])[-6:] | reverse | map(base | gsub(" "; "\u00a0")) | join("\u00a0 "))
		         + (if (.files | length) > 6 then "\u00a0 +\((.files | length) - 6)" else "" end); $grey; 2)
		     else empty end),
		    (if $head != "" then
		       field("git"; $head + (if $ab != "" then " " + $ab else "" end)
		         + (if $changed + $new == 0 then " · clean"
		            else (if $changed > 0 then " · \($changed) changed" else "" end) + (if $new > 0 then " · \($new) new" else "" end) end); $dim; 1)
		     else empty end),
		    (if $shared > 0 then field("shared"; "\($shared + 1) agents work in this worktree: their turn diffs mix"; $dim; 2) else empty end)
		  ] | .[] | gsub("\u00a0"; " ")' "$SF" 2>/dev/null
}

# The empty board's preview: how to start.
ls_intro() {
	local d=$C_DIM g=$C_GREY o=$C_OFF
	cat <<EOF2
No agents in this session yet.

${g}n$o       start a thread: a task, its worktree, and a tab with
        nvim and the agent ${d}(weaver new)$o
${g}Alt N$o   the same from anywhere in the session

${d}Or start claude or codex in any pane: weaver follows it
through its hooks.$o
EOF2
}

# The keys and glyphs, for the dashboard's ? view.
ls_help() {
	local d=$C_DIM g=$C_GREY o=$C_OFF
	cat <<EOF2
${g}keys$o
  ${g}⏎  1-9${o}      jump to the thread ${d}(1-9: that row)$o
  ${g}j k  g G$o    move; first, last
  $g/$o           search ${d}(esc: back)$o
  ${g}n$o           new thread ${d}(weaver new)$o
  ${g}x$o           close the thread, its nvim and its tab
              ${d}(and offers to remove a merged worktree)$o
  ${g}e  ^e$o       jump and open its nvim
  ${g}s  tab$o      resume card ↔ screen
  ${g}^r$o          reload
  $g?$o           this help ${d}(? again: back)$o
  ${g}q  esc$o      close the dashboard
  ${g}^q$o          quit the session, every agent and nvim ${d}(the threads$o
              ${d}come back as weaver starts; weaver quit asks first)$o

${g}threads$o
  $(paint "$G_NEED" "$C_RED"; printf %s "$PAINT")  needs you    $(paint "$G_DONE" "$C_GREEN"; printf %s "$PAINT")  done, not yet seen    $(paint "$G_WORK" "$g"; printf %s "$PAINT")  working
  $(paint "$G_SEEN" "$d"; printf %s "$PAINT")  done, seen   $(paint "$G_IDLE" "$d"; printf %s "$PAINT")  idle    $(paint "$G_INT" "$g"; printf %s "$PAINT")  interrupted

  ${d}×2$o  ${d}two agents share the worktree: their turn diffs mix$o

${g}lost$o ${d}(its session went: a crash, or quit)$o
  ${g}⏎$o           resume it in a new tab ${d}(weaver resume)$o
  ${g}x$o           forget it ${d}(its worktree stays)$o
EOF2
}

# The preview's next view, as fzf actions (a transform): `weaver _view
# screen` (s, tab) goes card, screen, card; `weaver _view help` (?) shows the
# keys, and again goes back to the card. When the card is hidden for want of
# room, either shows it (over the list), and s after the screen hides it
# again. The view is kept next to the dashboard's socket.
cmd_view() {
	local f cur="" hidden="" next
	[ -n "${FZF_SOCK:-}" ] || return 0
	f=${FZF_SOCK%.sock}.view
	{ IFS= read -r cur <"$f"; } 2>/dev/null
	[ "${FZF_PREVIEW_LINES:-0}" = 0 ] && hidden=1
	case $1:$cur in
	screen:screen | help:help) next="" ;;
	*) next=$1 ;;
	esac
	if [ -n "$hidden" ]; then
		# Shown on request: the card first.
		[ "$1" = screen ] && next=""
		ls_size border
		printf 'change-preview-window(down,%d,border-top,wrap)+' $((LS_LINES / 2))
	elif [ "$1:$cur" = screen:screen ] && [ -f "${FZF_SOCK%.sock}.tight" ]; then
		printf 'hide-preview+'
	fi
	if [ -n "$next" ]; then printf '%s\n' "$next" >"$f"; else rm -f "$f"; fi
	printf 'refresh-preview+transform-footer(%s _footer)\n' "$(printf '%q' "$SELF")"
}

# The dashboard's header (a transform): with no agents, what to do; else a
# blank line while browsing, whose place the search input takes, so nothing
# moves. (The title is on fzf's border.)
ls_title() {
	local f="${FZF_SOCK:-}" t=""
	f=${f%.sock}.title
	t=$(cat "$f" 2>/dev/null)
	if [ -n "$t" ]; then
		printf '%s\n' "$t"
	elif [ "${FZF_INPUT_STATE:-hidden}" = hidden ]; then
		printf '%s\n' "$C_OFF"
	fi
}

# What a reload changes besides the list (a transform on fzf's load): the
# header, the footer, the title on the border, and the card's room when the
# reload changed it (ls_card_room).
ls_chrome() {
	local base=${FZF_SOCK%.sock} pw="" last="" q
	# The home board, with a newer weaver installed since it started: it ends,
	# for cmd_ls to start it again in that weaver (the reload that brought
	# this here showed the new weaver's rows, which the old keys may not know).
	if [ -n "${LS_HOME:-}" ] && [ -f "$base.born" ] && [ "$SELF" -nt "$base.born" ]; then
		echo abort
		return 0
	fi
	q=$(printf '%q' "$SELF")
	printf 'transform-header(%s _title)+transform-footer(%s _footer)' "$q" "$q"
	{ IFS= read -r pw <"$base.room"; } 2>/dev/null
	{ IFS= read -r last <"$base.shown"; } 2>/dev/null
	if [ -n "$pw" ] && [ "$pw" != "$last" ]; then
		printf '%s\n' "$pw" >"$base.shown"
		printf '+change-preview-window(%s)' "$pw"
	fi
	printf '+change-border-label:%s\n' "$(cat "$base.label" 2>/dev/null)"
}

# Jump to pane PANE in tab TAB and count it as seen.
jump_to() {
	focus_pane "$1" "$2"
	mark_seen "$1"
}

# The dashboard's footer: the keys that work now (browsing, or searching when
# fzf's input shows), as many as fit the list's width, ? always last.
ls_footer() {
	local width k w item out="" end="" g=$C_GREY d=$C_DIM o=$C_OFF IFS='|'
	local browse='⏎ JUMP|1-9|n NEW|x CLOSE|/ SEARCH|s SCREEN|e NVIM|^q QUIT' search='⏎ JUMP|esc BACK|tab SCREEN|^e NVIM'
	# The card hidden for want of room: s shows it.
	[ -n "${FZF_SOCK:-}" ] && [ -f "${FZF_SOCK%.sock}.tight" ] && [ "${FZF_PREVIEW_LINES:-0}" = 0 ] &&
		browse='⏎ JUMP|1-9|n NEW|x CLOSE|/ SEARCH|s CARD|e NVIM|^q QUIT'
	ls_utf8
	ls_size border
	ls_width
	width=$((LS_WIDTH - 6)) w=0
	if [ -n "${FZF_INPUT_STATE:-}" ] && [ "$FZF_INPUT_STATE" != hidden ]; then
		set -- $search
	elif [ "${LS_EMPTY:-}" = 1 ] || [ "${FZF_TOTAL_COUNT:-1}" = 0 ]; then
		if [ -n "${LS_HOME:-}" ]; then set -- 'n NEW THREAD' '^q QUIT'; else set -- 'n NEW THREAD' 'q BACK' '^q QUIT'; fi
		end="" w=0
	else
		set -- $browse
		end="${g}?$o ${d}HELP$o" w=6
	fi
	for item in "$@"; do
		[ $((w + ${#item} + 2)) -le $width ] || break
		k=${item%% *}
		if [ "$k" = "$item" ]; then out="$out$g$k$o  "; else out="$out$g$k$o $d${item#* }$o  "; fi
		w=$((w + ${#item} + 2))
	done
	printf '%s\n' "$out$end"
}

# The dashboard's keys while browsing; searching (/) unbinds them so they type.
LS_KEYS='j,k,g,G,n,x,e,s,q,?,/,1,2,3,4,5,6,7,8,9'

# The home tab's board (`weaver home`): the dashboard, full-size and for good.
# Jumping leaves it running behind you; Alt y comes back to it. As the weaver
# session starts, the threads it lost when it last went (a crash, or zellij
# quit) come back first, unless WEAVER_RESTORE=0 (then the board lists them).
cmd_home() {
	need_session
	if weaver_session; then
		gc_states quiet
		[ "${WEAVER_RESTORE:-1}" != 0 ] && resume_session
		# The counts the status line shows may be a session that went's,
		# and the tabs' labels too.
		push_status labels
	fi
	LS_HOME=1 cmd_ls
}

cmd_ls() {
	local out key sel pane tab q fzf=0 sock base rc sh=/bin/sh rows foot items=0
	local jump_act edit_act new_act quit_act resume_act
	need_session
	command -v fzf >/dev/null 2>&1 && [ -t 1 ] && fzf=1
	if [ $fzf = 0 ]; then
		LS_MODE=plain ls_rows
		return 0
	fi
	q=$(printf '%q' "$SELF")
	[ -x /bin/dash ] && sh=/bin/dash
	# The dashboard ends with a key and cmd_ls acts; the home board stays.
	if [ -n "${LS_HOME:-}" ]; then
		jump_act="execute-silent($q _goto {2} {3})"
		edit_act="execute-silent($q _goto {2} {3}; $q edit {2})"
		# fzf skips any action whose template names a field, such as {2}, on
		# an empty board: this one prints the field for the action it returns.
		new_act="transform:if [ \"\$FZF_TOTAL_COUNT\" = 0 ]; then echo 'execute($q new)+reload($q _rows)'; else printf '%s2})+reload(%s _rows)\\n' 'execute($q new --from {' '$q'; fi"
		# q and esc: back to the thread you came from, as Alt y does.
		quit_act="execute-silent($q go home)"
		resume_act="execute($q resume {2})+reload($q _rows)"
		export LS_HOME
	else
		jump_act="print(jump)+accept"
		edit_act="print(ctrl-e)+accept"
		new_act="print(new)+accept"
		quit_act=abort
		resume_act="print(resume)+accept"
	fi
	export LS_JUMP=$jump_act
	mkdir -p "$SOCK_DIR" && chmod 700 "$SOCK_DIR"
	# Hooks reload this dashboard through its socket as agents change.
	base="$SOCK_DIR/${SKEY}.fzf.$$"
	sock="$base.sock"
	# Its files go with it, also when its pane is closed under it.
	trap 'rm -f "$sock" "$base".keys "$base".view "$base".title "$base".label "$base".room "$base".shown "$base".tight "$base".vp "$base".born' EXIT
	trap 'exit 129' HUP
	trap 'exit 143' TERM
	# The home board outlives installs of weaver: when it started, for
	# ls_chrome to tell that a newer weaver is installed under it.
	[ -n "${LS_HOME:-}" ] && : >"$base.born"
	ls_utf8
	while :; do
		rm -f "$sock" "$base".keys "$base".view "$base".title "$base".label "$base".room "$base".shown "$base".tight "$base".vp
		# Fits the pane, and leaves the title, the header and the card's
		# room next to the socket.
		rows=$(FZF_SOCK=$sock ls_rows)
		items=0
		[ -n "$rows" ] && items=$(printf '%s\n' "$rows" | wc -l)
		if [ "$items" -gt 0 ]; then foot=$(ls_footer); else foot=$(LS_EMPTY=1 ls_footer); fi
		LS_PW=$(cat "$base.room" 2>/dev/null)
		printf '%s\n' "$LS_PW" >"$base.shown"
		# A heading or gap never keeps the cursor: it moves on to the agent
		# beyond, in the direction it was going. The title is fzf's header,
		# above the search input (which takes the blank line below it).
		out=$({ [ "$items" -gt 0 ] && printf '%s\n' "$rows"; } | fzf --listen "$sock" --with-shell "$sh -c" \
			--track --id-nth 1 --delimiter "$TAB" --with-nth 7.. --nth 2 --tabstop 1 --no-sort --ansi --layout reverse \
			--no-input --header "$(FZF_SOCK=$sock ls_title)" --header-first \
			--border sharp --border-label "$(cat "$base.label" 2>/dev/null)" --border-label-pos 3 \
			--highlight-line --pointer ' ' --marker ' ' --ellipsis '…' \
			--no-scrollbar --footer "$foot" --footer-border none \
			--color "$FZF_COLORS" \
			--prompt '/ ' --ghost 'search threads' --info hidden --no-separator \
			--preview "$q _preview {2} {6} {1}" --preview-window "${LS_PW:-down,50%,border-top,wrap,hidden}" \
			--bind "resize:reload(LS_REMEASURE=1 $q _rows)" --bind "load:transform($q _chrome)" \
			--bind "focus:transform:case {1} in a*) ;; *) case \$FZF_ACTION in up|page-up|half-page-up|offset-up|scroll-up|up-match|prev-*) t={4}; [ -n \"\$t\" ] || t={5} ;; *) t={5}; [ -n \"\$t\" ] || t={4} ;; esac; [ -n \"\$t\" ] && echo \"pos(\$t)\" ;; esac" \
			--bind "j:down,k:up,g,home:first,G,end:last,q:$quit_act" \
			--bind "enter,double-click:transform:case {1} in a*) echo '$jump_act' ;; l*) echo '$resume_act' ;; esac" \
			--bind "1:transform(sed -n 1p '$base.keys'),2:transform(sed -n 2p '$base.keys'),3:transform(sed -n 3p '$base.keys')" \
			--bind "4:transform(sed -n 4p '$base.keys'),5:transform(sed -n 5p '$base.keys'),6:transform(sed -n 6p '$base.keys')" \
			--bind "7:transform(sed -n 7p '$base.keys'),8:transform(sed -n 8p '$base.keys'),9:transform(sed -n 9p '$base.keys')" \
			--bind "n:$new_act" \
			--bind "x:transform:case {1} in a*) echo 'execute($q close {2})+reload($q _rows)' ;; l*) echo 'execute($q resume --forget {2})+reload($q _rows)' ;; esac" \
			--bind "e,ctrl-e:transform:case {1} in a*) echo '$edit_act' ;; esac" \
			--bind "s,tab:transform($q _view screen)" \
			--bind "?:transform($q _view help)" \
			--bind "ctrl-r:reload($q _rows)+refresh-preview" \
			--bind "/:show-input+unbind($LS_KEYS)+transform-header($q _title)+transform-footer($q _footer)" \
			--bind "esc:clear-query+transform{if [ \"\$FZF_INPUT_STATE\" = hidden ]; then echo '$quit_act'; else echo 'hide-input+rebind($LS_KEYS)+transform-header($q _title)+transform-footer($q _footer)'; fi}")
		rc=$?
		rm -f "$sock" "$base".keys "$base".view "$base".title "$base".label "$base".room "$base".shown "$base".tight "$base".vp
		if [ -n "${LS_HOME:-}" ]; then
			# The home board does not end: ctrl-c starts it again. Not
			# without its terminal (the pane or the session closed).
			[ $rc = 2 ] && return 0
			{ : </dev/tty; } 2>/dev/null || return 0
			# A newer weaver is installed (ls_chrome ended the board for
			# it): the board starts again in it, whose keys know its rows.
			if [ "$SELF" -nt "$base.born" ]; then
				rm -f "$base.born"
				exec env LS_HOME=1 "$SELF" ls
			fi
			sleep 0.2
			continue
		fi
		[ -n "$out" ] || return 0
		# A key fzf printed (print), then the item; the key alone on an
		# empty board; a bare item when fzf accepted on its own (a double
		# click).
		case $out in
		*"$NL"*) key=${out%%"$NL"*} sel=${out#*"$NL"} ;;
		new | jump | ctrl-e) key=$out sel="" ;;
		*) key=jump sel=$out ;;
		esac
		pane="" tab=""
		case $sel in
		a* | l*)
			[ "${sel%"${sel#?}"}" = l ] && key=resume
			sel=${sel#*"$TAB"}
			pane=${sel%%"$TAB"*}
			sel=${sel#*"$TAB"}
			tab=${sel%%"$TAB"*}
			;;
		esac
		# A lost thread: back in a new tab (where you land).
		if [ "$key" = resume ]; then
			[ -n "$pane" ] && "$SELF" resume "$pane"
			return
		fi
		if [ "$key" = new ]; then
			"$SELF" new ${pane:+--from "$pane"}
			rc=$?
			[ $rc = 0 ] && return 0
			[ $rc = 130 ] || sleep 1.5
			continue
		fi
		[ -n "$pane" ] || return 0
		jump_to "$pane" "$tab"
		push_status
		[ "$key" = ctrl-e ] && exec "$SELF" edit "$pane"
		return 0
	done
}

# ---------------------------------------------------------------- sidebar
#
# The thread sidebar (`weaver sidebar`): a narrow pane at the left of each
# thread tab in the weaver session, every agent of the session in its
# thread's stable order (its number; agents without one after), the tab's own
# thread inverted. j/k move, enter or 1-9 go to a thread. The hooks reload it
# as they reload the dashboard; a tick keeps its ages current.

# The session's agents, as agent_rows has them, kept by push_status for the
# sidebars (one agent_rows per change, not one per sidebar), into SIDE_ROWS.
side_cache() { SIDE_ROWS="$STATE_DIR/$SKEY.rows" SIDE_ORDER="$STATE_DIR/$SKEY.order"; }
side_cache_write() {
	side_cache
	agent_rows
	side_order
	mkdir -p "$STATE_DIR"
	printf '%s' "$AGENT_ROWS" >"$SIDE_ROWS.$$" && mv -f "$SIDE_ROWS.$$" "$SIDE_ROWS"
	printf '%s' "$THREAD_ORDER" >"$SIDE_ORDER.$$" && mv -f "$SIDE_ORDER.$$" "$SIDE_ORDER"
}
# The weaver session's order (thread_order, from the layout's side) for the
# PANES agent_rows just listed; empty outside the weaver session, whose tabs
# are in no particular order.
side_order() {
	THREAD_ORDER=""
	type thread_order >/dev/null 2>&1 && type weaver_session >/dev/null 2>&1 && weaver_session && thread_order
	return 0
}

# A state's glyph, in its colour, into GLYPH, and plain, into GCHAR (the
# dashboard's shapes).
glyph_of() {
	local c k=$C_DIM
	if [ "$1" = tab ]; then
		GCHAR=" · " GLYPH="$C_DIM · $C_OFF" GMARK="${C_DIM}·$C_OFF"
		return 0
	fi
	state_cell "$1"
	c=$GCELL
	case $1 in
	needs-you) k=$C_RED ;;
	done) [ "$2" = true ] || k=$C_GREEN ;;
	working | starting | interrupted) k=$C_GREY ;;
	esac
	paint "$c" "$k"
	GCHAR=$c GLYPH=$PAINT GMARK="$k${c:1:1}$C_OFF"
}

# The sidebar's items, NUL-separated (fzf --read0): "id<TAB>pane<TAB>tab<TAB>"
# then one line (number, glyph, name, age), and a second, faint, for an agent
# that needs you (what it waits on). Under 16 columns, a rail: number and
# glyph. The thread of tab $WEAVER_SIDE_TAB is inverted. With --cached, the
# rows push_status kept. Into $FZF_SOCK's .keys, the actions for 1-9 (by
# thread number) and .cur, the current thread's position.
side_rows() {
	local now n=0 i j a=0 cur="" numw=2 w rail="" name line2 key out base num pl e=0 kind label
	local pane tab state root since seen prompt waiting title tnum ttask agent pos=" "
	local -a k_key k_pane k_tab k_state k_seen k_name k_wait k_since k_num order
	local -a keyl=("" "" "" "" "" "" "" "" "" "")
	ls_utf8
	# Under fzf, the pane's own width (fzf's can lag behind a swap of the
	# layout).
	w=""
	[ -n "${FZF_SOCK:-}" ] && w=$({ stty size </dev/tty; } 2>/dev/null) && w=${w#* }
	case $w in '' | *[!0-9]* | 0)
		ls_size
		w=$LS_COLS
		;;
	esac
	[ "$w" -lt 16 ] && rail=1
	side_cache
	if [ "${1:-}" = --cached ] && [ -f "$SIDE_ROWS" ]; then
		AGENT_ROWS=$(cat "$SIDE_ROWS")
		THREAD_ORDER=$(cat "$SIDE_ORDER" 2>/dev/null)
	else
		agent_rows
		side_order
	fi
	now=$(date +%s)
	# The layout's order, where there is one: each entry's place, and the
	# tabs without an agent as rows of their own.
	while IFS=$US read -r kind tnum tab pane label; do
		[ -n "$kind" ] || continue
		e=$((e + 1))
		if [ "$kind" = tab ]; then
			printf -v key '0%08d' "$e"
			k_key[n]=$key k_pane[n]="" k_tab[n]=$tab k_state[n]=tab k_seen[n]="" k_name[n]=$label
			k_wait[n]="" k_since[n]="" k_num[n]=""
			n=$((n + 1))
		else
			printf -v key '%s%s=%08d ' "$pos" "$pane" "$e"
			pos="$key"
		fi
	done <<EOF2
$THREAD_ORDER
EOF2
	while IFS=$US read -r pane tab state root since seen prompt waiting _ title _ _ _ _ _ _ _ _ _ _ _ agent _ \
		ttask _ tnum _; do
		[ -n "$pane" ] || continue
		case $since in '' | *[!0-9]*) since=$now ;; esac
		case $tnum in '' | *[!0-9]*) tnum="" ;; esac
		name=${title:-${ttask:-$prompt}}
		[ -n "$name" ] || name="new ${agent:-claude} session"
		# Its place in the layout's order; else by number, then by pane.
		case $pos in
		*" $pane="*)
			key=${pos#*" $pane="}
			key=0${key%% *}
			;;
		*) if [ -n "$tnum" ]; then printf -v key '1%08d' "$tnum"; else printf -v key '2%08d' "$pane"; fi ;;
		esac
		k_key[n]=$key k_pane[n]=$pane k_tab[n]=$tab k_state[n]=$state k_seen[n]=$seen k_name[n]=$name
		k_wait[n]=$waiting k_since[n]=$since k_num[n]=$tnum
		[ ${#tnum} -gt $numw ] && numw=${#tnum}
		n=$((n + 1))
	done <<EOF2
$AGENT_ROWS
EOF2
	i=0
	while [ $i -lt $n ]; do
		j=${#order[@]}
		while [ $j -gt 0 ] && [[ ${k_key[order[j - 1]]} > ${k_key[i]} ]]; do
			order[j]=${order[j - 1]}
			j=$((j - 1))
		done
		order[j]=$i
		i=$((i + 1))
	done
	for i in ${order[@]+"${order[@]}"}; do
		a=$((a + 1))
		case ${k_num[i]} in [1-9]) keyl[k_num[i]]="execute-silent($(printf '%q' "$SELF") _goto ${k_pane[i]} ${k_tab[i]})" ;; esac
		glyph_of "${k_state[i]}" "${k_seen[i]}"
		num=${k_num[i]}
		[ -n "$num" ] && printf -v num '%02d' "$num"
		printf -v num '%*s ' "$numw" "$num"
		line2=""
		if [ -n "$rail" ]; then
			# Two columns: number and glyph, touching.
			[ "$w" -lt 3 ] && num=${num% }
			pl="$num${GCHAR:1:1}" out="$C_DIM$num$C_OFF$GMARK"
		elif [ "${k_state[i]}" = tab ]; then
			# A tab without an agent: its name, faint; a long one (a path)
			# keeps its end.
			label=${k_name[i]}
			[ ${#label} -gt $((w - numw - 7)) ] && label="…${label:$((${#label} - (w - numw - 8)))}"
			fit "$label" $((w - numw - 7))
			pl="$num$GCHAR  $FIT" out="$C_DIM$num$GLYPH  $C_DIM$FIT$C_OFF"
		else
			age $((now - k_since[i]))
			fit "${k_name[i]}" $((w - numw - 11))
			printf -v pl '%s%s  %s %3s' "$num" "$GCHAR" "$FIT" "$AGE"
			printf -v out '%s%s%s%s  %s %s%3s%s' "$C_DIM" "$num" "$C_OFF" "$GLYPH" "$FIT" "$C_DIM" "$AGE" "$C_OFF"
			if [ "${k_state[i]}" = needs-you ] && [ -n "${k_wait[i]}" ]; then
				fit "${k_wait[i]}" $((w - numw - 7))
				printf -v line2 '%*s%s' $((numw + 6)) '' "$FIT"
			fi
		fi
		if [ "${k_tab[i]}" = "${WEAVER_SIDE_TAB:-x}" ] && [ -z "$cur" ]; then
			# The tab's own thread: inverted, the whole width.
			cur=$a
			printf -v out '\033[7m%s%*s\033[27m' "$pl" $((w > ${#pl} ? w - ${#pl} : 0)) ''
			[ -n "$line2" ] && printf -v line2 '\033[7m%s%*s\033[27m' "$line2" $((w > ${#line2} ? w - ${#line2} : 0)) ''
		elif [ -n "$line2" ]; then
			line2="$C_DIM$line2$C_OFF"
		fi
		if [ -n "${k_pane[i]}" ]; then key="a${k_pane[i]}"; else key="t${k_tab[i]}"; fi
		printf '%s\t%s\t%s\t%s%s\0' "$key" "${k_pane[i]}" "${k_tab[i]}" "$out" "${line2:+$NL$line2}"
	done
	[ -n "${FZF_SOCK:-}" ] || return 0
	base=${FZF_SOCK%.sock}
	out=""
	for i in 1 2 3 4 5 6 7 8 9; do out="$out${keyl[i]}$NL"; done
	printf '%s' "$out" >"$base.keys.$$" && mv -f "$base.keys.$$" "$base.keys"
	printf '%s\n' "${cur:+pos($cur)}" >"$base.cur"
}

# In the weaver session (its layout says so in $STATE_DIR/<skey>.layout), a
# thread's tab is its line on the status bar: "<num> <name> · <repo>/<branch>"
# (zjstatus, or tmux's status line, shows the current tab's name). From
# AGENT_ROWS and the PANES they came from; a tab is renamed only when its name
# is not its label already (tab ids start again with the multiplexer's server,
# so what it is called now decides, not what weaver last called it).
thread_tab_labels() {
	local pane tab state root prompt title ttask tnum label names
	weaver_session || return 0
	ls_utf8
	names=$(printf '%s' "${PANES:-[]}" | jq -r '[.[] | select(.is_plugin | not)
		| "\(.tab_id)\t\(.tab_name // "" | gsub("[\t\n]"; " "))"] | unique | .[]' 2>/dev/null)
	while IFS=$US read -r pane tab state root _ _ prompt _ _ title _ _ _ _ _ _ _ _ _ _ _ _ _ ttask _ tnum _; do
		[ -n "$pane" ] && [ -n "$tnum" ] || continue
		label=${title:-${ttask:-$prompt}}
		label=${label%%"$NL"*}
		fit "$label" 30
		label=${FIT%"${FIT##*[! ]}"}
		where_of "$root"
		printf -v tnum '%02d' "$tnum"
		label="$tnum $label · $W_REPO${W_BRANCH:+/$W_BRANCH}"
		case "$NL$names$NL" in *"$NL$tab$TAB$label$NL"*) continue ;; esac
		mux_rename_tab "$tab" "$label"
	done <<EOF2
$AGENT_ROWS
EOF2
}

# Go to agent PANE in tab TAB from the sidebar or the home tab (they stay);
# with no PANE, to the tab.
cmd_goto() {
	if [ -z "${1:-}" ]; then
		mux_go_tab "${2:-}"
		return 0
	fi
	jump_to "$1" "$2"
	push_status
}

cmd_sidebar() {
	local q sh=/bin/sh sock base tick="" parent rc
	need_session
	command -v fzf >/dev/null 2>&1 || die "the sidebar needs fzf"
	q=$(printf '%q' "$SELF")
	[ -x /bin/dash ] && sh=/bin/dash
	mkdir -p "$SOCK_DIR" && chmod 700 "$SOCK_DIR"
	base="$SOCK_DIR/${SKEY}.side.${MY_PANE:-$$}"
	sock="$base.sock"
	# Its own tab: the thread it shows inverted.
	list_panes
	WEAVER_SIDE_TAB=$(printf '%s' "${PANES:-[]}" | jq -r --arg p "${MY_PANE:-}" \
		'map(select((.is_plugin | not) and (.id | tostring) == $p)) | .[0].tab_id // empty' 2>/dev/null)
	export WEAVER_SIDE_TAB
	trap 'rm -f "$sock" "$base".keys "$base".cur; [ -n "$tick" ] && kill "$tick" 2>/dev/null' EXIT
	trap 'exit 129' HUP
	trap 'exit 143' TERM
	# The ages move on: a reload every 15 s, from the rows the hooks keep;
	# not past the sidebar itself.
	parent=$$
	(
		while sleep 15; do
			kill -0 "$parent" 2>/dev/null || exit 0
			[ -S "$sock" ] && curl -s -m 1 --unix-socket "$sock" -X POST -d "reload($q _side --cached)" \
				http://localhost >/dev/null 2>&1
		done
	) </dev/null >/dev/null 2>&1 &
	tick=$!
	# Open or a rail, by the window's width (the layout's swap layouts).
	"$SELF" _sidefit </dev/null >/dev/null 2>&1
	while :; do
		rm -f "$sock"
		FZF_SOCK=$sock side_rows | fzf --read0 --listen "$sock" --with-shell "$sh -c" --ansi \
			--no-input --no-sort --layout reverse --track --id-nth 1 --delimiter "$TAB" --with-nth 4.. \
			--info hidden --no-scrollbar --no-separator --pointer '' --marker '' --gap 0 \
			--color 'fg:-1,bg:-1,fg+:-1:regular,bg+:-1,hl:-1,hl+:-1,gutter:-1,pointer:#ffffff' \
			--bind "load:transform(cat '$base.cur')" \
			--bind "resize:execute-silent($q _sidefit)+reload($q _side --cached)" \
			--bind 'j:down,k:up,g:first,G:last,esc:ignore,q:ignore' \
			--bind "enter,double-click:execute-silent($q _goto {2} {3})" \
			--bind "1:transform(sed -n 1p '$base.keys'),2:transform(sed -n 2p '$base.keys'),3:transform(sed -n 3p '$base.keys')" \
			--bind "4:transform(sed -n 4p '$base.keys'),5:transform(sed -n 5p '$base.keys'),6:transform(sed -n 6p '$base.keys')" \
			--bind "7:transform(sed -n 7p '$base.keys'),8:transform(sed -n 8p '$base.keys'),9:transform(sed -n 9p '$base.keys')" \
			>/dev/null
		rc=$?
		# ctrl-c starts it again; with its terminal gone (the pane or the
		# session closed, under a shell that kept the hangup), it ends.
		[ $rc = 2 ] && exit 0
		{ : </dev/tty; } 2>/dev/null || exit 0
		sleep 0.2
	done
}

# Jump to the agent that has needed you longest; failing that, the one that
# finished longest ago and you haven't looked at yet. Pressed again on one of
# those, go on to the next, round and round.
cmd_next() {
	local pane tab state since seen prompt waiting title ttask tnum class list="" i=0 n=0 at=-1 pick label
	local -a c_pane c_tab c_label
	need_session
	# Pressed again while the last press is still at work: that one already
	# moves you, so this one does nothing. Before anything else, or a second
	# press could wait out the first and move you twice.
	ui_lock nowait || return 0
	agent_rows
	while IFS=$US read -r pane tab state _ since seen prompt waiting _ title _ _ _ _ _ _ _ _ _ _ _ _ _ ttask _ tnum _; do
		[ -n "$pane" ] || continue
		case $state in
		needs-you) class=0 ;;
		done) [ "$seen" = true ] && continue || class=1 ;;
		*) continue ;;
		esac
		# What tmux's message line says as you land: whose, and why.
		label=${title:-${ttask:-$prompt}}
		label=${label%%"$NL"*}
		[ ${#label} -gt 40 ] && label="${label:0:39}…"
		[ -n "$tnum" ] && printf -v label '%02d %s' "$tnum" "$label"
		if [ "$state" = needs-you ]; then label="$label · needs you${waiting:+ · ${waiting:0:50}}"; else label="$label · done"; fi
		list="$list$class$TAB$(printf '%012d' "$since")$TAB$pane$TAB$tab$TAB$label$NL"
	done <<EOF2
$AGENT_ROWS
EOF2
	if [ -z "$list" ]; then
		# From a tmux key (run-shell, no terminal): in tmux's message line.
		if [ "$MUX" = tmux ] && ! [ -t 1 ]; then
			tm display-message -d 2000 "weaver: no agent needs you" 2>/dev/null
		else
			echo "weaver: no agent needs you"
			[ -t 1 ] && sleep 1
		fi
		return 0
	fi
	# Where you are now, to go on from there (this hides the floating panes).
	list_panes
	focused_pane
	while IFS=$TAB read -r _ _ pane tab label; do
		[ -n "$pane" ] || continue
		c_pane[n]=$pane c_tab[n]=$tab c_label[n]=$label
		n=$((n + 1))
	done <<EOF2
$(printf '%s' "$list" | sort -t "$TAB" -k1,1n -k2,2n)
EOF2
	while [ $i -lt $n ]; do
		[ "${c_pane[i]}" = "$FOCUSED" ] && at=$i
		i=$((i + 1))
	done
	pick=$(((at + 1) % n))
	jump_to "${c_pane[pick]}" "${c_tab[pick]}"
	[ "$MUX" = tmux ] && tm display-message -d 2500 "weaver: [$((pick + 1))/$n] ${c_label[pick]}" >/dev/null 2>&1
	push_status
}

# ---------------------------------------------------------------- threads
#
# A thread is one task for a new agent, in a tab of its own: the agent's nvim
# on the left, the agent on the right, in a new worktree (Worktrunk, else git)
# or in the current checkout. See docs/design.md#threads.

# Where the panes of a tab being made meet: $THREADS_NEW/<skey>_<token>/ holds
# the task and the thread record until the agent's pane takes them, then the
# agent's pane id for the nvim beside it.
THREADS_NEW="$STATE_DIR/new"

# KDL string literal for $1, into K.
kdl_str() {
	local s=${1//\\/\\\\}
	s=${s//\"/\\\"}
	s=${s//$NL/\\n}
	s=${s//$TAB/\\t}
	K="\"$s\""
}

# The task $1 as a branch name, into SLUG: its first line in lowercase ASCII
# letters and digits joined by '-', at most 48 characters, cut at a '-' (as
# Rob's `wi` does).
slugify() {
	local s
	s=$(printf '%s' "${1%%"$NL"*}" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C tr -cs 'a-z0-9' '-')
	s=${s#-}
	s=${s%-}
	if [ ${#s} -gt 48 ]; then
		s=${s:0:49}
		case ${s:0:48} in *-*) s=${s%-*} ;; *) s=${s:0:48} ;; esac
	fi
	SLUG=${s%-}
}

# $1 with $HOME as ~, into TILDE.
tildify() {
	case $1 in
	"$HOME") TILDE="~" ;;
	"$HOME"/*) TILDE="~${1#"$HOME"}" ;;
	*) TILDE=$1 ;;
	esac
}

# The checkout holding directory $1 into CHECKOUT, and its repository's main
# checkout into REPO (the checkout itself for a bare repository's worktree).
# Returns 1, both empty, outside a repository.
repo_of() {
	local common
	REPO=""
	CHECKOUT=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || {
		CHECKOUT=""
		return 1
	}
	common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
	case $common in
	*/.git) REPO=${common%/.git} ;;
	*) REPO=$CHECKOUT ;;
	esac
	[ -d "$REPO" ] || REPO=$CHECKOUT
}

# Is agent $1 installed?
agent_installed() {
	agent_cmd "$1" || return 1
	command -v "${AGENT_CMD%% *}" >/dev/null 2>&1
}

# The command that runs agent $1, into AGENT_CMD: $WEAVER_CLAUDE or
# $WEAVER_CODEX (words, e.g. "claude --model opus"), else its name.
agent_cmd() {
	case $1 in
	claude) AGENT_CMD=${WEAVER_CLAUDE:-claude} ;;
	codex) AGENT_CMD=${WEAVER_CODEX:-codex} ;;
	*) return 1 ;;
	esac
}

# Repositories used for threads, most recent first, at most 20.
remember_repo() {
	local f="$STATE_DIR/repos"
	[ -n "$1" ] || return 0
	mkdir -p "$STATE_DIR"
	{
		printf '%s\n' "$1"
		[ -f "$f" ] && grep -vxF -- "$1" "$f"
	} | head -n 20 >"$f.$$" && mv -f "$f.$$" "$f"
}

# Repositories to offer, one per line as "path<TAB>name  ~/path": $1 first,
# then those of recent threads and running agents, then git repositories zoxide
# knows.
recent_repos() {
	local d
	{
		[ -n "${1:-}" ] && printf '%s\n' "$1"
		[ -f "$STATE_DIR/repos" ] && cat "$STATE_DIR/repos"
		for d in "$STATE_DIR"/*_*.json "$STATE_DIR"/*_*.thread; do
			[ -f "$d" ] || continue
			jq -r '.repo // .root // .cwd // empty' "$d" 2>/dev/null
		done | awk '!seen[$0]++' | while IFS= read -r d; do
			[ -d "$d" ] && repo_of "$d" && printf '%s\n' "$REPO"
		done
		command -v zoxide >/dev/null 2>&1 && zoxide query -l 2>/dev/null | head -n 100 |
			while IFS= read -r d; do [ -d "$d/.git" ] && printf '%s\n' "$d"; done
	} | awk 'NF && !seen[$0]++' | while IFS= read -r d; do
		[ -d "$d" ] || continue
		form_path "$d"
		printf '%s\t%s  %s%s%s\n' "$d" "${d##*/}" "$C_GREY" "$TILDE" "$C_OFF"
	done
}

# ------------------------------------------------ the new-thread form

# While the form is open its fields live in a file, one per line:
#   repo     the main checkout of the repository (empty: not in one)
#   here     the checkout (or directory) "this checkout" means
#   branch   as you edited it (empty: from the task)
#   where    worktree | here
#   agent    claude | codex
#   base     the new branch's base (empty: Worktrunk's default)
# and a long task written in $EDITOR in FILE.task.
form_load() {
	F_REPO="" F_HERE="" F_BRANCH="" F_WHERE=worktree F_AGENT=claude F_BASE=""
	{
		IFS= read -r F_REPO
		IFS= read -r F_HERE
		IFS= read -r F_BRANCH
		IFS= read -r F_WHERE
		IFS= read -r F_AGENT
		IFS= read -r F_BASE
	} <"$1" 2>/dev/null
	return 0
}
form_save() {
	printf '%s\n' "$F_REPO" "$F_HERE" "$F_BRANCH" "$F_WHERE" "$F_AGENT" "$F_BASE" >"$1.$$" && mv -f "$1.$$" "$1"
}

# The branch a thread for task $1 gets, into BRANCH.
form_branch() {
	if [ -n "$F_BRANCH" ]; then
		BRANCH=$F_BRANCH
	else
		slugify "$1"
		BRANCH=$SLUG
	fi
}

# One row of the form: label, value (plain, for widths), value (coloured), key.
form_row() {
	R_L[R_N]=$1 R_P[R_N]=$2 R_C[R_N]=$3 R_K[R_N]=$4
	[ ${#2} -gt "$R_W" ] && R_W=${#2}
	R_N=$((R_N + 1))
}

# A path as the form shows it: with ~, and only its last two parts when long.
form_path() {
	local p=${1%/*}
	tildify "$1"
	[ ${#TILDE} -gt 40 ] && TILDE="…/${p##*/}/${1##*/}"
	return 0
}

# The form's base row: where the new branch starts, and how the fetch is going.
form_base_row() {
	local v note="" pid="" rc=""
	if [ -n "$F_BASE" ]; then
		case $F_BASE in
		@) note="the HEAD of $(git -C "${F_HERE:-$F_REPO}" symbolic-ref --short -q HEAD 2>/dev/null || echo this checkout)" ;;
		^) note="the local default branch" ;;
		esac
		form_row base "$F_BASE${note:+  $note}" "$F_BASE${note:+  ${C_GREY}$note${C_OFF}}" 'alt-B'
		return 0
	fi
	[ -n "$F_REPO" ] || return 0
	if ! preferred_remote "$F_REPO"; then
		local_default "$F_REPO"
		v=${LOCAL_DEFAULT:-the default branch} note="local: no remote"
	else
		remote_default "$F_REPO" "$REMOTE"
		v=${REMOTE_DEFAULT:-$REMOTE}
		fetch_file "$F_REPO"
		{ read -r rc <"$FETCHF.rc"; } 2>/dev/null
		{ read -r pid <"$FETCHF.pid"; } 2>/dev/null
		if [ -n "$rc" ]; then
			case $rc in
			0) note="fetched" ;;
			*)
				local_default "$F_REPO"
				v=${LOCAL_DEFAULT:-the default branch} note="local: could not fetch $REMOTE"
				;;
			esac
		elif [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			note="fetching…"
		fi
	fi
	form_row base "$v${note:+  $note}" "$v${note:+  ${C_GREY}$note${C_OFF}}" 'alt-B'
}

# The form's header for form file $1 and the task typed so far $2, with error
# $3 on top: right-aligned labels under the prompt's, then the key for each.
form_header() {
	local task=${2:-} err=${3:-} cur i pad lines=0 first="" where w room
	local -a R_L R_P R_C R_K
	local R_N=0 R_W=0
	form_load "$1"
	[ -n "$err" ] && printf '%8s%s%s%s\n' "" "$C_RED" "$err" "$C_OFF"
	if [ -f "$1.task" ]; then
		{ IFS= read -r first; } <"$1.task"
		lines=$(awk 'END { print NR - 1 }' "$1.task")
		if [ "$first" = "$task" ] && [ "${lines:-0}" -gt 0 ]; then
			form_row '' "+$lines more lines" "${C_GREY}+$lines more lines${C_OFF}" '^e'
		fi
	fi
	if [ -n "$F_REPO" ]; then
		form_path "$F_REPO"
		form_row repo "${F_REPO##*/}  $TILDE" "${C_BOLD}${F_REPO##*/}${C_OFF}  ${C_GREY}$TILDE${C_OFF}" '^r'
	else
		form_row repo "not in a git repository" "${C_GREY}not in a git repository${C_OFF}" '^r'
	fi
	if [ "$F_WHERE" = here ]; then
		cur=$(git -C "$F_HERE" symbolic-ref --short -q HEAD 2>/dev/null)
		where="this checkout${cur:+ · $cur}"
		if [ "$F_HERE" = "$F_REPO" ]; then
			form_row where "$where" "$where" 'tab'
		else
			form_path "$F_HERE"
			form_row where "$where  $TILDE" "$where  ${C_GREY}$TILDE${C_OFF}" 'tab'
		fi
	else
		form_row where "new worktree" "new worktree" 'tab'
		form_branch "$task"
		if [ -z "$BRANCH" ]; then
			form_row branch "from the task" "${C_GREY}from the task${C_OFF}" 'alt-b'
			form_base_row
		elif [ -n "$F_REPO" ] && { git -C "$F_REPO" show-ref --verify --quiet "refs/heads/$BRANCH" ||
			{ preferred_remote "$F_REPO" && git -C "$F_REPO" show-ref --verify --quiet "refs/remotes/$REMOTE/$BRANCH"; }; }; then
			form_row branch "$BRANCH  exists: continue on it" "$BRANCH  ${C_GREY}exists: continue on it${C_OFF}" 'alt-b'
		else
			form_row branch "$BRANCH" "$BRANCH" 'alt-b'
			form_base_row
		fi
	fi
	if agent_installed "$F_AGENT"; then
		form_row agent "$F_AGENT" "$F_AGENT" 'shift-tab'
	else
		form_row agent "$F_AGENT  not installed" "$F_AGENT  ${C_GREY}not installed${C_OFF}" 'shift-tab'
	fi
	# The keys in a column of their own at the right edge, wherever the
	# values end: fzf's width (its header's, less its border and margins).
	w=${FZF_COLUMNS:-${FORM_WIDTH:-}}
	case $w in '' | *[!0-9]*)
		w=$({ stty size </dev/tty; } 2>/dev/null)
		w=${w#* }
		;;
	esac
	case $w in '' | *[!0-9]*) w=96 ;; esac
	# fzf takes 8 of the width (its border, padding and gutter), the label 8
	# and the keys 10.
	room=$((w - 8 - 8 - 10))
	for ((i = 0; i < R_N; i++)); do
		pad=$((room - ${#R_P[i]}))
		[ $pad -lt 1 ] && pad=1
		printf '%s%6s%s  %s%*s %s%9s%s\n' "$C_GREY" "${R_L[i]}" "$C_OFF" "${R_C[i]}" "$pad" "" "$C_DIM" "${R_K[i]}" "$C_OFF"
	done
}

# Fit the form's pane to form $1's header (for task $2) again: it has a row
# more or less.
form_refit() {
	float_fit $(($(form_header "$1" "${2:-}" | wc -l) + 6)) "$FORM_COLS"
}

# The bases to offer, as "value<TAB>display" ("=" is the default: the
# remote's default branch, fetched).
form_bases() {
	local r cur
	if preferred_remote "$F_REPO" && remote_default "$F_REPO" "$REMOTE"; then
		printf '=\t%s  %sthe remote default, fetched%s\n' "$REMOTE_DEFAULT" "$C_GREY" "$C_OFF"
	else
		local_default "$F_REPO"
		printf '=\t%s  %sthe local default branch%s\n' "${LOCAL_DEFAULT:-default}" "$C_GREY" "$C_OFF"
	fi
	cur=$(git -C "${F_HERE:-$F_REPO}" symbolic-ref --short -q HEAD 2>/dev/null)
	printf '@\t@  %sthe HEAD of %s%s\n' "$C_GREY" "${cur:-this checkout}" "$C_OFF"
	git -C "$F_REPO" for-each-ref --format='%(refname:short)' --sort=-committerdate refs/heads refs/remotes 2>/dev/null |
		grep -v '/HEAD$' | head -n 100 | while IFS= read -r r; do printf '%s\t%s\n' "$r" "$r"; done
}

# What the form's keys do (`weaver _form OP FILE [QUERY]`), run by fzf.
cmd_form() {
	local op=$1 sf=$2 q=${3:-} out sel d first ed
	form_load "$sf"
	case $op in
	header) form_header "$sf" "$q" ;;
	where)
		if [ "$F_WHERE" = here ]; then F_WHERE=worktree; else F_WHERE=here; fi
		form_save "$sf"
		form_refit "$sf"
		[ "$F_WHERE" = worktree ] && [ -z "$F_BASE" ] && fetch_start "$F_REPO" "$sf"
		;;
	base)
		# A base means a new worktree.
		if [ "$F_WHERE" = here ]; then
			F_WHERE=worktree
			form_save "$sf"
		fi
		[ -n "$F_REPO" ] || return 0
		float_fit "$FORM_PICK_ROWS" "$FORM_COLS"
		# shellcheck disable=SC2086
		out=$(form_bases | SHELL=/bin/sh fzf --reverse $FORM_FZF --border-label ' base ' \
			--delimiter "$TAB" --with-nth 2 --print-query --prompt '      base  ' --ghost 'where the new branch starts' \
			--color "$FZF_COLORS" --footer "${C_GREY}⏎$C_OFF ${C_DIM}PICK$C_OFF   ${C_GREY}esc$C_OFF ${C_DIM}BACK$C_OFF")
		form_refit "$sf"
		[ -n "$out" ] || return 0
		sel=${out#*"$NL"}
		if [ "$sel" != "$out" ] && [ -n "$sel" ]; then
			d=${sel%%"$TAB"*}
		else
			d=${out%%"$NL"*}
		fi
		[ -n "$d" ] || return 0
		[ "$d" = = ] && d=""
		F_BASE=$d
		form_save "$sf"
		[ -n "$F_BASE" ] || fetch_start "$F_REPO" "$sf"
		;;
	agent)
		case $F_AGENT in claude) F_AGENT=codex ;; *) F_AGENT=claude ;; esac
		form_save "$sf"
		;;
	branch)
		# A branch means a new worktree.
		if [ "$F_WHERE" = here ]; then
			F_WHERE=worktree
			form_save "$sf"
		fi
		form_branch "$q"
		# shellcheck disable=SC2086
		out=$(SHELL=/bin/sh fzf --disabled --reverse $FORM_FZF --border-label ' branch ' \
			--prompt '    branch  ' --query "$BRANCH" --ghost 'branch name' --color "$FZF_COLORS" \
			--header "        ${C_GREY}names the branch and its worktree; an existing branch continues${C_OFF}" \
			--footer "${C_GREY}⏎$C_OFF ${C_DIM}KEEP$C_OFF   ${C_GREY}esc$C_OFF ${C_DIM}BACK$C_OFF" --bind 'enter:print-query' </dev/null) || return 0
		if [ -n "$out" ] && git check-ref-format --branch "$out" >/dev/null 2>&1; then
			F_BRANCH=$out
			slugify "$q"
			[ "$out" = "$SLUG" ] && F_BRANCH=""
			form_save "$sf"
		fi
		;;
	repo)
		float_fit "$FORM_PICK_ROWS" "$FORM_COLS"
		# shellcheck disable=SC2086
		out=$(recent_repos "$F_REPO" | SHELL=/bin/sh fzf --reverse $FORM_FZF --border-label ' repository ' \
			--delimiter "$TAB" --with-nth 2 --print-query --prompt '      repo  ' --ghost 'a repository, or a path' \
			--color "$FZF_COLORS" --footer "${C_GREY}⏎$C_OFF ${C_DIM}PICK$C_OFF   ${C_GREY}esc$C_OFF ${C_DIM}BACK$C_OFF")
		form_refit "$sf"
		[ -n "$out" ] || return 0
		sel=${out#*"$NL"}
		[ "$sel" != "$out" ] && [ -n "$sel" ] && d=${sel%%"$TAB"*} || d=${out%%"$NL"*}
		case $d in "~") d=$HOME ;; "~/"*) d="$HOME/${d#\~/}" ;; esac
		[ -n "$d" ] && [ -d "$d" ] || return 0
		if repo_of "$d"; then
			F_REPO=$REPO F_HERE=$CHECKOUT
		else
			F_REPO="" F_HERE=$(cd "$d" && pwd -P)
		fi
		# Another repository's bases are its own.
		F_BASE=""
		form_save "$sf"
		[ "$F_WHERE" = worktree ] && fetch_start "$F_REPO" "$sf"
		;;
	editor)
		if [ -f "$sf.task" ]; then { IFS= read -r first; } <"$sf.task"; fi
		[ -f "$sf.task" ] && [ "${first:-}" = "$q" ] || printf '%s\n' "$q" >"$sf.task"
		ed=${VISUAL:-${EDITOR:-vi}}
		float_fit 30 "$FORM_COLS"
		# $EDITOR may carry arguments ("code -w").
		$ed "$sf.task" </dev/tty >/dev/tty
		first=""
		{ IFS= read -r first; } <"$sf.task" 2>/dev/null
		form_refit "$sf" "$first"
		;;
	query)
		first=$q
		[ -f "$sf.task" ] && { IFS= read -r first; } <"$sf.task"
		printf '%s\n' "$first"
		;;
	esac
	return 0
}

# The form's floating pane: its width, and its pickers' rows (the pane fits
# to them while they are open). Its chrome is fzf's: a sharp border with a
# label, the pane itself borderless (float_fit).
FORM_COLS=96 FORM_ROWS=11 FORM_PICK_ROWS=24
# The form's footer: its keys, in the dashboard's style.
FORM_FOOTER="${C_GREY}⏎$C_OFF ${C_DIM}START$C_OFF   $C_GREY^e$C_OFF ${C_DIM}WRITE IT IN \$EDITOR$C_OFF   ${C_GREY}esc$C_OFF ${C_DIM}CANCEL$C_OFF"
FORM_FZF="--border sharp --border-label-pos 2 --no-info --no-separator --ansi --height 100% --highlight-line"

# The form: fills TASK and the F_* fields from form file $1. Returns 130 when
# you cancel. Its keys stay clear of zellij's (Ctrl b, g, h, n, o, p, q, s, t
# switch modes) and of fzf's line editing.
new_form() {
	local sf=$1 q h out rc err="" query=$TASK hd first
	q=$(printf '%q' "$SELF")
	hd="$q _form header $(printf '%q' "$sf") {q}"
	# The fetch for a new branch's base starts now, while you type.
	form_load "$sf"
	[ "$F_WHERE" = worktree ] && [ -z "$F_BASE" ] && fetch_start "$F_REPO" "$sf"
	while :; do
		h=$(form_header "$sf" "$query" "$err")
		# The pane, to the form: its rows, the prompt, the footer and fzf's
		# border (the Alt N binding opens it close to that); its keys, to the
		# pane's right edge.
		FORM_ROWS=$(($(printf '%s\n' "$h" | wc -l) + 6))
		float_fit "$FORM_ROWS" "$FORM_COLS"
		if [ -n "${FIT_COLS:-}" ] && [ "$FIT_COLS" != "${FORM_WIDTH:-}" ]; then
			FORM_WIDTH=$FIT_COLS
			h=$(form_header "$sf" "$query" "$err")
		fi
		form_sock "$sf"
		mkdir -p "$SOCK_DIR" && chmod 700 "$SOCK_DIR"
		rm -f "$FORM_SOCK"
		# shellcheck disable=SC2086
		out=$(SHELL=/bin/sh fzf --listen "$FORM_SOCK" --disabled --reverse $FORM_FZF --border-label ' new thread ' \
			--prompt '      task  ' --ghost 'what should the agent do?' --query "$query" \
			--header "$h" --footer "$FORM_FOOTER" \
			--color "$FZF_COLORS" \
			--bind "change:bg-cancel+bg-transform-header($hd)" \
			--bind "tab:execute-silent($q _form where $(printf '%q' "$sf"))+transform-header($hd)" \
			--bind "btab:execute-silent($q _form agent $(printf '%q' "$sf"))+transform-header($hd)" \
			--bind "alt-b:execute($q _form branch $(printf '%q' "$sf") {q})+transform-header($hd)" \
			--bind "alt-B:execute($q _form base $(printf '%q' "$sf"))+transform-header($hd)" \
			--bind "ctrl-r:execute($q _form repo $(printf '%q' "$sf"))+transform-header($hd)" \
			--bind "ctrl-e:execute($q _form editor $(printf '%q' "$sf") {q})+transform-query($q _form query $(printf '%q' "$sf") {q})+transform-header($hd)" \
			--bind 'enter:print-query' </dev/null)
		rc=$?
		rm -f "$FORM_SOCK"
		[ $rc = 130 ] && return 130
		[ $rc -gt 1 ] && die "fzf failed (the form needs fzf 0.62 or newer)"
		query=${out%%"$NL"*}
		form_load "$sf"
		TASK=$query
		if [ -f "$sf.task" ]; then
			first=""
			{ IFS= read -r first; } <"$sf.task"
			[ "$first" = "$query" ] && TASK=$(cat "$sf.task")
		fi
		thread_check && return 0
		err=$CHECK_ERR
	done
}

# Can a thread start from TASK and the F_* fields? Into CHECK_ERR: why not.
thread_check() {
	CHECK_ERR=""
	case $TASK in *[![:space:]]*) ;; *)
		CHECK_ERR="say what the agent should do"
		return 1
		;;
	esac
	agent_installed "$F_AGENT" || {
		CHECK_ERR="$F_AGENT is not installed"
		return 1
	}
	if [ "$F_WHERE" = here ]; then
		[ -d "$F_HERE" ] || CHECK_ERR="no such directory: $F_HERE"
	elif [ -z "$F_REPO" ]; then
		CHECK_ERR="not in a git repository: pick one (^r), or work in this checkout (tab)"
	else
		form_branch "$TASK"
		if [ -z "$BRANCH" ]; then
			CHECK_ERR="name the branch (alt-b): the task has no letters to name it after"
		elif ! git check-ref-format --branch "$BRANCH" >/dev/null 2>&1; then
			CHECK_ERR="not a valid branch name: $BRANCH"
		else
			case $F_BASE in
			'' | @ | ^ | pr:* | mr:*) ;;
			*) git -C "$F_REPO" rev-parse --verify --quiet "$F_BASE^{commit}" >/dev/null ||
				CHECK_ERR="no such base: $F_BASE" ;;
			esac
		fi
	fi
	[ -z "$CHECK_ERR" ]
}

# ------------------------------------------------ making the thread

# ------------------------------------------------ where a new branch starts
#
# As Rob's `wnew`: from the remote's default branch, freshly fetched. The form
# starts the fetch as soon as it opens (and again when the repository
# changes); enter waits for it, at most $WEAVER_FETCH_TIMEOUT seconds (10).
# Offline, slow or without a remote, the branch starts from the local default
# branch instead, and says so.

# The remote of repository $1 to start from: origin, else the first one; into
# REMOTE. Returns 1 when there is none.
preferred_remote() {
	local r
	# The form's header asks several times per keystroke: once per repository.
	if [ "${PR_REPO:-}" = "$1" ]; then
		REMOTE=$PR_REMOTE
		[ -n "$REMOTE" ]
		return
	fi
	REMOTE=""
	while IFS= read -r r; do
		[ -n "$r" ] || continue
		[ -z "$REMOTE" ] && REMOTE=$r
		[ "$r" = origin ] && REMOTE=origin && break
	done <<EOF2
$(git -C "$1" remote 2>/dev/null)
EOF2
	PR_REPO=$1 PR_REMOTE=$REMOTE
	[ -n "$REMOTE" ]
}

# Remote $2's default branch in repository $1 (origin/main), into
# REMOTE_DEFAULT: its HEAD, else its main or master.
remote_default() {
	local r
	REMOTE_DEFAULT=$(git -C "$1" symbolic-ref --quiet --short "refs/remotes/$2/HEAD" 2>/dev/null) && return 0
	for r in main master; do
		if git -C "$1" show-ref --verify --quiet "refs/remotes/$2/$r"; then
			REMOTE_DEFAULT=$2/$r
			return 0
		fi
	done
	REMOTE_DEFAULT=""
	return 1
}

# Repository $1's local default branch (main), into LOCAL_DEFAULT: the one
# its remote's HEAD names, else main or master; empty when there is none
# (Worktrunk's default, or HEAD).
local_default() {
	local r=""
	LOCAL_DEFAULT=""
	preferred_remote "$1" && r=$(git -C "$1" symbolic-ref --quiet --short "refs/remotes/$REMOTE/HEAD" 2>/dev/null)
	for r in ${r#*/} main master; do
		if git -C "$1" show-ref --verify --quiet "refs/heads/$r"; then
			LOCAL_DEFAULT=$r
			return 0
		fi
	done
}

# Where repository $1's fetch keeps its state, into FETCHF: FETCHF.pid while
# it runs, FETCHF.rc (git's status, or "none") once it is done.
fetch_file() {
	FETCHF="$STATE_DIR/fetch/${1//\//%}"
}

# Fetch repository $1's remote in the background, unless that is under way
# or succeeded in the last minute (a failure is tried again: you may be back
# online). Its own session, so ssh can never ask for a passphrase on the
# form's terminal. When it is done it redraws form $2's header, if the form
# is open.
fetch_start() {
	local repo=$1 pid="" rc=""
	[ -n "$repo" ] || return 0
	fetch_file "$repo"
	mkdir -p "${FETCHF%/*}" || return 0
	{ read -r pid <"$FETCHF.pid"; } 2>/dev/null
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return 0
	{ read -r rc <"$FETCHF.rc"; } 2>/dev/null
	[ "$rc" = 0 ] && [ -n "$(find "$FETCHF.rc" -mmin -1 2>/dev/null)" ] && return 0
	rm -f "$FETCHF.rc" "$FETCHF.pid"
	if ! preferred_remote "$repo"; then
		echo none >"$FETCHF.rc"
		return 0
	fi
	perl -e 'use POSIX qw(setsid); setsid(); exec @ARGV or exit 1' "$SELF" _fetch "$repo" "$REMOTE" "$FETCHF" "${2:-}" \
		</dev/null >/dev/null 2>&1 &
	echo $! >"$FETCHF.pid"
}

# The fetch itself (`weaver _fetch REPO REMOTE FETCHF [FORM]`).
cmd_fetch() {
	local repo=$1 remote=$2 f=$3 sf=${4:-} rc q
	GIT_TERMINAL_PROMPT=0 git -C "$repo" fetch --prune --quiet "$remote" </dev/null >/dev/null 2>"$f.err"
	rc=$?
	printf '%s\n' "$rc" >"$f.rc.$$" && mv -f "$f.rc.$$" "$f.rc"
	rm -f "$f.pid"
	[ -n "$sf" ] || return 0
	form_sock "$sf"
	if [ -S "$FORM_SOCK" ]; then
		q=$(printf '%q' "$SELF")
		curl -s -m 1 --unix-socket "$FORM_SOCK" -X POST \
			-d "transform-header($q _form header $(printf '%q' "$sf") {q})" http://localhost >/dev/null 2>&1
	fi
	return 0
}

# The socket of form $1's fzf, into FORM_SOCK (in $SOCK_DIR: macOS caps a
# socket's path at about 104 bytes).
form_sock() { FORM_SOCK="$SOCK_DIR/form.${1##*.}.sock"; }

# Wait for repository $1's fetch (started if need be), at most $2 seconds;
# into FETCH_RC: 0, git's failure status, none (no remote) or timeout.
fetch_wait() {
	local i n=$((${2:-10} * 10)) pid="" said=""
	fetch_start "$1"
	for ((i = 0; i < n; i++)); do
		[ -f "$FETCHF.rc" ] && break
		pid=""
		{ read -r pid <"$FETCHF.pid"; } 2>/dev/null
		[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || break
		if [ -z "$said" ] && [ $i -ge 3 ]; then
			printf '%sweaver: fetching %s…%s\n' "$C_DIM" "${REMOTE:-the remote}" "$C_OFF" >&2
			said=1
		fi
		sleep 0.1
	done
	FETCH_RC=""
	{ read -r FETCH_RC <"$FETCHF.rc"; } 2>/dev/null
	if [ -z "$FETCH_RC" ]; then
		FETCH_RC=timeout
		[ -n "$pid" ] && kill -- "-$pid" 2>/dev/null
		rm -f "$FETCHF.pid"
	fi
}

# The base for a new branch of repository $1 started from checkout $2, into
# BASE (empty: Worktrunk's default branch, or git's HEAD) and BASE_NOTE (why
# it is not the fetched remote default, when it is not). F_BASE, when set, is
# used as it is (@ is the checkout's HEAD).
thread_base() {
	local repo=$1 t=${WEAVER_FETCH_TIMEOUT:-10} from
	BASE="" BASE_NOTE=""
	if [ -n "$F_BASE" ]; then
		BASE=$F_BASE
		return 0
	fi
	case $t in '' | *[!0-9]*) t=10 ;; esac
	local_default "$repo"
	from="the local ${LOCAL_DEFAULT:-default branch}"
	if ! preferred_remote "$repo"; then
		BASE=$LOCAL_DEFAULT BASE_NOTE="no remote: starts from $from"
		return 0
	fi
	fetch_wait "$repo" "$t"
	case $FETCH_RC in
	0)
		if remote_default "$repo" "$REMOTE"; then
			BASE=$REMOTE_DEFAULT
			return 0
		fi
		BASE_NOTE="$REMOTE has no default branch: starts from $from"
		;;
	timeout) BASE_NOTE="$REMOTE took over ${t}s to fetch: starts from $from" ;;
	*) BASE_NOTE="could not fetch $REMOTE (offline?): starts from $from" ;;
	esac
	BASE=$LOCAL_DEFAULT
}

# The checkout of repository $1 that @ means: the one you are in ($2) when it
# belongs to it, else the main one; into FROM.
thread_from() {
	FROM=$1
	[ -n "${2:-}" ] && [ "$2" != "$1" ] && [ -d "$2" ] || return 0
	local r=$REPO c=$CHECKOUT
	repo_of "$2" && [ "$REPO" = "$1" ] && FROM=$CHECKOUT
	REPO=$r CHECKOUT=$c
}

# The worktree for branch $2 of repository $1, made unless it exists (from
# base $3 if given; a branch only on the remote is checked out to track it),
# working from checkout $4 (where @ is): with Worktrunk when it is installed
# (your worktree-path template and hooks), else with git at Worktrunk's
# default path. Into WT_DIR, and WT_CREATED (true when this made it).
thread_worktree() {
	local repo=$1 branch=$2 base=${3:-} from=${4:-$1} create="" json rc path line wtp=""
	WT_DIR="" WT_CREATED=false
	if ! git -C "$repo" show-ref --verify --quiet "refs/heads/$branch" &&
		! { preferred_remote "$repo" && git -C "$repo" show-ref --verify --quiet "refs/remotes/$REMOTE/$branch"; }; then
		create=1
	fi
	[ -n "$create" ] || base=""
	WT_BASE=$base
	[ -n "$create" ] && [ -n "${BASE_NOTE:-}" ] && printf '%sweaver: %s%s\n' "$C_DIM" "$BASE_NOTE" "$C_OFF" >&2
	printf '%sweaver: worktree for %s%s%s\n' "$C_GREY" "$branch" "${base:+ from $base}" "$C_OFF" >&2
	if [ "${WEAVER_WORKTRUNK:-1}" != 0 ] && command -v wt >/dev/null 2>&1; then
		json=$(wt -C "$from" switch ${create:+--create} ${base:+--base "$base"} --no-cd --format json "$branch")
		rc=$?
		[ $rc = 0 ] || return $rc
		WT_DIR=$(printf '%s' "$json" | jq -r '.path // empty' 2>/dev/null)
		[ "$(printf '%s' "$json" | jq -r '.action // empty' 2>/dev/null)" = created ] && WT_CREATED=true
		[ -d "$WT_DIR" ] || {
			echo "weaver: Worktrunk did not say where the worktree is" >&2
			return 1
		}
		return 0
	fi
	# The branch's own worktree, when it has one.
	while IFS= read -r line; do
		case $line in
		"worktree "*) wtp=${line#worktree } ;;
		"branch refs/heads/$branch")
			WT_DIR=$wtp
			return 0
			;;
		esac
	done <<EOF2
$(git -C "$repo" worktree list --porcelain 2>/dev/null)
EOF2
	# Worktrunk's shortcuts, for git: @ is the checkout's HEAD, ^ the default branch.
	case $base in
	@) base=$(git -C "$from" rev-parse --verify --quiet HEAD) ;;
	^)
		local_default "$repo"
		base=$LOCAL_DEFAULT
		;;
	esac
	path="${repo%/*}/${repo##*/}.${branch//\//-}"
	if [ -n "$create" ]; then
		git -C "$repo" worktree add -b "$branch" "$path" ${base:+"$base"} >&2 || return 1
	else
		git -C "$repo" worktree add "$path" "$branch" >&2 || return 1
	fi
	WT_DIR=$(cd "$path" && pwd -P)
	WT_CREATED=true
}

# The session's template for a new tab (so its status bar, zjstatus or
# another, stays), from `zellij action dump-layout`: the lines inside
# new_tab_template, where a bare `pane` is the tab's content. Braces inside
# strings and after // don't count.
AWK_TEMPLATE='
function depth(s,   i, c, d, q) {
	d = 0; q = 0
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (q) { if (c == "\\") i++; else if (c == "\"") q = 0 }
		else if (c == "\"") q = 1
		else if (c == "/" && substr(s, i + 1, 1) == "/") break
		else if (c == "{") d++
		else if (c == "}") d--
	}
	return d
}
!inb && /^[[:space:]]*new_tab_template[[:space:]]*[{]/ { inb = 1; d = depth($0); next }
inb { d += depth($0); if (d <= 0) exit; print }'

# $WEAVER_AGENT_WIDTH: a percentage of the tab (AW_PCT) or columns (AW_COLS),
# and as a layout size (AW_SIZE).
agent_width() {
	local w=${WEAVER_AGENT_WIDTH:-20%}
	AW_PCT="" AW_COLS=""
	case $w in
	[1-9]% | [1-9][0-9]%) AW_PCT=${w%\%} AW_SIZE="\"$w\"" ;;
	[1-9] | [1-9][0-9] | [1-9][0-9][0-9]) AW_COLS=$w AW_SIZE=$w ;;
	*) AW_PCT=20 AW_SIZE='"20%"' ;;
	esac
}

# The agent's columns in a thread tab $1 columns wide, into AGENT_COLS:
# $WEAVER_AGENT_WIDTH of it, but at least $WEAVER_AGENT_MIN_COLS (44: Claude
# Code wraps mid-word below that) as long as nvim keeps 60. Columns given
# outright are used as they are.
agent_cols() {
	local total=$1 min=${WEAVER_AGENT_MIN_COLS:-44}
	agent_width
	case $min in '' | *[!0-9]*) min=44 ;; esac
	if [ -n "$AW_COLS" ]; then
		AGENT_COLS=$AW_COLS
		return 0
	fi
	AGENT_COLS=$((total * AW_PCT / 100))
	[ $min -gt $((total - 60)) ] && min=$((total - 60))
	[ $AGENT_COLS -lt $min ] && AGENT_COLS=$min
	return 0
}

# Back to a thread's split once its nvim reopens beside the agent (which
# halves the agent's pane): nvim on the left, the agent at $WEAVER_AGENT_WIDTH
# on the right. Only when those two are the tab's only tiled panes, so panes
# you added keep their size. zellij 0.45 has no absolute size and resizes in
# steps of 5% of the tab, so: as many steps as the measured widths say, then
# measure again (at most three rounds). The agent keeps running throughout.
thread_width() {
	local agent=$1 nv=$2 round geo aw total target step d n i dir
	agent_width
	if [ "$MUX" = tmux ]; then
		# Only while nvim and the agent are the window's only panes.
		[ "$(tm list-panes -t "%$agent" 2>/dev/null | wc -l | tr -d ' ')" = 2 ] || return 0
		total=$(tm display-message -p -t "%$agent" '#{window_width}' 2>/dev/null)
		case $total in '' | *[!0-9]*) return 0 ;; esac
		agent_cols "$total"
		tm resize-pane -t "%$agent" -x "$AGENT_COLS" >/dev/null 2>&1
		return 0
	fi
	for round in 1 2 3; do
		list_panes || return 0
		geo=$(printf '%s' "$PANES" | jq -r --arg a "$agent" --arg n "$nv" '
			map(select(.is_plugin | not)) as $t
			| ($t | map(select((.id | tostring) == $a)) | .[0]) as $ap
			| [$t[] | select(.tab_id == $ap.tab_id and (.is_floating | not))] as $all
			| [$all[] | select((.terminal_command // "") | test(" sidebar$") | not)] as $tiled
			| if $ap != null and ($tiled | length) == 2 and any($tiled[]; (.id | tostring) == $n)
			  then "\($ap.pane_columns) \($all | map(.pane_columns) | add)" else "" end')
		case $geo in *[0-9]" "[0-9]*) ;; *) return 0 ;; esac
		aw=${geo% *} total=${geo#* }
		agent_cols "$total"
		target=$AGENT_COLS
		step=$((total / 20))
		[ $step -ge 1 ] || step=1
		d=$((aw - target))
		if [ $d -ge 0 ]; then
			n=$(((d + step / 2) / step)) dir=decrease
		else
			n=$(((step / 2 - d) / step)) dir=increase
		fi
		[ $n -gt 0 ] || return 0
		for ((i = 0; i < n; i++)); do
			zellij action resize -p "terminal_$agent" "$dir" left >/dev/null 2>&1 || return 0
		done
	done
}

# The new thread tab's layout, into LAYOUT: nvim on the left, the agent on the
# right ($WEAVER_AGENT_WIDTH of the width: 20% by default; a plain number is
# columns) with the focus, in the session's new-tab template. $1 the token,
# $2 the agent, $3 the directory.
thread_layout() {
	local tok=$1 kind=$2 dir=$3 size self name ktok kkind split tpl total
	agent_width
	size=$AW_SIZE
	# At least the agent's minimum, in columns, on a narrow screen.
	total=$(mux_tabs | jq -r '[.[] | select(.active)] | .[0].viewport_columns // 0' 2>/dev/null)
	case $total in '' | *[!0-9]*) total=0 ;; esac
	if [ -n "$AW_PCT" ] && [ "$total" -gt 0 ]; then
		agent_cols "$total"
		# Still a percentage: a pane of fixed columns would keep them when
		# the nvim beside it closes.
		[ "$AGENT_COLS" -gt $((total * AW_PCT / 100)) ] && size="\"$(((AGENT_COLS * 100 + total - 1) / total))%\""
	fi
	kdl_str "$SELF"
	self=$K
	kdl_str "nvim: ${dir##*/}"
	name=$K
	kdl_str "$tok"
	ktok=$K
	kdl_str "$kind"
	kkind=$K
	split="pane split_direction=\"vertical\" {
    pane name=$name command=$self close_on_exit=true {
        args \"nvim\" \"--thread\" $ktok
    }
    pane size=$size focus=true command=$self {
        args \"_agent\" $ktok $kkind
    }
}"
	if weaver_session && [ "${WEAVER_SIDEBAR:-0}" = 1 ]; then
		thread_layout_side "$size"
		return
	fi
	tpl=$(zellij action dump-layout 2>/dev/null | awk "$AWK_TEMPLATE")
	case $tpl in
	*[![:space:]]*)
		tpl=$(printf '%s\n' "$tpl" | SPLIT=$split awk '
			!done && /^[[:space:]]*pane[[:space:]]*$/ { print ENVIRON["SPLIT"]; done = 1; next }
			{ print }
			END { if (!done) exit 1 }') || tpl=$split
		;;
	*) tpl=$split ;;
	esac
	LAYOUT="layout {
tab {
$tpl
}
}"
}

# In the weaver session with WEAVER_SIDEBAR=1, a thread tab has the thread
# sidebar on its left:
# SIDE_OPEN% of the width, or SIDE_RAIL% once it collapses (a swap layout, so
# `next-swap-layout`, Alt [ and Alt ] toggle it with the panes kept). The
# session's new-tab template (its status line) becomes a named tab template,
# which the swap layout needs. Into LAYOUT; $1 the agent's size, and self,
# name, ktok and kkind from thread_layout.
SIDE_OPEN=16 SIDE_RAIL=5
thread_layout_side() {
	local size=$1 tpl
	tpl=$(zellij action dump-layout 2>/dev/null | awk "$AWK_TEMPLATE" |
		awk '!done && /^[[:space:]]*pane[[:space:]]*$/ { print "children"; done = 1; next } { print }')
	case $tpl in *children*) ;; *) tpl=children ;; esac
	LAYOUT="layout {
tab_template name=\"weaver_thread\" {
$tpl
}
swap_tiled_layout name=\"rail\" {
    weaver_thread {
        pane split_direction=\"vertical\" {
            pane size=\"$SIDE_RAIL%\"
            pane
            pane size=$size
        }
    }
}
weaver_thread {
    pane split_direction=\"vertical\" {
        pane size=\"$SIDE_OPEN%\" name=\"threads\" command=$self {
            args \"sidebar\"
        }
        pane name=$name command=$self close_on_exit=true {
            args \"nvim\" \"--thread\" $ktok
        }
        pane size=$size focus=true command=$self {
            args \"_agent\" $ktok $kkind
        }
    }
}
}"
}

# tmux, 1.5 s after you focus window $1, flagged as holding an agent done and
# unseen (config/tmux.conf's pane-focus-in hook): if you are still on it, the
# agent you are looking at (its pane, or the nvim bound to it) is seen, and the
# counts say so. Passing through, it stays new; the flag stays while another
# agent there is still new.
cmd_seen() {
	local win=${1:-} info p line re_d='"state":"done"' re_n='"seen":true' left=""
	[ "$MUX" = tmux ] || return 0
	need_session
	win=${win#@}
	info=$(tm display-message -p -t "@$win" '#{window_active}:#{session_attached}:#{pane_id}' 2>/dev/null)
	case $info in 1:[1-9]*:%*) ;; *) return 0 ;; esac
	agent_of_pane "${info##*%}" || return 0
	line=""
	{ IFS= read -r line <"$STATE_DIR/${SKEY}_$AGENT.json"; } 2>/dev/null
	[[ $line =~ $re_d ]] && ! [[ $line =~ $re_n ]] && mark_seen "$AGENT"
	for p in $(tm list-panes -t "@$win" -F '#{pane_id}' 2>/dev/null); do
		p=${p#%}
		line=""
		{ IFS= read -r line <"$STATE_DIR/${SKEY}_$p.json"; } 2>/dev/null
		[[ $line =~ $re_d ]] && ! [[ $line =~ $re_n ]] && left=1
	done
	[ -n "$left" ] || tm set-option -w -u -t "@$win" @weaver-unseen >/dev/null 2>&1
	push_status
}

# tmux, as window $1 is resized (config/tmux.conf's window-resized hook): its
# thread's agent back to its width, since tmux takes a narrower window's
# columns from the rightmost pane, the agent's.
cmd_fit() {
	local win=${1:-} p
	[ "$MUX" = tmux ] || return 0
	need_session
	win=${win#@}
	for p in $(tm list-panes -t "@$win" -F '#{pane_id}' 2>/dev/null); do
		p=${p#%}
		[ -f "$STATE_DIR/${SKEY}_$p.thread" ] || continue
		read_nvim_pane "$p"
		[ -n "$NV" ] && thread_width "$p" "$NV"
	done
	return 0
}

# Open a thread's tab, named $4, in directory $3: nvim on the left (`weaver
# nvim --thread $1`), the agent ($2) on the right at its width, with the
# focus; not gone to when NOFOCUS is set. Its id into NEWTAB (TAB is the tab character); returns 1 when the
# multiplexer would not open it.
thread_tab() {
	local tok=$1 kind=$2 dir=$3 name=$4 total
	NEWTAB=""
	if [ "$MUX" != tmux ]; then
		thread_layout "$tok" "$kind" "$dir"
		NEWTAB=$(zellij action new-tab --layout-string "$LAYOUT" --cwd "$dir" --name "$name" ${NOFOCUS:+--no-focus}) ||
			return 1
		return 0
	fi
	NEWTAB=$(tm new-window ${NOFOCUS:+-d} -P -F '#{window_id}' -t "=$SESSION:" -n "$name" -c "$dir" \
		-e "WEAVER_TMUX_SESSION=$SESSION" "$SELF" nvim --thread "$tok") || return 1
	NEWTAB=${NEWTAB#@}
	total=$(tm display-message -p -t "@$NEWTAB" '#{window_width}' 2>/dev/null)
	case $total in '' | *[!0-9]*) total=200 ;; esac
	agent_cols "$total"
	tm split-window -h -t "@$NEWTAB" -l "$AGENT_COLS" -c "$dir" -e "WEAVER_TMUX_SESSION=$SESSION" \
		"$SELF" _agent "$tok" "$kind" >/dev/null || {
		tm kill-window -t "@$NEWTAB" >/dev/null 2>&1
		return 1
	}
	tm select-pane -t "@$NEWTAB.0" -T "nvim: ${dir##*/}" \; select-pane -t "@$NEWTAB.1" >/dev/null 2>&1
	return 0
}

# Start the thread from TASK and the F_* fields: its worktree (unless here),
# then its tab. Prints where it went.
thread_create() {
	local dir name branch="" created=false tok d tab
	BASE="" BASE_NOTE=""
	if [ "$F_WHERE" = here ]; then
		dir=$F_HERE
		slugify "$TASK"
		name=${SLUG:-thread-$(date +%H%M%S)}
		branch=$(git -C "$dir" symbolic-ref --short -q HEAD 2>/dev/null)
	else
		form_branch "$TASK"
		branch=$BRANCH
		thread_from "$F_REPO" "$F_HERE"
		# A branch that is not here yet: fetch first (it may be on the
		# remote), and find where it would start.
		git -C "$F_REPO" show-ref --verify --quiet "refs/heads/$branch" || thread_base "$F_REPO"
		thread_worktree "$F_REPO" "$branch" "$BASE" "$FROM" || return 1
		dir=$WT_DIR created=$WT_CREATED name=$branch BASE=$WT_BASE
	fi
	tok="$(date +%s)$$$RANDOM"
	d="$THREADS_NEW/${SKEY}_$tok"
	mkdir -p "$d" || die "cannot create $d"
	printf '%s' "$TASK" >"$d/task"
	# Its stable number: the lowest free one (two at once must not share).
	num_lock
	thread_num
	# The command its agent runs, from here (the pane will not have this
	# environment): $WEAVER_CLAUDE / $WEAVER_CODEX, else the agent's name.
	agent_cmd "$F_AGENT"
	jq -nc --arg cmd "$AGENT_CMD" --argjson num "$NUM" --arg name "$name" --arg task "$TASK" --arg repo "$F_REPO" --arg branch "$branch" \
		--arg dir "$dir" --argjson here "$([ "$F_WHERE" = here ] && echo true || echo false)" \
		--argjson created "$created" --arg agent "$F_AGENT" --argjson now "$(date +%s)" --arg base "$BASE" \
		'{num: $num, cmd: $cmd, name: $name, task: $task, repo: $repo, branch: $branch, worktree: $dir, here: $here,
		  worktree_created: $created, agent: $agent, created: $now, base: $base}' >"$d/thread.json" || {
		num_unlock
		die "cannot write the thread record"
	}
	num_unlock
	thread_tab "$tok" "$F_AGENT" "$dir" "$name" || {
		rm -rf "$d"
		[ "$created" = true ] && die "$MUX could not open the tab for $name (its new worktree stays: $dir)"
		die "$MUX could not open the tab for $name"
	}
	tab=$NEWTAB
	weaver_session && thread_place "$tab" "$NUM"
	remember_repo "$F_REPO"
	tildify "$dir"
	printf 'weaver: thread %s in %s (tab %s)\n' "$name" "$TILDE" "${tab:-?}"
}

# Bring lost thread $1 (its record in $LOST_DIR) back: a tab like the one
# `weaver new` makes, in the directory its agent started in, whose agent
# resumes its conversation (claude --resume, codex resume) instead of taking a
# task. It keeps its number when that is free, and its state (turns, title,
# last reply) carries on. Prints where it went; returns 1 with RESTORE_ERR
# when it cannot (its record stays).
thread_restore() {
	local lf=$1 tok d info sid kind dir num name repo tab now
	RESTORE_ERR=""
	tok="$(date +%s)$$$RANDOM"
	d="$THREADS_NEW/${SKEY}_$tok"
	mkdir -p "$d" || die "cannot create $d"
	# Claim it: of two restores at once, one takes the record.
	if ! mv "$lf" "$d/lost.json" 2>/dev/null; then
		rm -rf "$d"
		RESTORE_ERR="${lf##*/}: already resumed"
		return 1
	fi
	info=$(jq -r "$JQ_LOST"'[.state.session_id // "", .thread.agent // .state.agent // "claude",
		lost_dir, .thread.num // "", .thread.name // "", .thread.repo // ""]
		| map(tostring | gsub("[\u0000-\u001f]+"; " ")) | join("\u001f")' "$d/lost.json" 2>/dev/null)
	IFS=$US read -r sid kind dir num name repo <<<"$info"
	# Its worktree gone (removed, renamed): its repository's main checkout,
	# from where Claude Code finds a session in any worktree of it.
	[ -d "$dir" ] || { [ -n "$repo" ] && [ -d "$repo" ] && dir=$repo; }
	name=${name:-thread}
	agent_cmd "$kind" || {
		kind=claude
		agent_cmd claude
	}
	if [ -z "$sid" ] || [ ! -d "$dir" ]; then
		mv -f "$d/lost.json" "$lf"
		rm -rf "$d"
		tildify "$dir"
		RESTORE_ERR="$name: its directory ${TILDE:+$TILDE }is gone"
		return 1
	fi
	now=$(date +%s)
	num_lock
	thread_num
	case $num in '' | *[!0-9]*) ;; *) case $NUMS_USED in *" $num "*) ;; *) NUM=$num ;; esac ;; esac
	if ! jq -c --arg cmd "$AGENT_CMD" --argjson num "$NUM" '.thread + {cmd: $cmd, num: $num} | del(.pane)' \
		"$d/lost.json" >"$d/thread.json" 2>/dev/null ||
		! jq -c --argjson now "$now" '.state | del(.pid, .proc_start, .nvim_pane, .end_reason, .waiting, .pending, .marker, .marked_root)
			+ {state: "idle", ts: $now, since: $now, seen: true, subagents: [], background: 0, background_tasks: ""}' \
			"$d/lost.json" >"$d/state.json" 2>/dev/null ||
		! printf '%s\n' "$sid" >"$d/resume"; then
		num_unlock
		mv -f "$d/lost.json" "$lf"
		rm -rf "$d"
		RESTORE_ERR="$name: cannot write its records"
		return 1
	fi
	num_unlock
	thread_tab "$tok" "$kind" "$dir" "$name" || {
		mv -f "$d/lost.json" "$lf"
		rm -rf "$d"
		RESTORE_ERR="$name: $MUX could not open its tab"
		return 1
	}
	tab=$NEWTAB
	rm -f "$d/lost.json"
	weaver_session && thread_place "$tab" "$NUM"
	tildify "$dir"
	printf 'weaver: resumed %s in %s (tab %s)\n' "$name" "$TILDE" "${tab:-?}"
}

# The lost threads, newest first, into LOST_ROWS: one per line, US-separated:
# record file, session id, name, number, directory, when lost (epoch s), its
# zellij session, task, title.
lost_rows() {
	local f
	local -a files=()
	LOST_ROWS=""
	for f in "$LOST_DIR"/*.json; do [ -f "$f" ] && files[${#files[@]}]=$f; done
	[ ${#files[@]} -gt 0 ] || return 0
	LOST_ROWS=$(jq -r "$JQ_LOST"'[input_filename, .state.session_id // "", .thread.name // "", .thread.num // "",
		lost_dir, .lost // 0, lost_skey,
		.thread.task // .state.prompt // "", .state.title // ""]
		| map(tostring | gsub("[\u0000-\u001f]+"; " ")) | join("\u001f")' "${files[@]}" 2>/dev/null |
		sort -t "$US" -k6,6nr)
}

# The lost threads WHICH names (a session id or at least its first 4
# characters, a thread's name, or its number), into MATCH: their record
# files, one per line; MATCHES counts them.
lost_match() {
	local which=$1 f sid name num rest
	MATCH="" MATCHES=0
	while IFS=$US read -r f sid name num rest; do
		[ -n "$f" ] || continue
		if [ "$which" != "$sid" ] && [ "$which" != "$name" ] && [ "$which" != "$num" ]; then
			[ ${#which} -ge 4 ] || continue
			case $sid in "$which"*) ;; *) continue ;; esac
		fi
		MATCH="$MATCH$f$NL" MATCHES=$((MATCHES + 1))
	done <<EOF2
$LOST_ROWS
EOF2
}

# Every thread this session lost (when it went before), back in its tabs in
# their numbers' order, leaving you where you are. A tmux session also takes
# those of the zellij session of its name: moving from zellij to tmux keeps
# them.
resume_session() {
	local f sid name num rest files also=""
	[ "$MUX" = tmux ] && also=${SKEY#tmux-}
	lost_rows
	files=$(while IFS=$US read -r f sid name num _ _ rest; do
		[ -n "$f" ] || continue
		rest=${rest%%"$US"*}
		{ [ "$rest" = "$SKEY" ] || { [ -n "$also" ] && [ "$rest" = "$also" ]; }; } &&
			printf '%s\t%s\n' "${num:-999}" "$f"
	done <<<"$LOST_ROWS" | sort -n | cut -f 2)
	[ -n "$files" ] || return 0
	while IFS= read -r f; do
		NOFOCUS=1 thread_restore "$f" >/dev/null || echo "weaver: $RESTORE_ERR" >&2
	done <<<"$files"
	push_status labels
}

# weaver resume [--all | --forget [--yes]] [WHICH]: the threads lost with
# their zellij (a crash, or zellij quit). Alone, it lists them; with WHICH (a
# session id or its start, a thread's name or number) it brings that one
# back in a new tab whose agent resumes its conversation, and with --all
# every one. --forget drops one for good instead (its worktree stays).
cmd_resume() {
	local all=0 drop=0 yes=0 which="" f sid name num dir lost skey task title failed=0 now out
	while [ $# -gt 0 ]; do
		case $1 in
		--all) all=1 ;;
		--forget) drop=1 ;;
		--yes | -y) yes=1 ;;
		-h | --help)
			usage
			return 0
			;;
		-*) die "usage: weaver resume [--all | --forget [--yes]] [session-id | name | number]" ;;
		*) which=$1 ;;
		esac
		shift
	done
	lost_rows
	if [ $all = 0 ] && [ -z "$which" ]; then
		if [ -z "$LOST_ROWS" ]; then
			echo "weaver: no lost threads"
			return 0
		fi
		now=$(date +%s)
		while IFS=$US read -r f sid name num dir lost skey task title; do
			[ -n "$f" ] || continue
			age $((now - lost))
			where_of "$dir"
			printf '%3s  %-32s %-28s %4s ago  %s\n' "$num" "$name" "$W_REPO${W_BRANCH:+/$W_BRANCH}" "$AGE" "${sid:0:8}"
		done <<<"$LOST_ROWS"
		echo "weaver resume NAME (a number, or a session id) brings one back; --all, every one"
		return 0
	fi
	if [ $all = 1 ]; then
		MATCH=""
		[ -n "$LOST_ROWS" ] && MATCH=$(printf '%s\n' "$LOST_ROWS" | cut -d "$US" -f 1)
	else
		lost_match "$which"
	fi
	[ -n "$MATCH" ] || die "no lost thread ${which:+named $which }(weaver resume lists them)"
	[ $all = 1 ] || [ "$MATCHES" = 1 ] || die "$which names $MATCHES lost threads: give its session id (weaver resume lists them)"
	if [ $drop = 1 ]; then
		[ $all = 0 ] || die "--forget takes one lost thread"
		f=${MATCH%"$NL"}
		name=$(jq -r '.thread.name // "the thread"' "$f" 2>/dev/null)
		if [ $yes = 0 ]; then
			have_tty || die "--forget needs a terminal to ask, or --yes"
			out=/dev/tty
			CARD_PAD="  "
			[ -n "${FZF_COLUMNS:-}" ] && card_place "$out" 6
			{
				card_row forget "$C_BOLD$name$C_OFF"
				card_row "" "${C_GREY}its conversation and worktree stay; weaver stops offering it$C_OFF"
				echo
				card_keys y forget n keep
			} >"$out"
			read_yes || return 130
		fi
		rm -f "$f"
		return 0
	fi
	need_session
	while IFS= read -r f; do
		[ -n "$f" ] || continue
		thread_restore "$f" || {
			echo "weaver: $RESTORE_ERR" >&2
			failed=$((failed + 1))
		}
	done <<<"$MATCH"
	push_status labels
	[ $failed = 0 ]
}

# weaver new [options] [task...]
cmd_new() {
	local repo="" from="" branch="" base="" where="" agent="" edit=0 sf start rc f
	TASK="" NOFOCUS=""
	while [ $# -gt 0 ]; do
		case $1 in
		--repo | --from | --branch | -b | --base | --agent)
			[ $# -ge 2 ] || die "$1 needs a value"
			case $1 in
			--repo) repo=$2 ;;
			--from) from=${2#terminal_} ;;
			--branch | -b) branch=$2 ;;
			--base) base=$2 ;;
			--agent) agent=$2 ;;
			esac
			shift
			;;
		--here) where=here ;;
		--worktree) where=worktree ;;
		--no-focus) NOFOCUS=1 ;;
		--edit | -e) edit=1 ;;
		--)
			shift
			TASK="${TASK:+$TASK }$*"
			break
			;;
		-h | --help)
			usage
			return 0
			;;
		-*) die "unknown option: $1 (see weaver help)" ;;
		*) TASK="${TASK:+$TASK }$1" ;;
		esac
		shift
	done
	[ -n "$SESSION" ] || die "not inside zellij or tmux: start it with \`weaver\`, then Alt N (or weaver new) there"
	case ${agent:-claude} in claude | codex) ;; *) die "unknown agent: $agent (claude or codex)" ;; esac

	# Where it starts: --repo; the agent of --from's repository; else here.
	start=$PWD
	if [ -n "$repo" ]; then
		start=$repo
		[ -d "$start" ] || die "no such directory: $repo"
	elif [ -n "$from" ]; then
		state_file "$from"
		f=$(jq -r '.root // .cwd // empty' "$SF" 2>/dev/null)
		[ -d "$f" ] || f=$(jq -r '.worktree // empty' "$STATE_DIR/${SKEY}_$from.thread" 2>/dev/null)
		[ -d "$f" ] && start=$f
	fi
	F_BRANCH=$branch F_WHERE=${where:-worktree} F_AGENT=${agent:-claude} F_BASE=$base
	if repo_of "$start"; then
		F_REPO=$REPO F_HERE=$CHECKOUT
	else
		[ -n "$repo" ] && die "not a git repository: $repo"
		F_REPO="" F_HERE=$(cd "$start" && pwd -P)
		# Not in a repository: the one you used last, for a new worktree.
		if [ -f "$STATE_DIR/repos" ]; then
			read -r f <"$STATE_DIR/repos" && [ -d "$f" ] && repo_of "$f" && F_REPO=$REPO
		fi
	fi

	if [ $edit = 1 ]; then
		f=$(mktemp "${TMPDIR:-/tmp}/weaver-task.XXXXXX") || die "cannot make a temporary file"
		[ -n "$TASK" ] && printf '%s\n' "$TASK" >"$f"
		${VISUAL:-${EDITOR:-vi}} "$f" </dev/tty >/dev/tty
		TASK=$(cat "$f")
		rm -f "$f"
		case $TASK in *[![:space:]]*) ;; *) return 130 ;; esac
	fi

	if [ -z "$TASK" ]; then
		[ -t 0 ] && [ -t 1 ] && command -v fzf >/dev/null 2>&1 ||
			die "what should the agent do? weaver new \"<task>\" (the form needs a terminal and fzf)"
		mkdir -p "$STATE_DIR"
		sf=$(mktemp "$STATE_DIR/form.XXXXXX") || die "cannot make the form's file"
		form_save "$sf"
		while :; do
			new_form "$sf"
			rc=$?
			[ $rc = 0 ] || {
				rm -f "$sf" "$sf.task"
				return $rc
			}
			thread_create && break
			# The worktree could not be made: its message is on screen.
			printf '\n%sweaver: no thread started.%s enter: back to the form   esc: cancel ' "$C_RED" "$C_OFF" >&2
			IFS= read -r -s -n 1 f </dev/tty
			case $f in $'\e') rm -f "$sf" "$sf.task" && return 130 ;; esac
		done
		rm -f "$sf" "$sf.task"
		return 0
	fi
	thread_check || die "$CHECK_ERR"
	thread_create || exit 1
}

# The agent's pane of a new thread (`weaver _agent TOKEN AGENT`). First run:
# record the thread for this pane, tell the nvim beside it where the agent is,
# and start the agent with the task. Run again (zellij offers to rerun an
# exited command): resume the agent's conversation, never send the task twice.
cmd_agent_pane() {
	local tok=${1:-} kind=${2:-claude} d task sid="" pane c name=""
	local -a ident=()
	need_session
	pane=${MY_PANE:-}
	d="$THREADS_NEW/${SKEY}_$tok"
	case $kind in claude | codex) ;; *) die "unknown agent: $kind" ;; esac
	agent_cmd "$kind"
	if [ -n "$tok" ] && [ -n "$pane" ] && [ -f "$d/task" ]; then
		task=$(cat "$d/task")
		c=$(jq -r '.cmd // empty' "$d/thread.json" 2>/dev/null)
		[ -n "$c" ] && AGENT_CMD=$c
		# Claude Code starts on a session id weaver chose, named for the
		# thread: the thread knows its conversation before its first hook, so
		# it can be resumed (never `--continue`, which takes the directory's
		# latest conversation, maybe another's).
		if [ "$kind" = claude ]; then
			sid=$(uuidgen 2>/dev/null | tr 'A-F' 'a-f')
			name=$(jq -r '.name // empty' "$d/thread.json" 2>/dev/null)
			[ -n "$sid" ] && ident=(--session-id "$sid")
			[ -n "$name" ] && ident=(${ident[@]+"${ident[@]}"} -n "$name")
		fi
		if [ -f "$d/thread.json" ]; then
			jq -c --argjson pane "$pane" --arg sid "$sid" '. + {pane: $pane} + (if $sid != "" then {session_id: $sid} else {} end)' \
				"$d/thread.json" >"$STATE_DIR/${SKEY}_$pane.thread.$$" &&
				mv -f "$STATE_DIR/${SKEY}_$pane.thread.$$" "$STATE_DIR/${SKEY}_$pane.thread"
		fi
		rm -f "$d/task" || die "cannot take the task from $d"
		printf '%s\n' "$pane" >"$d/pane.$$" && mv -f "$d/pane.$$" "$d/pane"
		# A task starting with "-" is not an option.
		case $task in -*) task=" $task" ;; esac
		# shellcheck disable=SC2086
		exec $AGENT_CMD ${ident[@]+"${ident[@]}"} "$task"
	fi
	# A lost thread brought back (weaver resume): its record and its state for
	# this pane, then its conversation, resumed.
	if [ -n "$tok" ] && [ -n "$pane" ] && [ -f "$d/resume" ]; then
		sid=$(cat "$d/resume")
		c=$(jq -r '.cmd // empty' "$d/thread.json" 2>/dev/null)
		[ -n "$c" ] && AGENT_CMD=$c
		# A dead agent's files under this pane id (an earlier zellij's) go
		# first: kept as lost when they are, else forgotten.
		state_file "$pane"
		if [ -f "$SF" ]; then
			peek_state
			[ -n "$PK_PID" ] && agent_alive "$PK_PID" "$PK_START" || retire "$SF" "$PK_PID"
		fi
		jq -c --argjson pane "$pane" '. + {pane: $pane}' "$d/thread.json" >"$STATE_DIR/${SKEY}_$pane.thread.$$" &&
			mv -f "$STATE_DIR/${SKEY}_$pane.thread.$$" "$STATE_DIR/${SKEY}_$pane.thread"
		jq -c --argjson pane "$pane" '. + {pane: $pane}' "$d/state.json" >"$SF.$$" && mv -f "$SF.$$" "$SF"
		rm -f "$d/resume" "$d/state.json"
		printf '%s\n' "$pane" >"$d/pane.$$" && mv -f "$d/pane.$$" "$d/pane"
		# shellcheck disable=SC2086
		case $kind in
		claude) exec $AGENT_CMD --resume "$sid" ;;
		codex) exec $AGENT_CMD resume "$sid" ;;
		esac
	fi
	# Its pane again (enter on an exited agent): the conversation it was in,
	# else the one weaver started it on.
	[ -n "$pane" ] && sid=$(jq -r '.session_id // empty' "$STATE_DIR/${SKEY}_$pane.json" 2>/dev/null)
	[ -n "$pane" ] && [ -z "$sid" ] && sid=$(jq -r '.session_id // empty' "$STATE_DIR/${SKEY}_$pane.thread" 2>/dev/null)
	c=$(jq -r '.cmd // empty' "$STATE_DIR/${SKEY}_$pane.thread" 2>/dev/null)
	[ -n "$c" ] && AGENT_CMD=$c
	# shellcheck disable=SC2086
	case $kind in
	claude) if [ -n "$sid" ]; then exec $AGENT_CMD --resume "$sid"; else exec $AGENT_CMD --continue; fi ;;
	codex) if [ -n "$sid" ]; then exec $AGENT_CMD resume "$sid"; else exec $AGENT_CMD resume --last; fi ;;
	esac
}

# The agent of pane $1 into AGENT: the pane itself when it is an agent (it
# has state, a thread record or an nvim), or the agent whose nvim it is.
agent_of_pane() {
	local p=$1 f q
	AGENT=""
	case $p in '' | *[!0-9]*) return 1 ;; esac
	for f in json thread nvim; do
		if [ -f "$STATE_DIR/${SKEY}_$p.$f" ]; then
			AGENT=$p
			return 0
		fi
	done
	session_files nvim
	for f in ${FOUND[@]+"${FOUND[@]}"}; do
		q=""
		{ read -r q <"$f"; } 2>/dev/null
		if [ "$q" = "$p" ]; then
			AGENT=${f#"$STATE_DIR/${SKEY}_"}
			AGENT=${AGENT%.nvim}
			return 0
		fi
	done
	return 1
}

# ------------------------------------------------ closing a thread

# The one agent in the tab of pane $1 (none when there are several).
tab_agent() {
	local p found=""
	for p in $(printf '%s' "$PANES" | jq -r --arg me "$1" '
		(map(select((.is_plugin | not) and (.id | tostring) == $me)) | .[0].tab_id) as $t
		| .[] | select((.is_plugin | not) and (.is_floating | not) and .tab_id == $t) | .id'); do
		[ -f "$STATE_DIR/${SKEY}_$p.json" ] || [ -f "$STATE_DIR/${SKEY}_$p.thread" ] || continue
		[ -z "$found" ] || return 0
		found=$p
	done
	printf '%s\n' "$found"
}

# The thread record of agent pane $1 into TH_*; returns 1 (TH_NAME empty)
# when the agent is not a weaver thread.
thread_read() {
	local info
	TH_NAME="" TH_TASK="" TH_REPO="" TH_BRANCH="" TH_DIR="" TH_HERE="" TH_CREATED="" TH_AGENT=""
	[ -f "$STATE_DIR/${SKEY}_$1.thread" ] || return 1
	info=$(jq -r '[.name, .task, .repo, .branch, .worktree, .here, .worktree_created, .agent]
		| map(. // "" | tostring | gsub("[\u0000-\u001f]+"; " ")) | join("\u001f")' \
		"$STATE_DIR/${SKEY}_$1.thread" 2>/dev/null) || return 1
	IFS=$US read -r TH_NAME TH_TASK TH_REPO TH_BRANCH TH_DIR TH_HERE TH_CREATED TH_AGENT <<<"$info"
	[ -n "$TH_NAME" ]
}

plural() { [ "$1" = 1 ] || printf s; }

# May worktree $1 be removed? Only a linked worktree (not the main checkout),
# not locked, with nothing uncommitted or untracked, whose HEAD is merged into
# the default branch or pushed to its upstream. Into WT_WHY: why not.
worktree_removable() {
	local dir=$1 gd cd n ref up ahead
	WT_WHY=""
	[ -d "$dir" ] || {
		WT_WHY="it is gone"
		return 1
	}
	gd=$(git -C "$dir" rev-parse --path-format=absolute --git-dir 2>/dev/null) &&
		cd=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || {
		WT_WHY="it is not a git worktree"
		return 1
	}
	[ "$gd" != "$cd" ] || {
		WT_WHY="it is the main checkout"
		return 1
	}
	[ -f "$gd/locked" ] && {
		WT_WHY="it is locked"
		return 1
	}
	n=$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
	[ "${n:-1}" = 0 ] || {
		WT_WHY="$n uncommitted file$(plural "$n")"
		return 1
	}
	for ref in origin/HEAD upstream/HEAD main master; do
		git -C "$dir" rev-parse --verify --quiet "$ref^{commit}" >/dev/null 2>&1 || continue
		git -C "$dir" merge-base --is-ancestor HEAD "$ref" 2>/dev/null && return 0
	done
	if up=$(git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
		ahead=$(git -C "$dir" rev-list --count '@{u}..HEAD' 2>/dev/null)
		[ "$ahead" = 0 ] && return 0
		WT_WHY="${ahead:-its} commit$(plural "${ahead:-2}") not pushed to $up"
		return 1
	fi
	WT_WHY="its commits are neither merged nor pushed"
	return 1
}

# Panes of this session whose directory is in $1, into USERS: not those in
# $2 (a space-separated list), not the floating panes of tab $3 (they close
# with it), and not thread sidebars (they use no files).
worktree_users() {
	USERS=$(printf '%s' "$PANES" | jq -r --arg d "$1" --arg skip " $2 " --arg tab "${3:-}" '
		[.[] | (.id | tostring) as $i
		| select((.is_plugin | not) and (.exited | not)
			and ($skip | contains(" " + $i + " ") | not)
			and ((.is_floating and (.tab_id | tostring) == $tab) | not)
			and ((.terminal_command // "") | test(" sidebar$") | not)
			and ((.pane_cwd // "") as $c | $c == $d or ($c | startswith($d + "/"))))
		| $i] | join(" ")')
}

# A row of a card: label $1 (grey, right-aligned like the form's), text $2.
card_row() { printf '%s%s%6s%s  %s\n' "$CARD_PAD" "$C_GREY" "$1" "$C_OFF" "$2"; }

# The keys under a card: pairs of key and what it does.
card_keys() {
	local out=""
	while [ $# -ge 2 ]; do
		out="$out$C_GREY$1$C_OFF $C_DIM$2$C_OFF   "
		shift 2
	done
	printf '%s%8s%s\n' "$CARD_PAD" "" "${out%   }"
}

# Is there a terminal to ask on?
have_tty() { { : </dev/tty; } 2>/dev/null; }

# A key from the terminal; true on y or Y.
read_yes() {
	local a=""
	IFS= read -r -s -n 1 a </dev/tty
	case $a in y | Y) return 0 ;; esac
	return 1
}

# Clear terminal $1 and set CARD_PAD so a card about $2 rows and 64 columns
# sits in its middle (a third of the way down).
card_place() {
	local size rows=0 cols=0 top
	size=$({ stty size <"$1"; } 2>/dev/null)
	rows=${size% *} cols=${size#* }
	case $rows$cols in '' | *[!0-9]*) return 0 ;; esac
	top=$(((rows - $2) / 3))
	[ $top -gt 0 ] || top=0
	# Cursor moves, not newlines: nothing scrolls into the pane's history.
	printf '\033[H\033[2J\033[%d;1H' $((top + 1)) >"$1"
	[ $cols -gt 72 ] && printf -v CARD_PAD '%*s' $(((cols - 64) / 2)) ''
	return 0
}

# weaver close [--yes] [--remove-worktree] [pane]
cmd_close() {
	local yes=0 rmwt=0 target="" nv tab others name what="" n="" st pid start title kind remove=0 detach=0 info
	local keep="" removable=0 out goes sides=""
	while [ $# -gt 0 ]; do
		case $1 in
		--yes | -y) yes=1 ;;
		--remove-worktree) rmwt=1 ;;
		-*) die "usage: weaver close [--yes] [--remove-worktree] [pane-id]" ;;
		*) target=${1#terminal_} target=${target#%} ;;
		esac
		shift
	done
	need_session
	list_panes || die "$MUX would not list the panes"
	if [ -z "$target" ]; then
		# The focused pane's agent; else this pane's; else the one agent in
		# this pane's tab (run from a shell beside a thread).
		focused_pane
		target=$FOCUSED
		agent_of_pane "$target" || target=${MY_PANE:-}
		agent_of_pane "$target" || target=$(tab_agent "${MY_PANE:-}")
	fi
	agent_of_pane "$target" || die "no agent in pane ${target:-?}"
	read_nvim_pane "$AGENT"
	nv=$NV
	thread_read "$AGENT"
	state_file "$AGENT"
	info=$(jq -r '[.state // "", .pid // "", .proc_start // "", .title // "", .agent // ""]
		| map(tostring) | join("\u001f")' "$SF" 2>/dev/null)
	IFS=$US read -r st pid start title kind <<<"$info"
	tab=$(printf '%s' "$PANES" | jq -r --arg p "$AGENT" \
		'map(select((.is_plugin | not) and (.id | tostring) == $p)) | .[0].tab_id // empty')
	# The tab's other panes, which close must leave alone (and which keep it open).
	others=$(printf '%s' "$PANES" | jq -r --arg t "$tab" --arg a "$AGENT" --arg nv "${nv:-x}" '
		[.[] | select((.is_plugin | not) and (.is_floating | not) and (.tab_id | tostring) == $t
			and (.id | tostring) != $a and (.id | tostring) != $nv
			and ((.terminal_command // "") | test(" sidebar$") | not)) | .id] | join(" ")')
	# The thread sidebar of its tab (the weaver session) goes with the tab.
	sides=$(printf '%s' "$PANES" | jq -r --arg t "$tab" '
		[.[] | select((.is_plugin | not) and (.tab_id | tostring) == $t
			and ((.terminal_command // "") | test(" sidebar$"))) | .id] | join(" ")')
	[ -n "$others" ] && sides=""

	name=${TH_NAME:-${title:-${kind:-agent} in pane $AGENT}}
	case $st in
	needs-you) what="${C_RED}needs you$C_OFF" ;;
	done) what="${C_GREEN}done$C_OFF" ;;
	working) what=working ;;
	'') what="${C_GREY}starting$C_OFF" ;;
	*) what="$C_GREY$st$C_OFF" ;;
	esac
	if [ -n "$nv" ]; then
		sock_path "$AGENT"
		n=$(bounded /dev/stdout nvim --server "$SOCK" --remote-expr \
			'len(filter(getbufinfo({"bufmodified": 1}), "v:val.listed"))' 2>/dev/null)
		case $n in '' | *[!0-9]* | 0) n="" ;; esac
	fi
	# Its worktree may go only if weaver made it and nothing would be lost.
	if [ "$TH_CREATED" = true ] && [ "$TH_HERE" != true ] && [ -n "$TH_DIR" ]; then
		form_path "$TH_DIR"
		worktree_users "$TH_DIR" "$AGENT ${nv:-} ${MY_PANE:-}" "$tab"
		if ! worktree_removable "$TH_DIR"; then
			keep="$TILDE ${C_DIM}·$C_OFF$C_GREY $WT_WHY"
		elif [ -n "$USERS" ]; then
			keep="$TILDE ${C_DIM}·$C_OFF$C_GREY pane $USERS is in it"
		else
			removable=1
		fi
	fi

	out=/dev/stdout
	[ $yes = 1 ] || {
		have_tty || die "close needs a terminal to ask, or --yes"
		out=/dev/tty
	}
	goes="the agent"
	[ -n "$nv" ] && goes="the agent and its nvim"
	[ -z "$others" ] && [ -n "$TH_NAME" ] && goes="the agent${nv:+, its nvim} and the tab"
	# The card: in fzf's place (the dashboard ran this), on a clean screen,
	# in the middle; else where the cursor is.
	CARD_PAD="  "
	if [ $yes = 0 ] && [ -n "${FZF_COLUMNS:-}" ]; then
		card_place "$out" 8
	fi
	{
		card_row close "$C_BOLD$name$C_OFF"
		card_row "" "$what ${C_DIM}·$C_OFF $C_GREY${kind:-claude}$C_OFF"
		card_row goes "$goes"
		[ -n "$n" ] && card_row "" "${C_RED}its nvim has $n unsaved buffer$(plural "$n")$C_OFF"
		[ -n "$keep" ] && card_row stays "$C_GREY$keep$C_OFF"
		if [ $yes = 0 ]; then
			echo
			card_keys y close n keep
		fi
	} >"$out"
	[ $yes = 1 ] || read_yes || exit 130
	if [ $removable = 1 ]; then
		if [ $rmwt = 1 ]; then
			remove=1
		elif have_tty; then
			{
				echo
				card_row remove "the worktree $TILDE ${C_GREY}· branch ${TH_BRANCH:-?} stays$C_OFF"
				echo
				card_keys y remove n keep
			} >/dev/tty
			read_yes && remove=1
		fi
	fi

	# Closing the last panes of the tab closes the tab, and any floating pane
	# in it: when this runs in one, finish from outside it.
	if [ -z "$others" ] && [ -n "${MY_PANE:-}" ] && printf '%s' "$PANES" | jq -e --arg t "$tab" \
		--arg me "$MY_PANE" 'any(.[]; (.is_plugin | not) and (.id | tostring) == $me and (.tab_id | tostring) == $t)' \
		>/dev/null 2>&1; then
		detach=1
	fi
	set -- "$AGENT" "${nv:-}" "${pid:-}" "${start:-}" "$remove" "${TH_DIR:-}" "${TH_REPO:-}" "$sides"
	if [ $detach = 1 ]; then
		mkdir -p "$STATE_DIR"
		# Out of this pane's session, and deaf to the hangup its closing sends
		# (also while it is still on its way out).
		trap '' HUP TERM
		perl -e 'use POSIX qw(setsid); setsid(); exec @ARGV or exit 1' "$SELF" _close "$@" \
			</dev/null >>"$STATE_DIR/close.log" 2>&1 &
		exit 0
	fi
	close_tail "$@"
}

# The closing itself (`weaver _close AGENT NVIM PID START REMOVE DIR REPO
# [SIDEBARS]`):
# close the agent's pane and its nvim's, wait for the agent to exit, forget
# it, and remove its worktree if asked, checking again first.
close_tail() {
	local agent=$1 nv=$2 pid=$3 start=$4 remove=$5 dir=$6 repo=$7 sides=${8:-} i rc p
	need_session
	mux_close_pane "$agent"
	[ -n "$nv" ] && mux_close_pane "$nv"
	for p in $sides; do mux_close_pane "$p"; done
	for ((i = 0; i < 50; i++)); do
		[ -n "$pid" ] && agent_alive "$pid" "$start" || break
		sleep 0.1
	done
	if [ -n "$pid" ] && agent_alive "$pid" "$start"; then
		echo "weaver: the agent (pid $pid) is still running; its worktree stays" >&2
		remove=0
	fi
	state_file "$agent"
	if [ -f "$SF" ]; then
		forget "$SF" "$pid"
	else
		rm -f "${SF%.json}.nvim" "${SF%.json}.thread"
	fi
	if [ "$remove" = 1 ]; then
		tildify "$dir"
		if ! worktree_removable "$dir"; then
			echo "weaver: kept $TILDE: $WT_WHY" >&2
			rc=1
		elif [ "${WEAVER_WORKTRUNK:-1}" != 0 ] && command -v wt >/dev/null 2>&1; then
			wt -C "${repo:-$dir}" remove --no-delete-branch --foreground "$dir" </dev/null
			rc=$?
		else
			git -C "${repo:-$dir}" worktree remove "$dir"
			rc=$?
		fi
		[ "$rc" = 0 ] && echo "weaver: removed $TILDE"
	fi
	push_status
	return "${rc:-0}"
}

# ---------------------------------------------------------------- the weaver session
#
# `weaver` starts zellij with weaver's own layout: a home tab first (`weaver
# home`), then the threads' tabs in their numbers' order, each with the
# thread sidebar on its left, and one status line instead of the tab bar.
# Its config is yours with weaver's session keys added (Alt j/k: the next and
# previous tab, Alt y: home and back). $STATE_DIR/<skey>.layout says "weaver"
# for it.

ZDIR=${ZELLIJ_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/zellij}

# Was this session started from weaver's layout?
weaver_session() {
	local l=""
	{ read -r l <"$STATE_DIR/$SKEY.layout"; } 2>/dev/null
	[ "$l" = weaver ]
}

# Print the config with file `snip` added before the brace that closes its
# first top-level keybinds block (braces in strings and after // don't count).
AWK_KEYS_END='
function depth(s,   i, c, d, q) {
	d = 0; q = 0
	for (i = 1; i <= length(s); i++) {
		c = substr(s, i, 1)
		if (q) { if (c == "\\") i++; else if (c == "\"") q = 0 }
		else if (c == "\"") q = 1
		else if (c == "/" && substr(s, i + 1, 1) == "/") break
		else if (c == "{") d++
		else if (c == "}") d--
	}
	return d
}
!done && !inb && /^[[:space:]]*keybinds([[:space:]]+clear-defaults=true)?[[:space:]]*[{]/ { inb = 1; d = 0 }
inb {
	n = depth($0)
	if (d > 0 && d + n <= 0) {
		while ((getline l < snip) > 0) print "    " l
		inb = 0; done = 1
	}
	d += n
}
{ print }'

# The weaver session's zellij config, into SESSION_CONFIG: yours
# ($ZELLIJ_CONFIG_FILE, else config.kdl) with the session keys
# (weaver-keys.kdl beside it, else weaver's) at the end of its keybinds,
# where they win over yours (zellij 0.45.1: within one block the later
# binding of a key wins; in a second keybinds block it would lose). Its
# layout and theme directories stay yours.
session_config() {
	local src=${ZELLIJ_CONFIG_FILE:-$ZDIR/config.kdl} keys=$ZDIR/weaver-keys.kdl
	[ -f "$keys" ] || keys="$(script_dir)/config/zellij-session-keys.kdl"
	SESSION_CONFIG="$STATE_DIR/zellij-session.kdl"
	mkdir -p "$STATE_DIR"
	{
		if [ -f "$src" ] && grep -Eq '^[[:space:]]*keybinds([[:space:]]+clear-defaults=true)?[[:space:]]*[{]' "$src"; then
			awk -v snip="$keys" "$AWK_KEYS_END" "$src"
		else
			[ -f "$src" ] && cat "$src"
			echo "keybinds {"
			sed 's/^/    /' "$keys"
			echo "}"
		fi
		# (zellij refuses a config whose theme_dir is missing.)
		[ -d "$ZDIR/layouts" ] && ! grep -Eq '^[[:space:]]*layout_dir[[:space:]]' "$src" 2>/dev/null &&
			echo "layout_dir \"$ZDIR/layouts\""
		[ -d "$ZDIR/themes" ] && ! grep -Eq '^[[:space:]]*theme_dir[[:space:]]' "$src" 2>/dev/null &&
			echo "theme_dir \"$ZDIR/themes\""
		true
	} | awk '!/^[[:space:]]*session_serialization[[:space:]]/' >"$SESSION_CONFIG.$$" &&
		# weaver brings the session's threads back itself (weaver resume):
		# zellij's resurrection would rerun each agent's command line, a new
		# conversation sent the task again, beside nvims bound to nothing.
		echo "session_serialization false" >>"$SESSION_CONFIG.$$" &&
		mv -f "$SESSION_CONFIG.$$" "$SESSION_CONFIG"
}

# The weaver session's layout, into SESSION_LAYOUT: $WEAVER_LAYOUT, else
# layouts/weaver.kdl in your zellij config, else weaver's own.
session_layout() {
	SESSION_LAYOUT=${WEAVER_LAYOUT:-$ZDIR/layouts/weaver.kdl}
	[ -f "$SESSION_LAYOUT" ] || SESSION_LAYOUT="$(script_dir)/config/weaver-layout.kdl"
}

# `weaver` alone: outside zellij, attach to the weaver session, or start it
# from weaver's layout; inside, the dashboard.
cmd_start() {
	local name line state=""
	if [ -n "$SESSION" ]; then
		cmd_ls
		return
	fi
	name=${1:-${WEAVER_SESSION:-weaver}}
	[ "$MUX" = tmux ] && tmux_start "$name"
	command -v zellij >/dev/null 2>&1 || die "zellij is not installed"
	while IFS= read -r line; do
		case $line in
		"$name "*EXITED*) state=exited ;;
		"$name "*) state=running ;;
		esac
	done <<EOF2
$(zellij list-sessions --no-formatting 2>/dev/null)
EOF2
	SKEY=${name//\//_}
	case $state in
	running) exec zellij attach "$name" ;;
	exited)
		# weaver's own session, saved by zellij (before weaver turned that
		# off): its resurrection would rerun each agent's last command line,
		# so start it afresh instead, and its home brings the threads back.
		# One from before weaver's layout is in the way, and only you may
		# delete it.
		weaver_session ||
			die "an exited zellij session named $name (from before weaver's layout) is in the way: zellij delete-session $name, then weaver again"
		zellij delete-session "$name" 2>/dev/null
		;;
	esac
	session_config
	session_layout
	echo weaver >"$STATE_DIR/$SKEY.layout"
	rm -f "${STATE_DIR:?}/${SKEY:?}.last"
	exec zellij --config "$SESSION_CONFIG" --session "$name" --new-session-with-layout "$SESSION_LAYOUT"
}

# The weaver session in tmux, on weaver's own server (tmux -L weaver, with
# config/tmux.conf, read again each time, so an install reaches a running
# server): attach to it, or start it with home in window 0. Its
# panes know their session ($WEAVER_TMUX_SESSION); zellij's variables, from a
# zellij this was started in, stay out of it.
tmux_start() {
	local name=$1 conf here
	command -v tmux >/dev/null 2>&1 || die "tmux is not installed"
	SKEY="tmux-${name//\//_}"
	conf="$(script_dir)/config/tmux.conf"
	[ -f "$conf" ] || die "missing $conf"
	set -- env -u ZELLIJ -u ZELLIJ_SESSION_NAME -u ZELLIJ_PANE_ID -u TMUX -u TMUX_PANE \
		tmux "${TSOCK[@]}" -f "$conf"
	if "$@" has-session -t "=$name" 2>/dev/null; then
		exec "$@" source-file "$conf" \; attach-session -t "=$name"
	fi
	mkdir -p "$STATE_DIR"
	echo weaver >"$STATE_DIR/$SKEY.layout"
	rm -f "${STATE_DIR:?}/${SKEY:?}.last"
	# The server keeps the directory it starts in: from /, never a worktree
	# weaver close may remove under it (its new panes would die at once).
	here=$PWD
	cd / || die "cannot cd /"
	exec "$@" new-session -s "$name" -n home -c "$here" -e "WEAVER_TMUX_SESSION=$name" "$SELF" home \; \
		set-environment -t "=$name" WEAVER_TMUX_SESSION "$name" \; source-file "$conf"
}

# weaver send [--force] PANE < TEXT: the text to agent PANE's prompt, as if
# you typed it (a bracketed paste, then enter): review notes from its nvim
# (:AgentSend). Only while it waits for you to say more (idle, done,
# interrupted, as the board has it): typed into a dialog it could choose an
# answer, and the board says when it is free. --force sends anyway (Claude
# Code queues what you type while it works).
cmd_send() {
	local pane="" force=0 text st="" p s
	while [ $# -gt 0 ]; do
		case $1 in
		--force) force=1 ;;
		-*) die "usage: weaver send [--force] PANE < TEXT" ;;
		*) pane=${1#terminal_} pane=${pane#%} ;;
		esac
		shift
	done
	case $pane in '' | *[!0-9]*) die "usage: weaver send [--force] PANE < TEXT" ;; esac
	[ -t 0 ] && die "usage: weaver send [--force] PANE < TEXT"
	need_session
	[ "$MUX" = tmux ] || die "weaver send needs tmux"
	text=$(cat)
	case $text in *[![:space:]]*) ;; *) die "nothing to send" ;; esac
	agent_rows
	while IFS=$US read -r p _ s _; do
		[ "$p" = "$pane" ] && st=$s && break
	done <<EOF2
$AGENT_ROWS
EOF2
	[ -n "$st" ] || die "no agent in pane $pane"
	if [ $force = 0 ]; then
		case $st in
		idle | done | interrupted) ;;
		needs-you) die "the agent waits on a dialog: answer it first (or --force)" ;;
		*) die "the agent is $st: send when it waits for you (or --force)" ;;
		esac
	fi
	printf '%s' "$text" | tm load-buffer -b weaver-send - || die "tmux would not take the text"
	tm paste-buffer -p -d -b weaver-send -t "%$pane" || die "tmux would not paste into pane $pane"
	sleep 0.2
	tm send-keys -t "%$pane" Enter
}

# weaver quit [--yes]: quit the zellij session you are in (outside zellij,
# the weaver session, $WEAVER_SESSION) with every agent and nvim in it, after
# asking. Its threads are kept, as when zellij goes: the weaver session brings
# them back as it starts again, `weaver resume` any other's. zellij's own
# Ctrl q quits the same way, without asking.
cmd_quit() {
	local yes=0 name line running="" f p n threads=0 work=0 bufs=0 out back
	local -a states=()
	while [ $# -gt 0 ]; do
		case $1 in
		--yes | -y) yes=1 ;;
		-h | --help)
			usage
			return 0
			;;
		*) die "usage: weaver quit [--yes]" ;;
		esac
		shift
	done
	name=${SESSION:-${WEAVER_SESSION:-weaver}}
	if [ "$MUX" = tmux ]; then
		tm has-session -t "=$name" 2>/dev/null && running=1
		SKEY="tmux-${name//\//_}"
	else
		command -v zellij >/dev/null 2>&1 || die "zellij is not installed"
		while IFS= read -r line; do
			case $line in "$name "*EXITED*) ;; "$name "*) running=1 ;; esac
		done <<EOF2
$(zellij list-sessions --no-formatting 2>/dev/null)
EOF2
		SKEY=${name//\//_}
	fi
	[ -n "$running" ] || die "no $MUX session $name is running"
	if [ $yes = 0 ]; then
		have_tty || die "quit needs a terminal to ask, or --yes"
		for f in "$STATE_DIR/$SKEY"_*.thread; do [ -f "$f" ] && threads=$((threads + 1)); done
		# What stops: turns under way, and edits not yet saved in the
		# agents' nvims.
		for f in "$STATE_DIR/$SKEY"_*.json; do
			[ -f "$f" ] || continue
			p=${f##*_} p=${p%.json}
			case $p in '' | *[!0-9]*) continue ;; esac
			states[${#states[@]}]=$f
			sock_path "$p"
			[ -S "$SOCK" ] || continue
			n=$(bounded /dev/stdout nvim --server "$SOCK" --remote-expr \
				'len(filter(getbufinfo({"bufmodified": 1}), "v:val.listed"))' 2>/dev/null)
			case $n in '' | *[!0-9]*) ;; *) bufs=$((bufs + n)) ;; esac
		done
		[ ${#states[@]} -gt 0 ] &&
			work=$(jq -s 'map(select(.state == "working")) | length' "${states[@]}" 2>/dev/null)
		case $work in '' | *[!0-9]*) work=0 ;; esac
		back="weaver resume brings them back"
		weaver_session && back="back when you start weaver"
		out=/dev/tty
		CARD_PAD="  "
		[ -n "${FZF_COLUMNS:-}" ] && card_place "$out" 7
		{
			card_row quit "$C_BOLD$name$C_OFF ${C_DIM}·$C_OFF ${C_GREY}every agent and nvim in it$C_OFF"
			[ $threads -gt 0 ] && card_row kept "$threads thread$(plural "$threads") ${C_DIM}·$C_OFF $C_GREY$back$C_OFF"
			[ "$work" -gt 0 ] && card_row "" "$C_GREY$work working: the turn$(plural "$work") stop$([ "$work" = 1 ] && printf s)$C_OFF"
			[ $bufs -gt 0 ] && card_row "" "${C_RED}nvim has $bufs unsaved buffer$(plural "$bufs")$C_OFF"
			echo
			card_keys y quit n keep
		} >"$out"
		read_yes || return 130
	fi
	if [ "$MUX" = tmux ]; then
		tm kill-session -t "=$name" 2>/dev/null || die "tmux could not quit $name"
	else
		zellij kill-session "$name" 2>/dev/null || die "zellij could not quit $name"
	fi
}

# Serialise numbering threads (weaver new): a lock older than 10s was left
# by a killed process.
num_lock() {
	local d="$STATE_DIR/$SKEY.num.lock" i=0 t now
	mkdir -p "$STATE_DIR"
	until mkdir "$d" 2>/dev/null; do
		t=0
		{ read -r t <"$d/at"; } 2>/dev/null
		now=$(date +%s)
		case $t in '' | *[!0-9]*) t=$now ;; esac
		if [ $((now - t)) -gt 10 ]; then
			rm -rf "${d:?}"
			continue
		fi
		i=$((i + 1))
		[ $i -ge 50 ] && break
		sleep 0.1
	done
	date +%s >"$d/at" 2>/dev/null
}
num_unlock() { rm -rf "${STATE_DIR:?}/${SKEY:?}.num.lock"; }

# The lowest number none of this session's threads has (those being opened
# included), into NUM; the numbers taken, space-separated, into NUMS_USED.
thread_num() {
	local used=" " f n
	local -a files=()
	for f in "$STATE_DIR/${SKEY}"_*.thread "$THREADS_NEW/${SKEY}"_*/thread.json; do
		[ -f "$f" ] && files[${#files[@]}]=$f
	done
	if [ ${#files[@]} -gt 0 ]; then
		for n in $(jq -r '.num // empty' "${files[@]}" 2>/dev/null); do used="$used$n "; done
	fi
	NUMS_USED=$used
	NUM=1
	while case $used in *" $NUM "*) true ;; *) false ;; esac do NUM=$((NUM + 1)); done
}

# Thread tab $1 (number $2) to its place: after home, among the threads in
# their numbers' order (zellij adds a tab at the end). Other tabs keep their
# places after the threads.
thread_place() {
	local tab=$1 num=$2 nums="{}" f moves
	case $tab$num in '' | *[!0-9]*) return 0 ;; esac
	# tmux: the window's index is the thread's number (home is 0), when free.
	if [ "$MUX" = tmux ]; then
		tm move-window -d -s "@$tab" -t "=$SESSION:$num" >/dev/null 2>&1
		return 0
	fi
	list_panes || return 0
	for f in "$STATE_DIR/${SKEY}"_*.thread; do
		[ -f "$f" ] || continue
		nums=$(jq -c --argjson m "$nums" '$m + {(.pane | tostring): .num}' "$f" 2>/dev/null) || nums="{}"
	done
	moves=$(zellij action list-tabs -j 2>/dev/null | jq -r --argjson panes "$PANES" --argjson nums "$nums" \
		--argjson tab "$tab" --argjson num "$num" '
		(map({key: (.tab_id | tostring), value: .position}) | from_entries) as $pos
		| [$panes[] | select((.is_plugin | not) and ($nums[.id | tostring] != null))
			| {tab: .tab_id, num: $nums[.id | tostring]}] as $threads
		| ([$threads[] | select(.num < $num and .tab != $tab) | $pos[.tab | tostring]] | max) as $lower
		| ([.[] | select(.name == "home") | .position] | first) as $home
		| (($lower // $home // -1) + 1) as $target
		| ($pos[$tab | tostring] // $target) - $target | if . > 0 then . else 0 end' 2>/dev/null)
	case $moves in '' | *[!0-9]*) return 0 ;; esac
	while [ "$moves" -gt 0 ]; do
		zellij action move-tab -t "$tab" left >/dev/null 2>&1 || return 0
		moves=$((moves - 1))
	done
}

# Alt y in the weaver session (`weaver go home`, from a tiny floating pane):
# from home back to the tab you came from; from anywhere else, home (made
# again first if it was closed).
cmd_go() {
	local where=${1:-} cur home last="" t
	[ "$where" = home ] || die "usage: weaver go home"
	need_session
	# One question to zellij: the tabs, which is active, which is home.
	t=$(mux_tabs)
	read -r cur home <<<"$(printf '%s' "$t" | jq -r '[([.[] | select(.active) | .tab_id] | first // ""),
		([.[] | select(.name == "home") | .tab_id] | first // "")] | map(tostring) | join(" ")')"
	if [ -n "$home" ] && [ "$cur" = "$home" ]; then
		{ read -r last <"$STATE_DIR/$SKEY.last"; } 2>/dev/null
		case $last in '' | *[!0-9]*) return 0 ;; esac
		printf '%s' "$t" | jq -e --argjson l "$last" 'any(.[]; .tab_id == $l)' >/dev/null 2>&1 || return 0
		mux_go_tab "$last"
		return 0
	fi
	[ -n "$cur" ] && printf '%s\n' "$cur" >"$STATE_DIR/$SKEY.last"
	if [ -z "$home" ] && [ "$MUX" = tmux ]; then
		tm new-window -t "=$SESSION:0" -n home -e "WEAVER_TMUX_SESSION=$SESSION" "$SELF" home >/dev/null 2>&1 ||
			tm new-window -t "=$SESSION:" -n home -e "WEAVER_TMUX_SESSION=$SESSION" "$SELF" home >/dev/null 2>&1
		return 0
	fi
	if [ -z "$home" ]; then
		kdl_str "$SELF"
		home=$(zellij action new-tab --name home --layout-string "layout { tab { pane name=\"home\" command=$K { args \"home\"; }; }; }") ||
			return 0
		thread_place "$home" 0
		return 0
	fi
	mux_go_tab "$home"
}

# The sidebar's own tab, to the window (`weaver _sidefit`, from the sidebar,
# at its start and when it is resized): open from 160 columns, a rail below
# (a toggle of yours, Alt [ / Alt ], holds until the window crosses 160
# again); and the agent at its width (thread_width).
cmd_sidefit() {
	local info tab cols width want have mem="" agent
	[ "$MUX" = tmux ] && return 0
	weaver_session || return 0
	list_panes || return 0
	info=$(printf '%s' "$PANES" | jq -r --arg me "${MY_PANE:-}" \
		'map(select((.is_plugin | not) and (.id | tostring) == $me)) | .[0] // empty | "\(.tab_id) \(.pane_columns)"')
	read -r tab width <<<"$info"
	case $tab$width in '' | *[!0-9]*) return 0 ;; esac
	cols=$(zellij action list-tabs -j 2>/dev/null | jq -r --argjson t "$tab" '.[] | select(.tab_id == $t) | .viewport_columns')
	case $cols in '' | *[!0-9]* | 0) return 0 ;; esac
	want=open
	[ "$cols" -lt 160 ] && want=rail
	have=open
	[ $((width * 100 / cols)) -lt $(((SIDE_OPEN + SIDE_RAIL) / 2)) ] && have=rail
	{ read -r mem <"$STATE_DIR/$SKEY.side.$tab"; } 2>/dev/null
	if [ "$mem" != "$want" ]; then
		printf '%s\n' "$want" >"$STATE_DIR/$SKEY.side.$tab"
		[ "$have" = "$want" ] || zellij action next-swap-layout -t "$tab" >/dev/null 2>&1
	fi
	# The agent keeps its share of the new width, and at least its minimum
	# (a percentage alone would narrow it with the window).
	agent=$(printf '%s' "$PANES" | jq -r --argjson t "$tab" '.[] | select((.is_plugin | not) and .tab_id == $t) | .id' |
		while read -r p; do [ -f "$STATE_DIR/${SKEY}_$p.thread" ] && echo "$p" && break; done)
	[ -n "$agent" ] || return 0
	read_nvim_pane "$agent"
	[ -n "$NV" ] && thread_width "$agent" "$NV"
	return 0
}

# The weaver session's entries in its order (its tabs' order, home left
# out), into THREAD_ORDER, one per line, US-separated: kind (thread: an agent
# with a number; agent; tab: no agent), num, tab id, pane (empty for a tab),
# label (the thread's name; a tab's name, or for zellij's "Tab #N" its first
# pane's directory and command). From $PANES when set (list-panes carries
# each pane's tab, its position and name), else list-panes.
thread_order() {
	local f nums="{}" agents=""
	THREAD_ORDER=""
	[ -n "${PANES:-}" ] || list_panes || return 0
	session_files json
	for f in ${FOUND[@]+"${FOUND[@]}"}; do
		f=${f##*_}
		agents="$agents ${f%.json}"
	done
	for f in "$STATE_DIR/${SKEY}"_*.thread; do
		[ -f "$f" ] || continue
		nums=$(jq -c --argjson m "$nums" '$m + {(.pane | tostring): {num, name}}' "$f" 2>/dev/null) || nums="{}"
		f=${f##*_}
		agents="$agents ${f%.thread}"
	done
	THREAD_ORDER=$(printf '%s' "$PANES" | jq -r --argjson nums "$nums" --arg agents " $agents " --arg home "$HOME" '
		def tilde: if . == $home then "~" elif startswith($home + "/") then "~" + .[($home | length):] else . end;
		(group_by(.tab_id) | map({id: .[0].tab_id, pos: .[0].tab_position, name: .[0].tab_name,
			panes: [.[] | select((.is_plugin | not) and (.is_floating | not))]}) | sort_by(.pos))[]
		| select(.name != "home") | . as $t
		| [$t.panes[] | (.id | tostring) as $i | select($agents | contains(" " + $i + " "))] as $a
		| if ($a | length) == 0 then
			["tab", "", $t.id, "",
			 (if ($t.name | test("^Tab #[0-9]+$")) and ($t.panes | length) > 0
			  then ($t.panes[0] | ((.pane_cwd // "") | tilde) + " "
				+ ((.terminal_command // "shell") | split(" ")[0] | split("/") | last))
			  else $t.name end)]
		  else $a[] | ($nums[.id | tostring]) as $n
			| if $n.num != null then ["thread", $n.num, $t.id, .id, ($n.name // "")]
			  else ["agent", "", $t.id, .id, ""] end
		  end
		| map(tostring) | join("\u001f")' 2>/dev/null)
}


# ---------------------------------------------------------------- main

usage() {
	cat <<'EOF2'
usage: weaver [command]
  (none)                       outside tmux and zellij: attach to, or start, the tmux
                               session "weaver" ($WEAVER_SESSION; WEAVER_MUX=zellij: in
                               zellij); inside either: the dashboard
  start [session]              the same, for another session
  new [task...]                start a thread: a new tab with nvim and an agent, in a new
                               worktree whose branch starts from the remote's default
                               branch, fetched; with no task, a form. Options: --repo DIR,
                               --branch NAME, --base REF (@: this checkout's HEAD),
                               --here (the current checkout),
                               --agent claude|codex, --edit (write the task in $EDITOR),
                               --from PANE (that agent's repository), --no-focus
  close [--yes] [--remove-worktree] [pane-id]
                               close an agent (the focused one) with its nvim, and its
                               thread's tab; offers to remove a thread's worktree when it
                               is clean and merged or pushed
  resume [--all] [which]       threads lost when their session went (a crash, or quit):
                               alone, list them; with a name, number or session id, bring
                               that one back in a new tab resuming its conversation;
                               --all, every one. --forget [--yes] which: drop one
  send [--force] PANE < text   the text to agent PANE's prompt (its nvim's :AgentSend), when
                               it waits for you to say more; --force, even while it works
  quit [--yes]                 quit this session (outside it, "weaver") with
                               every agent and nvim in it, after asking; its threads are
                               kept and come back as the weaver session starts again
  hook [--async]              Claude Code hook (reads the event JSON on stdin)
  event [--bell]               an event of any agent, as normalized JSON on stdin
  adapt codex [--bell]         Codex hook (reads Codex's event JSON on stdin)
  edit [--full] [pane-id]      open or jump to the nvim for the focused agent
  ls                           live dashboard of the agents in this session
  next                         jump to the next agent that needs you; repeat to cycle
  status [--zjstatus | --tmux SESSION]
                               agent counts (for zjstatus's command widget, or tmux's
                               status line)
  snapshot --reviewed [dir]    mark the worktree holding dir reviewed
  gc                           forget agents that are gone, in every session
  nvim <agent-pane> [file]     internal: start the nvim bound to an agent
EOF2
}

[ -n "${WEAVER_SOURCED:-}" ] && return 0
cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
'' | start) cmd_start "$@" ;;
new) cmd_new "$@" ;;
close) cmd_close "$@" ;;
resume) cmd_resume "$@" ;;
quit) cmd_quit "$@" ;;
send) cmd_send "$@" ;;
_agent) cmd_agent_pane "$@" ;;
_form) cmd_form "$@" ;;
go) cmd_go "$@" ;;
_sidefit) need_session && cmd_sidefit ;;
_order) need_session && thread_order && printf '%s\n' "$THREAD_ORDER" ;;
_fetch) cmd_fetch "$@" ;;
_close) close_tail "$@" ;;
hook) cmd_hook "$@" ;;
edit) cmd_edit "$@" ;;
nvim) cmd_nvim "$@" ;;
ls) cmd_ls ;;
next) cmd_next ;;
status) cmd_status "$@" ;;
snapshot) cmd_snapshot "$@" ;;
gc) gc_states ;;
_rows) need_session && ls_rows ;;
_preview) need_session && cmd_preview "$@" ;;
_view) cmd_view "$@" ;;
_footer) ls_footer ;;
_title) ls_title ;;
_chrome) ls_chrome ;;
sidebar) cmd_sidebar ;;
home) cmd_home ;;
_restore) need_session && gc_states quiet && resume_session ;;
_fit) cmd_fit "$@" ;;
_panes) need_session && list_panes && printf '%s\n' "$PANES" ;;
_seen) cmd_seen "$@" ;;
_side) need_session && side_rows "$@" ;;
_goto) need_session && cmd_goto "$@" ;;
_focus) need_session && focus_pane "$@" ;;
-h | --help | help) usage ;;
*)
	usage >&2
	exit 2
	;;
esac
