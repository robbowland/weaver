{
 "about": "an API error (StopFailure) needs you and says why; no late tool hook of its turn ends that, a batch neither; your next prompt does",
 "steps": [
  {
   "event": {
    "hook_event_name": "UserPromptSubmit",
    "prompt": "go",
    "prompt_id": "p1"
   }
  },
  {
   "event": {
    "hook_event_name": "StopFailure",
    "error": "rate_limit",
    "prompt_id": "p1"
   },
   "expect": {
    "state": "needs-you",
    "waiting": "error: rate_limit"
   },
   "bell": true
  },
  {
   "event": {
    "hook_event_name": "PostToolUse",
    "prompt_id": "p1",
    "tool_name": "Read",
    "tool_input": {
     "file_path": "/x"
    },
    "tool_response": {}
   },
   "expect": {
    "state": "needs-you",
    "waiting": "error: rate_limit"
   }
  },
  {
   "event": {
    "hook_event_name": "PostToolBatch",
    "prompt_id": "p1",
    "tool_calls": [
     {
      "tool_name": "Read",
      "tool_input": {
       "file_path": "/x"
      },
      "tool_use_id": "t1",
      "tool_response": "1\tx"
     }
    ]
   },
   "expect": {
    "state": "needs-you"
   }
  },
  {
   "event": {
    "hook_event_name": "UserPromptSubmit",
    "prompt": "try again",
    "prompt_id": "p2"
   },
   "expect": {
    "state": "working",
    "waiting": "",
    "turn": 2
   }
  }
 ]
}
