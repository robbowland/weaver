{
 "about": "subagents' work: their edits move where the agent is and join its files; its own look around its checkout does not; CwdChanged does; a Bash or MCP edit is not followed",
 "mkdirs": [
  "wt-a/.git",
  "wt-a/src",
  "wt-b/.git",
  "repo/src"
 ],
 "steps": [
  {
   "event": {
    "hook_event_name": "SessionStart",
    "source": "startup"
   }
  },
  {
   "event": {
    "hook_event_name": "UserPromptSubmit",
    "prompt": "implement both features"
   }
  },
  {
   "event": {
    "hook_event_name": "SubagentStart",
    "agent_id": "sub-a",
    "agent_type": "general-purpose"
   }
  },
  {
   "event": {
    "hook_event_name": "SubagentStart",
    "agent_id": "sub-b",
    "agent_type": "Explore"
   },
   "expect": {
    "subagents": {
     "len": 2
    }
   }
  },
  {
   "event": {
    "hook_event_name": "PostToolUse",
    "agent_id": "sub-a",
    "tool_name": "Edit",
    "tool_input": {
     "file_path": "$T/wt-a/src/app.txt"
    },
    "tool_response": {}
   },
   "expect": {
    "root": "$T/wt-a",
    "file": "$T/wt-a/src/app.txt"
   }
  },
  {
   "event": {
    "hook_event_name": "PostToolUse",
    "agent_id": "sub-b",
    "tool_name": "Edit",
    "tool_input": {
     "file_path": "$T/wt-b/README.md"
    },
    "tool_response": {}
   },
   "expect": {
    "root": "$T/wt-b",
    "files": [
     "$T/wt-a/src/app.txt",
     "$T/wt-b/README.md"
    ]
   }
  },
  {
   "event": {
    "hook_event_name": "SubagentStop",
    "agent_id": "sub-b",
    "agent_type": "Explore"
   },
   "expect": {
    "subagents": {
     "len": 1
    }
   }
  },
  {
   "event": {
    "hook_event_name": "UserPromptSubmit",
    "prompt": "<agent-message from=\"sub-b\"> [Subagent hand-back] done",
    "cwd": "$T/repo/src"
   },
   "expect": {
    "root": "$T/wt-b",
    "prompt": "implement both features",
    "turn": 1
   }
  },
  {
   "event": {
    "hook_event_name": "PostToolUse",
    "agent_id": "sub-b",
    "tool_name": "Edit",
    "tool_input": {
     "file_path": "$T/wt-a/README.md"
    },
    "tool_response": {},
    "cwd": "$T/wt-b"
   },
   "expect": {
    "cwd": "$T/repo/src"
   }
  },
  {
   "event": {
    "hook_event_name": "CwdChanged",
    "old_cwd": "$T/repo",
    "new_cwd": "$T/wt-a/src",
    "cwd": "$T/wt-a"
   },
   "expect": {
    "root": "$T/wt-a",
    "cwd": "$T/wt-a/src"
   }
  },
  {
   "event": {
    "hook_event_name": "PostToolUse",
    "agent_id": "sub-b",
    "tool_name": "Bash",
    "tool_input": {
     "command": "sed -i '' s/a/b/ $T/wt-b/x"
    },
    "tool_response": {}
   },
   "expect": {
    "root": "$T/wt-a",
    "file": "$T/wt-a/README.md"
   }
  },
  {
   "event": {
    "hook_event_name": "PostToolUse",
    "tool_name": "mcp__filesystem__write_file",
    "tool_input": {
     "path": "$T/wt-b/m.txt",
     "content": "x"
    },
    "tool_response": {}
   },
   "expect": {
    "root": "$T/wt-a",
    "file": "$T/wt-a/README.md"
   }
  }
 ]
}
