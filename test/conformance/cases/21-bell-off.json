{
 "about": "WEAVER_BELL=0: the bell never rings, the states are as ever",
 "env": {
  "WEAVER_BELL": "0"
 },
 "steps": [
  {
   "event": {
    "hook_event_name": "UserPromptSubmit",
    "prompt": "go"
   }
  },
  {
   "event": {
    "hook_event_name": "PermissionRequest",
    "tool_name": "Bash",
    "tool_input": {
