{
  "about": "a turn: a new session is idle, your prompt works and counts a turn, its Stop is done and rings",
  "steps": [
    {"event": {"hook_event_name": "SessionStart", "source": "startup"},
     "expect": {"state": "idle", "session_id": "conv-1", "pid": "agent", "turn": 0, "root": "$T/repo", "agent": "claude"}, "bell": false},
    {"event": {"hook_event_name": "UserPromptSubmit", "prompt": "add a flag", "prompt_id": "p1"},
     "expect": {"state": "working", "prompt": "add a flag", "turn": 1, "prompt_id": "p1", "seen": false}, "bell": false},
    {"event": {"hook_event_name": "Stop", "last_assistant_message": "Added --name.", "prompt_id": "p1"},
     "expect": {"state": "done", "last_message": "Added --name.", "turn": 1}, "bell": true}
  ]
}
