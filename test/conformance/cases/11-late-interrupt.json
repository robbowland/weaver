{
 "about": "an interrupt of the turn before, landing late, does not stop the next, nor take its prompt_id back",
 "steps": [
  {
   "event": {
    "hook_event_name": "UserPromptSubmit",
    "prompt": "first",
    "prompt_id": "p1"
   }
  },
  {
   "event": {
    "hook_event_name": "UserPromptSubmit",
    "prompt": "second",
    "prompt_id": "p2"
   }
  },
  {
   "event": {
    "hook_event_name": "PostToolUseFailure",
    "tool_name": "Bash",
    "tool_input": {
     "command": "sleep 9"
    },
    "error": "Interrupted",
    "is_interrupt": true,
    "prompt_id": "p1"
   },
   "expect": {
    "state": "working",
    "prompt_id": "p2",
    "prompt": "second"
   }
  }
 ]
