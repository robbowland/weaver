#!/bin/bash
# Stand-in for weaver in the headless specs, to the contracts in
# docs/design.md (the specs test the Neovim side alone): `weaver send [--force]
# PANE` records its arguments and the text in $WEAVER_FAKE_SEND (failing
# without --force, as weaver does for a busy agent, with $WEAVER_FAKE_SEND_FAIL
# set), and
# `weaver snapshot --reviewed [dir]` takes the reviewed snapshot.
if [ "${1:-}" = send ]; then
	if [ -n "${WEAVER_FAKE_SEND_FAIL:-}" ] && [ "${2:-}" != --force ]; then
		echo "weaver: the agent is working: send when it waits for you (or --force)" >&2
		exit 1
	fi
	{
		printf '%s\n' "$*"
		cat
	} >"${WEAVER_FAKE_SEND:?}"
	exit 0
fi
[ "${1:-}" = snapshot ] && [ "${2:-}" = --reviewed ] || exit 2
cd "${3:-$PWD}" 2>/dev/null || exit 1
top=$(git rev-parse --show-toplevel 2>/dev/null) || {
	echo "not in a git repository" >&2
	exit 1
}
gd=$(git rev-parse --path-format=absolute --git-path weaver) && mkdir -p "$gd" || exit 1
idx="$gd/index-reviewed-fake"
real=$(git rev-parse --path-format=absolute --git-path index)
[ -f "$idx" ] || cp "$real" "$idx" 2>/dev/null
GIT_INDEX_FILE=$idx git -C "$top" add --all || exit 1
tree=$(GIT_INDEX_FILE=$idx git -C "$top" write-tree) || exit 1
ref=refs/worktree/weaver/reviewed
tip=$(git rev-parse -q --verify "$ref")
if [ -n "$tip" ] && [ "$(git rev-parse "$tip^{tree}")" = "$tree" ]; then
	echo "$tip"
	exit 0
fi
c=$(printf 'weaver: reviewed\n\nWeaver-Point: reviewed\n' |
	GIT_AUTHOR_NAME=weaver GIT_AUTHOR_EMAIL=weaver@localhost GIT_COMMITTER_NAME=weaver GIT_COMMITTER_EMAIL=weaver@localhost \
		git commit-tree "$tree" ${tip:+-p "$tip"}) || exit 1
git update-ref "$ref" "$c" || exit 1
echo "$c"
