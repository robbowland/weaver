{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "weaver hook" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "weaver hook" }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "weaver hook" }] }],
    "PermissionRequest": [{ "matcher": "", "hooks": [{ "type": "command", "command": "weaver hook" }] }],
    "PreToolUse": [{ "matcher": "AskUserQuestion", "hooks": [{ "type": "command", "command": "weaver hook" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "weaver hook" }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "weaver hook" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "weaver hook" }] }],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|EnterWorktree|ExitWorktree",
        "hooks": [{ "type": "command", "command": "weaver hook" }]
      },
      { "matcher": "", "hooks": [{ "type": "command", "command": "weaver hook --async", "async": true }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "weaver hook --async", "async": true }] }
    ]
  }
}
