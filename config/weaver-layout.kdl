// weaver's own session layout (`weaver`): the home board first; `weaver new`
// adds thread tabs with the sidebar. Your layouts/weaver.kdl replaces it.
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
    tab name="home" focus=true {
        pane name="home" command="weaver" {
            args "home"
        }
    }
}
