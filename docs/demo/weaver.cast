[19.319064, "o", "\u001b[?25l\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m\u001b[2;1Himport argparse\u001b[60X\u001b[39m\u001b[49m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m\r\n \u001b[74X\u001b[39m\u001b[49m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m\r\n \u001b[74X\u001b[39m\u001b[49m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m\u001b[1m\r\ndef\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m \u001b[38;2;140;248;247mmain\u001b[38;2;224;226;234m():\u001b[64X\u001b[39m\u001b[49m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m\r\n    p = argparse.ArgumentParser()\u001b[42X\u001b[39m\u001b[49m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m\r\n    p.add_argument(\u001b[38;2;179;246;192m\"name\"\u001b[38;2;224;226;234m)\u001b[49X\u001b[39m\u001b[49m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m\r\n    p.add_argument(\u001b[38;2;179;246;192m\"--loud\"\u001b[38;2;224;226;234m, action=\u001b[38;2;179;246;192m\"store_true\"\u001b[38;2;224;226;234m, \u001b[38;2;140;248;247mhelp\u001b[38;2;224;226;234m=\u001b[38;2;179;246;192m\"shout it\"\u001b[38;2;224;226;234m)         \u001b[39m\u001b[49m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m\r\n    args = p.parse_args()\u001b[50X\u001b[39m\u001b[49m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m\r\n    msg = \u001b[38;2;179;246;192mf\"Hello, \u001b[38;2;140;248;247m{\u001b[38;2;224;226;234margs.name\u001b[38;2;140;248;247m}"]
