[46.504754, "o", "\u001b[?25l\u001b[38;2;155;158;164m\u001b[48;2;7;8;13m\u001b[1m\u001b[H[\u001b[38;2;179;246;192mx\u001b[38;2;155;158;164m]\u001b[38;2;179;246;192m done\u001b[38;2;155;158;164m \u00b7 turn 1 \u00b7 3/3 tasks                                              \u001b(B\u001b[m\u001b[90m\u001b[C>\u001b[39m Add a --loud flag that shouts\u001b[K\u001b[32D\u001b[38;2;97;97;97m\u2502\u001b(B\u001b[m\u001b[38;2;79;82;88m\u001b[48;2;20;22;27m\r\n  \u001b[38;2;224;226;234mimport argparse\u001b[58X\u001b[39m\u001b[49m\u001b[59C\u001b[K\b\u001b[38;2;97;97;97m\u2502\u001b(B\u001b[m\u001b[38;2;79;82;88m\u001b[48;2;20;22;27m\r\n \u001b[38;2;224;226;234m\u001b[74X\u001b[39m\u001b[49m\u001b[32m\u001b[75C\u25cf\u001b[39m \u001b[1mRead\u001b(B\u001b[m(greet.py)\u001b[K\u001b[17D\u001b[38;2;97;97;97m\u2502\u001b(B\u001b[m\u001b[38;2;79;82;88m\u001b[48;2;20;22;27m\r\n \u001b[38;2;224;226;234m\u001b[74X\u001b[39m\u001b[49m\u001b[75C  \u001b[90m\u23bf  Read 10 lines\u001b[39m\u001b[K\u001b[19D\u001b[38;2;97;97;97m\u2502\u001b(B\u001b[m\u001b[38;2;79;82;88m\u001b[48;2;20;22;27m\r\n  \u001b[38;2;224;226;234m\u001b[1mdef\u001b(B\u001b[m\u001b[38;2;224;226;234m\u001b[48;2;20;22;27m \u001b[38;2;140;248;247mmain\u001b[38;2;224;226;234m():\u001b[62X\u001b[39m\u001b[49m\u001b[63C\u001b[K\b\u001b[38;2;97;97;97m\u2502\u001b(B\u001b[m\u001b[38;2;79;82;88m\u001b[48;2;20;22;27m\r\n \u001b[38;2;224;226;234m     p = argparse.ArgumentParser()\u001b[40X\u001b[39m\u001b[49m\u001b[32m\u001b[41C\u25cf\u001b[39m \u001b[1mUpdate\u001b(B\u001b[m(gree"]
[46.504824, "o", "t.py)\u001b[K\u001b[19D\u001b[38;2;97;97;97m\u2502\u001b(B\u001b[m\u001b[38;2;79;82;88m\u001b[48;2;20;22;27m\r\n \u001b[38;2;224;226;234m     p.add_argument(\u001b[38;2;179;246;192m\"name\"\u001b[38;2;224;226;234m)\u001b[47X\u001b[39m\u001b[49m\u001b[48C  \u001b[90m\u23bf  Added 3 lines\u001b[39m\u001b[K\u001b[19D\u001b[38;2;97;97;97m\u2502\u001b(B\u001b[m\u001b[38;2;179;246;192m\u001b[48;2;20;22;27m\r\n\u2503\u001b[38;2;224;226;234m     p.add_argument(\u001b[38;2;179;246;192m\"--loud\"\u001b[38;2;224;226;234m, action=\u001b[38;2;179;246;192m\"store_true\"\u001b[38;2;224;226;234m, \u001b[38;2;140;248;247mhelp\u001b[38;2;224;226;234m=\u001b[38;2;179;246;192m\"shout it\"\u001b[38;2;224;226;234m)       \u001b[39m\u001b[49m\u001b[C\u001b[K\b\u001b[38;2;97;97;97m\u2502\u001b(B\u001b[m\u001b[38;2;79;82;88m\u001b[48;2;20;22;27m\r\n \u001b[38;2;224;226;234m     args = p.parse_args()\u001b[48X\u001b[39m\u001b[49m\u001b[32m\u001b[49C\u25cf\u001b[39m \u001b[1mBash\u001b(B\u001b[m(python greet.py --loud Ada)\u001b[K\u001b[35D\u001b[38;2;97;97;97m\u2502\u001b(B\u001b[m\u001b[38;2;140;248;247m\u001b[48;2;20;22;27m\r\n\u2503\u001b[38;2;224;226;234m     msg = \u001b[38;2;179;246;192mf\"Hello, \u001b[38;2;140;248;247m{\u001b[38;2;224;226;234margs.name\u001b[38;2;140;248;247m}\u001b[38;2;179;246;192m!\"\u001b[38;2;224;226;234m\u001b[41X\u001b[39m\u001b[49m\u001b[42C  \u001b[90m\u23bf  HELLO, ADA!\u001b[39m\u001b[K\u001b[17D\u001b[38;2"]
